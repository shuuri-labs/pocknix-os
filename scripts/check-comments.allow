# Exceptions for scripts/check-comments.py: "<path glob> :: <regex>" or "<path glob> :: <kind> ::
# <regex>" (kind = dead path | notes pointer | provenance/status | version | long comment), matched
# against the comment line (a long comment's first line). Add one only when the number or path IS
# the mechanism (a threshold the code tests, a dependency floor, a foreign tree path) or the
# wording is a licence attribution, or for a file an unmerged branch still owns (the Unswept
# block), never for a ledger fact.
kernel/*/kernel.conf :: ROCKNIX's
scripts/lib.sh :: common-skip
packages/shared/pocknix-steam/pocknix-game-launch :: c000007b
packages/shared/pocknix-tools/pocknix-internal-boot-rename :: from ROCKNIX to POCKNIX
packages/shared/pocknix-sdcard-automount/format-device.sh :: SteamOS's deck
packages/shared/pocknix-decky/pocknix-control/py_modules/pocknix_control/calibration.py :: provenance/status :: GPcal
scripts/build-kernel.sh :: long comment :: ^# Deltas over the synced config
packages/shared/pocknix-tools/pocknix-install-internal :: long comment :: ^#\$UD_NUM  userdata
# Unswept: files an unmerged branch changes. After it merges, cut their comments and drop the line.
config/pocknix.conf :: long comment :: .
