# pocknix-base-lock — ships the base snapshot's package manifest, and IS the
# device's record of which base it runs: pkgver is the snapshot id, so
# `pacman -Q pocknix-base-lock` answers "which base am I on?" and the answer
# updates in lockstep with the base itself (the repo URL is stable and carries
# no id). Regenerated by `make snapshot`.
pkgname=pocknix-base-lock
# parsed from the lockfile header so the package version can never disagree
# with the manifest it ships; dots are part of the id (same-day re-snapshots are
# 20260810.1), so truncating them would republish one pkgver with two contents
pkgver=$(sed -n 's/^#.*snapshot \([0-9][0-9.]*\).*/\1/p' "${startdir}/pocknix-base.lock" | head -1)
pkgrel=1
pkgdesc="Manifest and version stamp of the frozen pocknix ALARM base snapshot"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('MIT')
source=('pocknix-base.lock')
sha256sums=('SKIP')

package() {
  install -Dm644 "${srcdir}/pocknix-base.lock" \
    "${pkgdir}/usr/share/pocknix/pocknix-base.lock"
}
