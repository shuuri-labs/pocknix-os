#!/bin/bash
# pocknix-flathub-setup — register the Flathub remote and seed the apps shipped
# as flatpaks instead of frozen-base packages (browser CVEs can't wait for a
# pocknix release). NM-dispatched on every real link-up, so failed or offline
# attempts heal on the next connect; every step is an idempotent no-op once done.
set -e
seed_firefox() {
  flatpak info org.mozilla.firefox >/dev/null 2>&1 && return 0
  flatpak install --system --noninteractive flathub org.mozilla.firefox
}

flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
# A reboot mid-seed (Steam's OOBE forces one on first boot) leaves a ref that looks
# installed but cannot be read; only repair drops it, so a plain retry fails forever.
seed_firefox || { flatpak repair --system; seed_firefox; }
# pre-flatpak installs: retire the pacman browsers ONLY once the flatpak is present
# (never leave a device browserless). Failing hard is what makes the retry real: with
# RemainAfterExit=yes a swallowed error leaves the unit active(exited), so the dispatcher's
# `systemctl start` becomes a no-op and a db-locked removal would wait for a reboot.
if flatpak info org.mozilla.firefox >/dev/null 2>&1; then
  stale="$(pacman -Qq firefox angelfish 2>/dev/null || true)"
  if [ -n "${stale}" ]; then
    pacman -Rns --noconfirm ${stale} || {
      echo "pocknix-flathub-setup: removing the pacman browsers (${stale//$'\n'/ }) failed (db locked?) — retrying on the next link-up" >&2
      exit 1
    }
  fi
fi
