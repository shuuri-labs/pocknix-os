#!/bin/bash
# pocknix-flathub-setup — register the Flathub remote (system-wide) and seed the
# apps we deliberately ship as flatpaks instead of frozen-base packages. Run by
# pocknix-flathub.service on every real link-up (NM dispatcher), so a failed or
# offline attempt heals on the next connect; both steps are cheap no-ops once done.
set -e
flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
# Firefox rides Flathub, NOT [pocknix-base]: a browser pinned to a months-old
# snapshot freezes CVEs where they hurt most, and flatpak updates roll
# independently of pocknix releases. `flatpak info` is a local check.
flatpak info org.mozilla.firefox >/dev/null 2>&1 \
  || flatpak install --system --noninteractive flathub org.mozilla.firefox
