# pocknix-desktop — the Plasma Mobile "desktop" session for the Retroid Pocket 6, plus the
# game<->desktop session switch. The Steam half is pocknix-steam; this is its symmetric twin.
#
# The heavy Plasma Mobile stack itself is NOT a depends() here — it's installed into the rootfs at
# image time from config/packages/desktop.list (the repo's base.list/steam.list pattern). Reason:
# makepkg -s would otherwise pull the entire KDE/Qt stack into the BUILD chroot just to build this
# no-op arch=any data package (hundreds of MB, no purpose). So this package ships only the scripts;
# build-image.sh installs desktop.list alongside it. It ships:
#   - pocknix-desktop            the launcher (.bash_profile execs it when the choice = plasma)
#   - pocknix-desktop-rotate     applies the RP6 panel rotation+scale to the live kwin session
#                                (autostarted via /etc/xdg/autostart) — the rotated-DSI crux
#   - pocknix-desktop-remove-taskpanel  deletes the shell's bottom taskpanel containment each
#                                session — with the baked gesture/navigation panels disabled it
#                                still lingers as a ~12px overlay strip (PanelView min clamp)
#   - steamos-session-select     the REAL game<->desktop switch (Steam "Switch to Desktop" + the
#                                Plasma "Return to Game Mode" tile both call this)
#   - return-to-gamemode.desktop an app-grid tile that runs `steamos-session-select gamescope`
#
# Plasma Mobile runs on kwin_wayland (its own compositor), NOT in Sway — locked decision; see
# docs/plasma-mobile-plan.md and the plasma-mobile-compositor memory.
pkgname=pocknix-desktop
pkgver=0.1.0
pkgrel=19
pkgdesc="Plasma Mobile desktop session for the RP6 + game<->desktop session switch"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL2')
# depends() is intentionally JUST 'bash'. The Plasma Mobile runtime stack (plasma-mobile +
# startplasmamobile, plasma-workspace, kwin, plasma-nano, plasma-nm, powerdevil, plasma-settings,
# kscreen/kscreen-doctor) is delivered via config/packages/desktop.list into the rootfs, NOT as
# depends here — listing plasma-mobile/kscreen would drag the entire KDE/Qt stack into the BUILD
# chroot at makepkg time for no reason. The launcher + rotate scripts `command -v`-guard their
# callees (startplasmamobile, kscreen-doctor) and fail gracefully if the stack is absent.
# pocknix-tools is the exception: pacman never installs a NEW package name without a dep edge,
# and this package is on every fielded device, so it is what delivers the maintenance app (which
# owns the rollback entry point pocknix-snapshots dropped) to the existing fleet on -Syu.
depends=('bash' 'pocknix-tools')
install='pocknix-desktop.install'
source=('pocknix-desktop' 'pocknix-desktop-rotate' 'pocknix-desktop-rotate.desktop'
        'pocknix-desktop-remove-taskpanel' 'pocknix-desktop-remove-taskpanel.desktop'
        'steamos-session-select' 'return-to-gamemode.desktop'
        'pocknix-flathub-setup' 'pocknix-flathub.service' 'pocknix-flathub-dispatcher'
        'ksplashrc' 'pocknix-x11.conf'
        'powerdevilrc' 'kscreenlockerrc'
        'pocknix-fontcache-prune' '99-pocknix-fontcache.hook'
        'pocknix-panel-touchfix' '98-pocknix-panel-touchfix.hook')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 "${srcdir}/pocknix-desktop"          "${pkgdir}/usr/bin/pocknix-desktop"
  install -Dm755 "${srcdir}/pocknix-desktop-rotate"   "${pkgdir}/usr/bin/pocknix-desktop-rotate"
  install -Dm755 "${srcdir}/steamos-session-select"   "${pkgdir}/usr/bin/steamos-session-select"
  # Autostart the rotation transform once the Plasma session (and kscreen kded) is up.
  install -Dm644 "${srcdir}/pocknix-desktop-rotate.desktop" \
    "${pkgdir}/etc/xdg/autostart/pocknix-desktop-rotate.desktop"
  # Remove the leftover gesture-bar taskpanel every session (see the script header for why).
  install -Dm755 "${srcdir}/pocknix-desktop-remove-taskpanel" \
    "${pkgdir}/usr/bin/pocknix-desktop-remove-taskpanel"
  install -Dm644 "${srcdir}/pocknix-desktop-remove-taskpanel.desktop" \
    "${pkgdir}/etc/xdg/autostart/pocknix-desktop-remove-taskpanel.desktop"
  # "Return to Game Mode" tile in the Plasma app grid.
  install -Dm644 "${srcdir}/return-to-gamemode.desktop" \
    "${pkgdir}/usr/share/applications/return-to-gamemode.desktop"
  # Flathub remote setup for Discover/flatpak. NOT enabled at boot: the service is started by the
  # NetworkManager dispatcher hook when a connection comes up (see the unit + dispatcher headers).
  install -Dm755 "${srcdir}/pocknix-flathub-setup"    "${pkgdir}/usr/bin/pocknix-flathub-setup"
  install -Dm644 "${srcdir}/pocknix-flathub.service" \
    "${pkgdir}/usr/lib/systemd/system/pocknix-flathub.service"
  # Dispatcher scripts must be root-owned and not group/world writable or NM refuses to run them.
  install -Dm755 "${srcdir}/pocknix-flathub-dispatcher" \
    "${pkgdir}/etc/NetworkManager/dispatcher.d/50-pocknix-flathub"
  # Disable the 30s KSplash fallback (Plasma Mobile never dismisses it) so a session switch isn't
  # stuck behind a splash. System-wide default; only the deck Plasma session reads it.
  install -Dm644 "${srcdir}/ksplashrc"                "${pkgdir}/etc/xdg/ksplashrc"
  # power button -> NoAction in powerdevil: Plasma Mobile's ToggleScreenOnOff default turned
  # the panel back OFF on the (post-resume-delivered) wake press. pocknix-powerd owns the key.
  install -Dm644 "${srcdir}/powerdevilrc"             "${pkgdir}/etc/xdg/powerdevilrc"
  # No PIN lock screen: disable kscreenlocker's idle autolock + lock-on-resume (see file header).
  install -Dm644 "${srcdir}/kscreenlockerrc"          "${pkgdir}/etc/xdg/kscreenlockerrc"
  # tmpfiles rule to create /tmp/.X11-unix at boot so kwin can start XWayland (X11 apps like Steam
  # in desktop mode). kwin expects the dir to exist; the minimal ALARM base ships no xorg-server
  # to provide it. See pocknix-x11.conf.
  install -Dm644 "${srcdir}/pocknix-x11.conf"         "${pkgdir}/usr/lib/tmpfiles.d/pocknix-x11.conf"
  install -Dm755 "${srcdir}/pocknix-fontcache-prune" "${pkgdir}/usr/bin/pocknix-fontcache-prune"
  install -Dm644 "${srcdir}/99-pocknix-fontcache.hook" \
    "${pkgdir}/usr/share/libalpm/hooks/99-pocknix-fontcache.hook"
  # Touch-through fix for the auto-hidden status bar (rationale in the script header).
  install -Dm755 "${srcdir}/pocknix-panel-touchfix" "${pkgdir}/usr/bin/pocknix-panel-touchfix"
  install -Dm644 "${srcdir}/98-pocknix-panel-touchfix.hook" \
    "${pkgdir}/usr/share/libalpm/hooks/98-pocknix-panel-touchfix.hook"
}
