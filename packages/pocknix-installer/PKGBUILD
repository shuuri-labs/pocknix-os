# pocknix-installer — the internal-storage install/remove GUI, adopted from the
# image overlay so its flows can evolve via -Syu. The privileged CLIs it drives
# (pocknix-install-internal / pocknix-uninstall-internal) deliberately STAY in
# the overlay: they are coupled to the partition layout of the image they
# shipped with, and must not drift from it.
pkgname=pocknix-installer
pkgver=0.1.0
pkgrel=1
pkgdesc="Plasma GUI for installing Pocknix to internal storage (or removing it)"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('MIT')
depends=('kdialog' 'qt6-tools')
install=pocknix-installer.install
source=('pocknix-installer-gui'
        'pocknix-installer-gui.desktop')
sha256sums=('SKIP' 'SKIP')

package() {
  install -Dm755 "${srcdir}/pocknix-installer-gui" "${pkgdir}/usr/bin/pocknix-installer-gui"
  install -Dm644 "${srcdir}/pocknix-installer-gui.desktop" \
    "${pkgdir}/usr/share/applications/pocknix-installer-gui.desktop"
}
