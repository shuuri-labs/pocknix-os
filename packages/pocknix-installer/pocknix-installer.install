# Migration from the image-overlay era (see pocknix-base.install for the full
# story): prune the unowned overlay copies so the packaged /usr/bin GUI isn't
# shadowed by /usr/local/bin on pre-package devices. No-op on fresh images.
_prune_overlay_installer() {
  rm -f /usr/local/bin/pocknix-installer-gui \
        /usr/share/applications/pocknix-installer.desktop
}

post_install() {
  _prune_overlay_installer
}

post_upgrade() {
  _prune_overlay_installer
}
