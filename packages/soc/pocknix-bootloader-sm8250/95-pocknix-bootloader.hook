# pacman never touches /flash, so upgrading the payload has to re-copy it there; no-ops in the
# image-build chroot, where pocknix-update-grub finds no mounted /flash.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/share/pocknix/bootloader/*

[Action]
Description = pocknix: refreshing /flash bootloader (arm-efi GRUB)...
When = PostTransaction
Exec = /usr/bin/pocknix-update-grub
