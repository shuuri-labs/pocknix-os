# Rendered by the PKGBUILD, which fills every entry with the profile's KERNEL_CMDLINE;
# scripts/check.sh fails on an entry that spells out its own cmdline.
# A Flip 2 first-boots the rp5 dtb, then pocknix-sm8250-board-select sets saved_entry.
# The Visionox panel is undetectable this early: a PC-created "visionox" file here picks its dtbs.
insmod part_gpt
load_env
set default='rp5'
if [ -n "${saved_entry}" ]; then
  set default="${saved_entry}"
fi
set panel=''
if [ -f /visionox ]; then set panel='visionox'; fi
if [ -f /visionox.txt ]; then set panel='visionox'; fi
if [ "${panel}" = "visionox" ]; then
  if [ "${default}" = "rp5" ]; then set default='rp5-visionox'; fi
  if [ "${default}" = "rpflip2" ]; then set default='rpflip2-visionox'; fi
fi
set timeout=0

# root= is a fixed PARTUUID, re-pinned by pocknix-update-grub: an internal install shares the label.
# No `search`: it found the other install's KERNEL first when an SD and internal both carry one.
menuentry 'pocknix (Retroid Pocket 5)' --id 'rp5' {
        linux /KERNEL @KERNEL_CMDLINE@
        devicetree /boot/grub/sm8250-retroidpocket-rp5.dtb
}

menuentry 'pocknix (Retroid Pocket Flip 2)' --id 'rpflip2' {
        linux /KERNEL @KERNEL_CMDLINE@
        devicetree /boot/grub/sm8250-retroidpocket-flip2.dtb
}

menuentry 'pocknix (Retroid Pocket 5, Visionox panel)' --id 'rp5-visionox' {
        linux /KERNEL @KERNEL_CMDLINE@
        devicetree /boot/grub/sm8250-retroidpocket-rp5-visionox.dtb
}

menuentry 'pocknix (Retroid Pocket Flip 2, Visionox panel)' --id 'rpflip2-visionox' {
        linux /KERNEL @KERNEL_CMDLINE@
        devicetree /boot/grub/sm8250-retroidpocket-flip2-visionox.dtb
}
