# The OpenABL kit ships INERT: only pocknix-update-abl flashes.
# grubenv holds the user's menu choice: installed only when missing.
pkgname=pocknix-bootloader-sm8250
pkgver=20260701          # the ROCKNIX release bootaa64.efi was extracted from
pkgrel=16
_ablver=1.2              # OpenABL release the kit is taken from
pkgdesc="SM8250 boot payload: ROCKNIX GRUB + pocknix grub.cfg + OpenABL install kit"
arch=('aarch64')
# !strip: a stripped bootloader is an unbootable one.
options=('!strip')
# bsp-common 37 reads the kit from openabl/ and writes the boot files OpenABL loads.
depends=('pocknix-bsp-common>=0.1.0-37')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL-3.0-or-later' 'BSD-3-Clause')   # GRUB, OpenABL's menu; Qualcomm ABL (edk2)
source=('bootaa64.efi'
        'grub.cfg.in'
        'grubenv'
        'pocknix-update-grub'
        '95-pocknix-bootloader.hook'
        "https://github.com/OpenHandheldCollective/OpenABL/releases/download/v${_ablver}/openabl-v${_ablver}.tar.gz"
        'README'
        'flash_abl.sh.template'
        'backup_abl.sh'
        'restore_backup_abl.sh'
        '95-pocknix-abl-kit.hook')
sha512sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            '41f8b0460bc5c2cbbec312911377e52c41eda7c4dcd365bc76486d81cf4da0e9072df00edaf3afacb87565d856487d0aac3c8b5506d46b9ea6c901c319635492'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

prepare() {
  # the cmdline is the profile's, staged by scripts/build-packages.sh
  local c; c="$(sed 's/[&|\\]/\\&/g' "${startdir}/staged/kernel-cmdline")"
  sed "s|@KERNEL_CMDLINE@|${c}|" grub.cfg.in > grub.cfg
  ( cd "openabl-v${_ablver}/SM8250" && sha256sum -c "abl_signed-SM8250.elf.sha256" )
  sed 's/%DEVICE%/SM8250/g' flash_abl.sh.template > flash_abl.sh
  # pocknix-update-abl reports the shipped version; the elf itself carries none
  echo "${_ablver}" > version
}

package() {
  local bl="${pkgdir}/usr/share/pocknix/bootloader"

  install -Dm644 "${srcdir}/bootaa64.efi" "${bl}/EFI/BOOT/bootaa64.efi"
  install -Dm644 "${srcdir}/grub.cfg"     "${bl}/boot/grub/grub.cfg"
  install -Dm644 "${srcdir}/grubenv"      "${bl}/boot/grub/grubenv"

  install -Dm755 "${srcdir}/pocknix-update-grub"        "${pkgdir}/usr/bin/pocknix-update-grub"
  install -Dm644 "${srcdir}/95-pocknix-bootloader.hook" "${pkgdir}/usr/share/libalpm/hooks/95-pocknix-bootloader.hook"

  local kit="${bl}/openabl"
  install -Dm644 "${srcdir}/openabl-v${_ablver}/SM8250/abl_signed-SM8250.elf" "${kit}/abl_signed-SM8250.elf"
  install -Dm644 "${srcdir}/README"                "${kit}/README"
  install -Dm755 "${srcdir}/flash_abl.sh"          "${kit}/flash_abl.sh"
  install -Dm755 "${srcdir}/backup_abl.sh"         "${kit}/backup_abl.sh"
  install -Dm755 "${srcdir}/restore_backup_abl.sh" "${kit}/restore_backup_abl.sh"
  install -Dm644 "${srcdir}/version"               "${kit}/version"
  # pocknix-update-grub refreshes GRUB on /flash but not the kit; this hook covers the kit.
  install -Dm644 "${srcdir}/95-pocknix-abl-kit.hook" \
    "${pkgdir}/usr/share/libalpm/hooks/95-pocknix-abl-kit.hook"
}
