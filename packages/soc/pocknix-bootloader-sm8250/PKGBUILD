# pocknix-bootloader-sm8250 — the arm-efi boot chain payload for SM8250 boards.
# Boot contract: XBL -> an ABL providing UEFI -> GRUB (EFI/BOOT/bootaa64.efi) -> boot/grub/grub.cfg
# -> "linux /KERNEL" + "devicetree /boot/grub/<board>.dtb". Factory RP5/Flip 2 ABLs already satisfy
# it, so the ABL kit ships INERT: only the user-run pocknix-update-abl ever flashes, unlike sm8550
# where the ABL must be flashed before anything boots.
# grub.cfg is the single source of truth for the runtime cmdline; build-packages.sh enforces that it
# byte-matches the profile's KERNEL_CMDLINE. grubenv carries the user's saved menu choice, so it is
# installed to /flash only when missing.
pkgname=pocknix-bootloader-sm8250
pkgver=20260701          # the ROCKNIX release bootaa64.efi was extracted from
pkgrel=9
_ablver=1.1.7            # ROCKNIX ABL release the kit is taken from
pkgdesc="SM8250 arm-efi boot payload: ROCKNIX GRUB + pocknix grub.cfg + ABL install kit"
arch=('aarch64')
# !strip: a stripped bootloader is an unbootable one.
options=('!strip')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL-3.0-or-later' 'BSD-3-Clause')   # GRUB; Qualcomm ABL (edk2 LinuxLoader)
source=('bootaa64.efi'
        'grub.cfg'
        'grubenv'
        'pocknix-update-grub'
        '95-pocknix-bootloader.hook'
        "https://github.com/ROCKNIX/abl/releases/download/v${_ablver}/rocknix-abl-v${_ablver}.tar.gz"
        'README'
        'flash_abl.sh.template'
        'backup_abl.sh'
        'restore_backup_abl.sh'
        '95-pocknix-abl-kit.hook')
sha512sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'fa1d213bec97661942b8083be1f2eb6b65cc200b4f3f76dd84261ba92a01ac9261ed6834350f2f647a5ed82fcabadf5011b9ba6769f471abeaf06210ae9221c1'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

prepare() {
  # the release ships a .sha256 sidecar per elf
  ( cd "rocknix-abl-v${_ablver}" && sha256sum -c "abl_signed-SM8250.elf.sha256" )
  sed 's/%DEVICE%/SM8250/g' flash_abl.sh.template > flash_abl.sh
  # pocknix-update-abl reports the shipped version; the elf itself carries none
  echo "${_ablver}" > version
}

package() {
  local bl="${pkgdir}/usr/share/pocknix/bootloader"

  install -Dm644 "${srcdir}/bootaa64.efi" "${bl}/EFI/BOOT/bootaa64.efi"
  install -Dm644 "${srcdir}/grub.cfg"     "${bl}/boot/grub/grub.cfg"
  install -Dm644 "${srcdir}/grubenv"      "${bl}/boot/grub/grubenv"

  install -Dm755 "${srcdir}/pocknix-update-grub"        "${pkgdir}/usr/bin/pocknix-update-grub"
  install -Dm644 "${srcdir}/95-pocknix-bootloader.hook" "${pkgdir}/usr/share/libalpm/hooks/95-pocknix-bootloader.hook"

  local kit="${bl}/rocknix_abl"
  install -Dm644 "${srcdir}/rocknix-abl-v${_ablver}/abl_signed-SM8250.elf" "${kit}/abl_signed-SM8250.elf"
  install -Dm644 "${srcdir}/README"                "${kit}/README"
  install -Dm755 "${srcdir}/flash_abl.sh"          "${kit}/flash_abl.sh"
  install -Dm755 "${srcdir}/backup_abl.sh"         "${kit}/backup_abl.sh"
  install -Dm755 "${srcdir}/restore_backup_abl.sh" "${kit}/restore_backup_abl.sh"
  install -Dm644 "${srcdir}/version"               "${kit}/version"
  # pocknix-update-grub refreshes GRUB on /flash but not the kit; this hook covers the kit.
  install -Dm644 "${srcdir}/95-pocknix-abl-kit.hook" \
    "${pkgdir}/usr/share/libalpm/hooks/95-pocknix-abl-kit.hook"
}
