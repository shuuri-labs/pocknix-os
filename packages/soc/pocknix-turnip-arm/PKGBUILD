# pocknix-turnip-arm — a pinned aarch64 Turnip build of mesa main, the per-game "Mesa Version"
# tweak's git entry (ARM Proton path, picked by pointing VK_DRIVER_FILES at it). The host driver
# entry comes from vulkan-freedreno's vk-arm manifest. Same per-SoC tuning contract as packages/soc/mesa.
pkgname=pocknix-turnip-arm
pkgver=20261110
pkgrel=1
pkgdesc="Pinned aarch64 Turnip build of mesa main for per-game Mesa selection (SoC-tuned)"
arch=('aarch64')
url="https://www.mesa3d.org/"
license=("MIT AND BSD-3-Clause AND SGI-B-2.0")
# Also the host libs user-supplied Linux Turnip builds link against (xcb-util-keysyms included).
depends=(expat glibc libdrm libdisplay-info libx11 libxcb libxshmfence spirv-tools
         systemd-libs vulkan-icd-loader wayland xcb-util-keysyms zlib zstd)
# glslang: newer mesa folds freedreno into the BVH shader set, so glslangValidator is a hard
# requirement of any build with vulkan-drivers=freedreno.
makedepends=(meson ninja python-mako python-packaging python-yaml python-ply glslang
             expat libdrm libglvnd libdisplay-info spirv-tools systemd-libs vulkan-icd-loader
             wayland wayland-protocols zlib zstd
             xorgproto libx11 libxcb libxext libxshmfence libxxf86vm libxrandr xcb-util-keysyms)
options=(!lto)
# Pinned, not floating, so rebuilds reproduce.
_develcommit=487d4ba4938d043e436dd3aac4e81a42b3b30178
source=("https://gitlab.freedesktop.org/mesa/mesa/-/archive/${_develcommit}/mesa-${_develcommit}.tar.gz")
sha256sums=('7dbba95e4a5682bc1f61751b16b8215daae375887744425658bc2dc6bcf2f91a')

build() {
  # Same tuning contract as packages/soc/mesa (sm8550 fallback for a standalone makepkg).
  local _rocknix_tune="${POCKNIX_TUNE_CFLAGS:--march=armv9-a+fp16+crypto+i8mm+bf16+memtag+sm4+sha3+nosve+nosve2 -mtune=cortex-x3 -mno-outline-atomics}"
  export CFLAGS="${CFLAGS} ${_rocknix_tune}"
  export CXXFLAGS="${CXXFLAGS} ${_rocknix_tune}"

  # Both WSI platforms stay on: x11 for XWayland games, wayland for gamescope-native ones.
  meson setup build "mesa-${_develcommit}" --prefix=/usr --buildtype=plain \
    -Db_ndebug=true \
    -Dplatforms=x11,wayland \
    -Dglx=disabled \
    -Degl=disabled \
    -Dgbm=disabled \
    -Dopengl=false \
    -Dgles1=disabled \
    -Dgles2=disabled \
    -Dgallium-drivers= \
    -Dvulkan-drivers=freedreno \
    -Dfreedreno-kmds=msm \
    -Dvulkan-layers= \
    -Dllvm=disabled \
    -Dshader-cache=enabled \
    -Dandroid-libbacktrace=disabled \
    -Dlibunwind=disabled \
    -Dvalgrind=disabled \
    -Dbuild-tests=false
  meson compile -C build
}

package() {
  # The snapshot's VERSION (X.Y.0-devel) names the dir: the dropdown labels it "X.Y git".
  local ver stage="${srcdir}/stage"
  ver="$(<"mesa-${_develcommit}/VERSION")"
  local dir="${pkgdir}/usr/share/pocknix/vk-arm/${ver//-/}"
  meson install -C build --destdir "${stage}" --no-rebuild
  install -Dm755 "${stage}/usr/lib/libvulkan_freedreno.so" "${dir}/libvulkan_freedreno.so"
  # ICD manifest name has varied across releases, hence the glob.
  sed -E "s|\"library_path\": *\"[^\"]*\"|\"library_path\": \"${dir#"${pkgdir}"}/libvulkan_freedreno.so\"|" \
    "${stage}"/usr/share/vulkan/icd.d/freedreno_icd*.json > "${dir}/icd.json"
  chmod 0644 "${dir}/icd.json"
  install -Dm644 "mesa-${_develcommit}/docs/license.rst" -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
