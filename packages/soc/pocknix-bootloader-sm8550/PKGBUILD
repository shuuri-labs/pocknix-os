# pocknix-bootloader-sm8550 — the OpenABL install kit for SM8550 boards.
# The factory ABL boots only Android, so an ABL must be flashed to abl_a/abl_b ONCE before any SD
# boots. One elf covers the whole SM8550 family: OpenABL keys it by SoC, not board.
# Nothing here flashes at build or install time; both flashing paths (the kit by hand from rooted
# Android, pocknix-update-abl afterwards) are deliberate user actions.
pkgname=pocknix-bootloader-sm8550
_ablver=1.2
pkgver=${_ablver}
pkgrel=3
pkgdesc="SM8550 boot payload: OpenABL install kit (openabl)"
arch=('aarch64')
# !strip: a stripped bootloader is an unbootable one.
options=('!strip')
# bsp-common 37 reads the kit from openabl/ and writes the boot files OpenABL loads.
depends=('pocknix-bsp-common>=0.1.0-37')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL-3.0-or-later' 'BSD-3-Clause')   # OpenABL; the Qualcomm ABL it patches
source=("https://github.com/OpenHandheldCollective/OpenABL/releases/download/v${_ablver}/openabl-v${_ablver}.tar.gz"
        'README'
        'flash_abl.sh.template'
        'backup_abl.sh'
        'restore_backup_abl.sh'
        '95-pocknix-abl-kit.hook')
sha512sums=('41f8b0460bc5c2cbbec312911377e52c41eda7c4dcd365bc76486d81cf4da0e9072df00edaf3afacb87565d856487d0aac3c8b5506d46b9ea6c901c319635492'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

prepare() {
  # the release ships a .sha256 sidecar per elf
  ( cd "openabl-v${_ablver}/SM8550" && sha256sum -c "abl_signed-SM8550.elf.sha256" )
  sed 's/%DEVICE%/SM8550/g' flash_abl.sh.template > flash_abl.sh
  # pocknix-update-abl reports the shipped version; the elf itself carries none
  echo "${_ablver}" > version
}

package() {
  local kit="${pkgdir}/usr/share/pocknix/bootloader/openabl"

  install -Dm644 "openabl-v${_ablver}/SM8550/abl_signed-SM8550.elf" "${kit}/abl_signed-SM8550.elf"
  install -Dm644 README                 "${kit}/README"
  install -Dm755 flash_abl.sh           "${kit}/flash_abl.sh"
  install -Dm755 backup_abl.sh          "${kit}/backup_abl.sh"
  install -Dm755 restore_backup_abl.sh  "${kit}/restore_backup_abl.sh"
  install -Dm644 version                "${kit}/version"

  # pacman never touches /flash, so a hook re-copies the kit there on upgrade.
  install -Dm644 "${srcdir}/95-pocknix-abl-kit.hook" \
    "${pkgdir}/usr/share/libalpm/hooks/95-pocknix-abl-kit.hook"
}
