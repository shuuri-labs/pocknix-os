# pocknix-bootloader-sm8550 — the ROCKNIX ABL install kit for SM8550 boards.
#
# Boot contract (qcom-abl): XBL -> ABL -> /KERNEL (Android boot image) off the
# FAT labeled ROCKNIX. The FACTORY ABL only boots Android, so the ROCKNIX ABL
# must be flashed to abl_a/abl_b ONCE before any SD can boot — contrast sm8250,
# arm-efi, where the factory ABL chainloads UEFI GRUB and no flash is needed.
# The kit (elf + Android-side scripts) lets a stock-Android device provision
# straight from a pocknix SD; build-sd-image.sh copies it to the SD boot FAT
# root, the exact layout ROCKNIX documents. One elf covers the whole SM8550
# family — ROCKNIX keys it by SoC, not board. Provenance, hashes and vendoring
# rules: README.provenance.
# Nothing here flashes at build or install time: first provisioning runs the
# kit by hand from rooted Android, afterwards pocknix-update-abl does it from
# the running system. Both are deliberate user actions — no auto-flash hook,
# unlike ROCKNIX's updateabl.
#
# Version bump: set _ablver to the new release tag (watch ROCKNIX's pin in
# their packages/tools/rocknix-abl/package.mk during `make sync` review — the
# ABL and the boot contract above must stay matched), reset pkgrel=1, refresh
# the tarball sha512.
pkgname=pocknix-bootloader-sm8550
_ablver=1.1.7
pkgver=${_ablver}
pkgrel=3
pkgdesc="SM8550 qcom-abl boot payload: ROCKNIX ABL install kit (rocknix_abl)"
arch=('aarch64')
# !strip: a stripped bootloader is an unbootable one.
options=('!strip')
url="https://github.com/shuuri-labs/pocknix-os"
license=('BSD-3-Clause')   # Qualcomm ABL (edk2 LinuxLoader); kit scripts GPL-2.0
source=("https://github.com/ROCKNIX/abl/releases/download/v${_ablver}/rocknix-abl-v${_ablver}.tar.gz"
        'README'
        'flash_abl.sh.template'
        'backup_abl.sh'
        'restore_backup_abl.sh'
        '95-pocknix-abl-kit.hook')
sha512sums=('fa1d213bec97661942b8083be1f2eb6b65cc200b4f3f76dd84261ba92a01ac9261ed6834350f2f647a5ed82fcabadf5011b9ba6769f471abeaf06210ae9221c1'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

prepare() {
  # The release ships a .sha256 sidecar per elf — verify the one we ship.
  ( cd "rocknix-abl-v${_ablver}" && sha256sum -c "abl_signed-SM8550.elf.sha256" )
  # ROCKNIX package.mk substitution: the flash script names the SoC's elf.
  sed 's/%DEVICE%/SM8550/g' flash_abl.sh.template > flash_abl.sh
  # the elf carries no version of its own
  echo "${_ablver}" > version
}

package() {
  local kit="${pkgdir}/usr/share/pocknix/bootloader/rocknix_abl"

  install -Dm644 "rocknix-abl-v${_ablver}/abl_signed-SM8550.elf" "${kit}/abl_signed-SM8550.elf"
  install -Dm644 README                 "${kit}/README"
  install -Dm755 flash_abl.sh           "${kit}/flash_abl.sh"
  install -Dm755 backup_abl.sh          "${kit}/backup_abl.sh"
  install -Dm755 restore_backup_abl.sh  "${kit}/restore_backup_abl.sh"
  install -Dm644 version                "${kit}/version"

  # pacman never touches /flash, so a hook re-copies the kit there on upgrade.
  install -Dm644 "${srcdir}/95-pocknix-abl-kit.hook" \
    "${pkgdir}/usr/share/libalpm/hooks/95-pocknix-abl-kit.hook"
}
