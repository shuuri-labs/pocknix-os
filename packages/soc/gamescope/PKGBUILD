# gamescope (pocknix) - Valve tag plus a small series for msm handhelds.
# pocknix-steam passes logical LANDSCAPE -W/-H and relies on upstream composite rotation
# (3.16.31+); older builds, ALARM's included, request a plane rotation the msm DPU rejects.
# epoch=1 outranks ALARM's gamescope. The pkgver segment after "rocknix." must vercmp higher
# on every bump, hence commit date then sha — a bare sha is non-monotonic.
pkgname=gamescope
epoch=1
pkgver=3.16.31.rocknix.20260927.f6916aa
pkgrel=2
_commit=f6916aacdecb4476f05746fef4dc49a650c28f05
install=gamescope.install
pkgdesc="SteamOS session compositing WM — patched (for msm handhelds)"
arch=('aarch64')
url="https://github.com/ValveSoftware/gamescope"
license=('BSD-2-Clause')
provides=('gamescope')
conflicts=('gamescope')
depends=('wayland' 'libdrm' 'libinput' 'libxkbcommon' 'pixman' 'systemd-libs' 'libcap'
         'luajit' 'libdecor' 'libx11' 'libxext' 'libxfixes' 'libxdamage' 'libxcomposite'
         'libxrender' 'libxxf86vm' 'libxtst' 'libxi' 'libxcursor' 'libxmu' 'libxres'
         'libxcb' 'xcb-util-wm' 'seatd' 'hwdata' 'sdl2' 'pipewire' 'vulkan-icd-loader'
         'glslang' 'xorg-xwayland' 'libdisplay-info')
makedepends=('git' 'meson' 'ninja' 'cmake' 'pkgconf' 'glslang' 'vulkan-headers'
             'wayland-protocols' 'python' 'libxkbcommon' 'wayland'
             # wlroots subproject build-deps (else meson tries to build them itself):
             'xorg-xwayland' 'libdisplay-info' 'xcb-util-errors' 'xcb-util-renderutil'
             'xcb-util-image' 'xcb-util-keysyms')
source=("gamescope::git+https://github.com/ValveSoftware/gamescope.git#commit=${_commit}"
        '0001-WaylandBackend-wire-up-wl_touch-implementation.patch'
        '0004-DRMBackend-Add-GAMESCOPE_FAKE_OUTPUT_MM-env-to-set-c.patch'
        '0006-steamcompmgr-fix-gamepad-cursor-sprite-frozen-via-XTest.patch'
        '0009-steamcompmgr-run-SGSR-when-FSR-is-requested-on-SDR-content.patch'
        '0010-steamcompmgr-elapsed-time-fps-limiter.patch')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

prepare() {
  cd gamescope
  git submodule update --init --recursive
  # Patch numbers are never reused; dropped ones are listed in PATCHES.md.
  patch -p1 < "${srcdir}/0001-WaylandBackend-wire-up-wl_touch-implementation.patch"
  patch -p1 < "${srcdir}/0004-DRMBackend-Add-GAMESCOPE_FAKE_OUTPUT_MM-env-to-set-c.patch"
  patch -p1 < "${srcdir}/0006-steamcompmgr-fix-gamepad-cursor-sprite-frozen-via-XTest.patch"
  patch -p1 < "${srcdir}/0009-steamcompmgr-run-SGSR-when-FSR-is-requested-on-SDR-content.patch"
  patch -p1 < "${srcdir}/0010-steamcompmgr-elapsed-time-fps-limiter.patch"
}

build() {
  cd gamescope
  # gamescope and wlroots build with -Werror against older libs than ALARM ships (newer
  # libinput enums alone break -Werror=switch); appended last, these override it, and they
  # propagate into the subprojects.
  export CFLAGS+=" -Wno-error" CXXFLAGS+=" -Wno-error"
  # Appended last so -march/-mtune override ALARM's defaults, subprojects included.
  # Fallback = sm8550, as in packages/soc/mesa.
  local _rocknix_tune="${POCKNIX_TUNE_CFLAGS:--march=armv9-a+fp16+crypto+i8mm+bf16+memtag+sm4+sha3+nosve+nosve2 -mtune=cortex-x3 -mno-outline-atomics}"
  export CFLAGS+=" ${_rocknix_tune}" CXXFLAGS+=" ${_rocknix_tune}"
  meson setup build \
    --prefix=/usr --buildtype=release -Db_lto=false \
    -Ddrm_backend=enabled \
    -Dpipewire=enabled \
    -Denable_openvr_support=false \
    -Davif_screenshots=disabled \
    -Dbenchmark=disabled \
    -Dinput_emulation=disabled \
    -Drt_cap=enabled \
    -Denable_tests=false \
    -Dsdl2_backend=enabled
  meson compile -C build
}

package() {
  cd gamescope
  meson install -C build --destdir "${pkgdir}"
}
