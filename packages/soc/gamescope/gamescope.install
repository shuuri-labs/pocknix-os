# CAP_SYS_NICE (checked at startup by the -Drt_cap=enabled build) is set here rather than in
# package(): pacman does not reliably carry the security.capability xattr through the tarball.
# Guarded because without it gamescope only drops to normal priority, which must not fail the
# transaction; needs an xattr-capable rootfs.
post_install() {
  setcap 'cap_sys_nice+ep' /usr/bin/gamescope 2>/dev/null || true
}

post_upgrade() {
  post_install
}
