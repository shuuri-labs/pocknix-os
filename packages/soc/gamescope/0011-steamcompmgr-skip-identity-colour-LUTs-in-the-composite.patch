diff --git a/src/steamcompmgr.cpp b/src/steamcompmgr.cpp
index 5179700..48a1b09 100644
--- a/src/steamcompmgr.cpp
+++ b/src/steamcompmgr.cpp
@@ -327,6 +327,18 @@ static const gamescope_color_mgmt_t k_ScreenshotColorMgmtHDR =
 //#define COLOR_MGMT_MICROBENCH
 // sudo cpupower frequency-set --governor performance
 
+// An identity transform still costs the per-pixel shaper + 3D LUT taps in the composite
+// shader, the bulk of a composited frame on a GPU that cannot scan the layers out.
+gamescope::ConVar<bool> cv_color_mgmt_skip_identity_luts{ "color_mgmt_skip_identity_luts", true, "Leave the shaper + 3D LUTs out of the composite shader when they are an identity transform." };
+// Where scanout skips the colour pipeline a scanned-out frame never sees the SDR gamut
+// remap, so a composited one must not either or the look shifts with every composite.
+gamescope::ConVar<bool> cv_color_mgmt_native_gamut_without_plane_cm{ "color_mgmt_native_gamut_without_plane_cm", true, "Keep SDR content in the native gamut when scanout cannot be colour managed, so composited and scanned-out frames match." };
+
+static bool BForceNativeSDRGamut()
+{
+	return cv_color_mgmt_native_gamut_without_plane_cm && !GetBackend()->SupportsScanoutColorManagement();
+}
