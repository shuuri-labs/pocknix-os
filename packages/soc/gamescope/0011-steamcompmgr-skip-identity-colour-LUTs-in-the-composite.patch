 			for ( size_t i=0, end = g_tmpLut1d.dataR.size(); i<end; ++i )
 			{
@@ -612,8 +636,13 @@ update_color_mgmt()
 	struct timespec t0, t1;
 #else
 	// check if any part of our color mgmt stack is dirty
-	if ( g_ColorMgmt.pending == g_ColorMgmt.current && g_ColorMgmt.serial != 0 )
+	// The native-gamut decision feeds the LUT build, not the compared state, and the
+	// backend's answer can change at runtime, so a flip must get past the dirty check.
