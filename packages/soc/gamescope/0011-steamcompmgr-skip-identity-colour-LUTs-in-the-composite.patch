             whitePointDestAdaptation = dest_from_xyz * virtualWhiteXYZFromPhysicalWhiteXYZ * xyz_from_dest;
@@ -828,6 +831,41 @@ void calcColorTransform( lut1d_t * pShaper, int nLutSize1d,
     }
 }
 
+bool BIsIdentityLut( const lut1d_t & lut1d, const lut3d_t & lut3d, float flTolerance )
+{
+    if ( lut1d.lutSize < 2 || lut3d.lutEdgeSize < 2 )
+        return false;
+
+    const float flScale1d = 1.f / ( (float) lut1d.lutSize - 1.f );
+    for ( int i = 0; i < lut1d.lutSize; ++i )
+    {
+        const float flExpected = i * flScale1d;
+        if ( std::abs( lut1d.dataR[i] - flExpected ) > flTolerance ||
+             std::abs( lut1d.dataG[i] - flExpected ) > flTolerance ||
+             std::abs( lut1d.dataB[i] - flExpected ) > flTolerance )
+            return false;
+    }
+
+    const int nEdge = lut3d.lutEdgeSize;
+    const float flScale3d = 1.f / ( (float) nEdge - 1.f );
+    for ( int nBlue = 0; nBlue < nEdge; ++nBlue )
+    {
+        for ( int nGreen = 0; nGreen < nEdge; ++nGreen )
+        {
+            for ( int nRed = 0; nRed < nEdge; ++nRed )
+            {
+                const glm::vec3 & value = lut3d.data[GetLut3DIndexRedFastRGB( nRed, nGreen, nBlue, nEdge )];
+                if ( std::abs( value.r - nRed * flScale3d ) > flTolerance ||
+                     std::abs( value.g - nGreen * flScale3d ) > flTolerance ||
+                     std::abs( value.b - nBlue * flScale3d ) > flTolerance )
+                    return false;
+            }
+        }
+    }
+
+    return true;
+}
