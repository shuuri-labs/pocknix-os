 		return;
+	s_bLastNativeGamut = bNativeGamut;
 #endif
 
 #ifdef COLOR_MGMT_MICROBENCH
@@ -3503,7 +3532,9 @@ paint_all( global_focus_t *pFocus, bool async )
 
 	for (uint32_t i = 0; i < EOTF_Count; i++)
 	{
-		if ( g_ColorMgmtLuts[i].HasLuts() )
