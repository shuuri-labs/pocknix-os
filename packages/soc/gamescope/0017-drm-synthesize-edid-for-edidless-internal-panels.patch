From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Wed, 11 Nov 2026 00:00:00 +0000
Subject: [PATCH] drm: synthesize a client EDID for EDID-less internal panels

Internal DSI panels often expose no EDID, leaving gamescope without display
identity, colorimetry defaults, or a client-facing EDID. Generate a valid
baseline EDID from the connector preferred kernel mode (sRGB chromaticity,
no HDR) and feed it through the existing parser. Physical EDIDs stay
preferred and unchanged; the synthetic EDID is never committed to KMS.
---
 src/Backends/DRMBackend.cpp |  60 ++++++++++++++++----
 src/edid.cpp                | 107 ++++++++++++++++++++++++++++++++++++
 src/edid.h                  |  18 ++++++
 3 files changed, 173 insertions(+), 12 deletions(-)

diff --git a/src/Backends/DRMBackend.cpp b/src/Backends/DRMBackend.cpp
index 6210e17..a1bd2c9 100644
--- a/src/Backends/DRMBackend.cpp
+++ b/src/Backends/DRMBackend.cpp
@@ -411,6 +411,7 @@ namespace gamescope
 		const displaycolorimetry_t& GetDisplayColorimetry() const { return m_Mutable.DisplayColorimetry; }
 
 		std::span<const uint8_t> GetRawEDID() const override { return std::span<const uint8_t>{ m_Mutable.EdidData.begin(), m_Mutable.EdidData.end() }; }
+		bool HasPhysicalEdid() const { return m_Mutable.bHasPhysicalEdid; }
 		bool HandleEdidChange()
 		{
 			bool bChanged = m_Mutable.bEdidChanged;
@@ -532,7 +533,8 @@ namespace gamescope
 			const char *pszMake = ""; // Not owned, no free. This is a pointer to pnp db or szMakePNP.
 			DRMModeGenerator fnDynamicModeGenerator;
 			std::vector<uint32_t> ValidDynamicRefreshRates{};
-			std::vector<uint8_t> EdidData; // Raw, unmodified.
+			std::vector<uint8_t> EdidData; // Physical or synthetic; never committed to KMS.
+			bool bHasPhysicalEdid = false;
 			std::vector<BackendMode> BackendModes;
 			
 			displaycolorimetry_t DisplayColorimetry = displaycolorimetry_709;
@@ -2562,20 +2564,54 @@ namespace gamescope
 
 	void CDRMConnector::ParseEDID()
 	{
-		if ( !GetProperties().EDID )
-			return;
+		if ( GetProperties().EDID )
+		{
+			const uint64_t ulBlobId = GetProperties().EDID->GetCurrentValue();
+			if ( ulBlobId )
+			{
+				drmModePropertyBlobRes *pBlob = drmModeGetPropertyBlob( g_DRM.fd, ulBlobId );
+				if ( pBlob )
+				{
+					defer( drmModeFreePropertyBlob( pBlob ) );
+					const uint8_t *pDataPointer = reinterpret_cast<const uint8_t *>( pBlob->data );
+					m_Mutable.EdidData = std::vector<uint8_t>{ pDataPointer, pDataPointer + pBlob->length };
+					m_Mutable.bHasPhysicalEdid = true;
+				}
+			}
+		}
 
-		uint64_t ulBlobId = GetProperties().EDID->GetCurrentValue();
-		if ( !ulBlobId )
-			return;
+		if ( m_Mutable.EdidData.empty() && GetScreenType() == GAMESCOPE_SCREEN_TYPE_INTERNAL )
+		{
+			const drmModeModeInfo *pPreferredMode = find_mode( m_pConnector.get(), 0, 0, 0 );
+			if ( pPreferredMode && !( pPreferredMode->flags & DRM_MODE_FLAG_INTERLACE ) )
+			{
+				m_Mutable.bHasPhysicalEdid = false;
+				m_Mutable.EdidData = GenerateSimpleEdid( EdidModeInfo
+				{
+					.clockKHz = static_cast<uint32_t>( pPreferredMode->clock ),
+					.hdisplay = pPreferredMode->hdisplay,
+					.hsyncStart = pPreferredMode->hsync_start,
+					.hsyncEnd = pPreferredMode->hsync_end,
+					.htotal = pPreferredMode->htotal,
+					.vdisplay = pPreferredMode->vdisplay,
+					.vsyncStart = pPreferredMode->vsync_start,
+					.vsyncEnd = pPreferredMode->vsync_end,
+					.vtotal = pPreferredMode->vtotal,
+					.physicalWidthMm = m_pConnector->mmWidth > 0 ? static_cast<uint32_t>( m_pConnector->mmWidth ) : 0,
+					.physicalHeightMm = m_pConnector->mmHeight > 0 ? static_cast<uint32_t>( m_pConnector->mmHeight ) : 0,
+					.hsyncPositive = !!( pPreferredMode->flags & DRM_MODE_FLAG_PHSYNC ),
+					.vsyncPositive = !!( pPreferredMode->flags & DRM_MODE_FLAG_PVSYNC ),
+				} );
+				if ( !m_Mutable.EdidData.empty() )
+				{
+					drm_log.infof( "Generated synthetic EDID for EDID-less internal connector %s from mode %s",
+						m_Mutable.szName, pPreferredMode->name );
+				}
+			}
+		}
 
-		drmModePropertyBlobRes *pBlob = drmModeGetPropertyBlob( g_DRM.fd, ulBlobId );
-		if ( !pBlob )
+		if ( m_Mutable.EdidData.empty() )
 			return;
-		defer( drmModeFreePropertyBlob( pBlob ) );
-
-		const uint8_t *pDataPointer = reinterpret_cast<const uint8_t *>( pBlob->data );
-		m_Mutable.EdidData = std::vector<uint8_t>{ pDataPointer, pDataPointer + pBlob->length };
 
 		di_info *pInfo = di_info_parse_edid( m_Mutable.EdidData.data(), m_Mutable.EdidData.size() );
 		if ( !pInfo )
diff --git a/src/edid.cpp b/src/edid.cpp
index 45c83cf..fc44dde 100644
--- a/src/edid.cpp
+++ b/src/edid.cpp
@@ -4,8 +4,10 @@
 #include "log.hpp"
 #include "hdmi.h"
 
+#include <algorithm>
 #include <cassert>
 #include <climits>
+#include <cmath>
 #include <cstring>
 #include <cstdlib>
 
@@ -406,4 +408,109 @@ namespace gamescope
 
         return szPath;
     }
+
+    std::vector<uint8_t> GenerateSimpleEdid( const EdidModeInfo &mode )
+    {
+        if ( !mode.clockKHz || mode.clockKHz > 655350 ||
+             !mode.hdisplay || mode.hdisplay > 4095 ||
+             mode.hsyncStart < mode.hdisplay || mode.hsyncEnd < mode.hsyncStart || mode.htotal < mode.hsyncEnd ||
+             !mode.vdisplay || mode.vdisplay > 4095 ||
+             mode.vsyncStart < mode.vdisplay || mode.vsyncEnd < mode.vsyncStart || mode.vtotal < mode.vsyncEnd )
+        {
+            return {};
+        }
+
+        // Physical size is optional info; report unknown rather than failing
+        // when the connector reports nothing or something unencodable.
+        uint32_t widthMm = mode.physicalWidthMm;
+        uint32_t heightMm = mode.physicalHeightMm;
+        if ( !widthMm || widthMm > 4095 || !heightMm || heightMm > 4095 )
+            widthMm = heightMm = 0;
+
+        const uint32_t hblank = mode.htotal - mode.hdisplay;
+        const uint32_t vblank = mode.vtotal - mode.vdisplay;
+        if ( !hblank || hblank > 4095 || !vblank || vblank > 4095 )
+            return {};
+
+        // These fields only describe timing to EDID readers; the mode comes from the
+        // kernel. A large front porch (ICNA3512: 412 lines) overflows the DTD, so clamp.
+        const uint32_t hsyncOffset = std::min<uint32_t>( mode.hsyncStart - mode.hdisplay, 1023 );
+        const uint32_t hsyncWidth = std::clamp<uint32_t>( mode.hsyncEnd - mode.hsyncStart, 1, 1023 );
+        const uint32_t vsyncOffset = std::min<uint32_t>( mode.vsyncStart - mode.vdisplay, 63 );
+        const uint32_t vsyncWidth = std::clamp<uint32_t>( mode.vsyncEnd - mode.vsyncStart, 1, 63 );
+
+        const uint32_t pixelClock10KHz = ( mode.clockKHz + 5 ) / 10;
+        if ( !pixelClock10KHz || pixelClock10KHz > UINT16_MAX )
+            return {};
+
+        std::vector<uint8_t> edid = GenerateSimpleEdid( mode.hdisplay, mode.vdisplay );
+        uint8_t *dtd = &edid[0x36];
+        std::fill( dtd, dtd + EDID_BYTE_DESCRIPTOR_SIZE, 0 );
+
+        dtd[0] = pixelClock10KHz & 0xff;
+        dtd[1] = ( pixelClock10KHz >> 8 ) & 0xff;
+        dtd[2] = mode.hdisplay & 0xff;
+        dtd[3] = hblank & 0xff;
+        dtd[4] = ( ( mode.hdisplay >> 8 ) << 4 ) | ( hblank >> 8 );
+        dtd[5] = mode.vdisplay & 0xff;
+        dtd[6] = vblank & 0xff;
+        dtd[7] = ( ( mode.vdisplay >> 8 ) << 4 ) | ( vblank >> 8 );
+        dtd[8] = hsyncOffset & 0xff;
+        dtd[9] = hsyncWidth & 0xff;
+        dtd[10] = ( ( vsyncOffset & 0xf ) << 4 ) | ( vsyncWidth & 0xf );
+        dtd[11] = ( ( hsyncOffset >> 8 ) << 6 ) |
+                  ( ( hsyncWidth >> 8 ) << 4 ) |
+                  ( ( vsyncOffset >> 4 ) << 2 ) |
+                    ( vsyncWidth >> 4 );
+        dtd[12] = widthMm & 0xff;
+        dtd[13] = heightMm & 0xff;
+        dtd[14] = ( ( widthMm >> 8 ) << 4 ) | ( heightMm >> 8 );
+        dtd[17] = 0x18 |
+                  ( mode.vsyncPositive ? 0x04 : 0 ) |
+                  ( mode.hsyncPositive ? 0x02 : 0 );
+
+        edid[0x15] = std::min<uint32_t>( 255, ( widthMm + 5 ) / 10 );
+        edid[0x16] = std::min<uint32_t>( 255, ( heightMm + 5 ) / 10 );
+
+        // The template blob carries Deck-OLED-like wide-gamut chromaticity,
+        // which downstream colorimetry would trust. A generic panel should
+        // advertise plain sRGB instead.
+        const auto to10Bit = []( float coord ) -> uint32_t
+        {
+            return std::min<uint32_t>( 1023, static_cast<uint32_t>( lroundf( coord * 1024.0f ) ) );
+        };
+        const uint32_t rx = to10Bit( 0.640f ), ry = to10Bit( 0.330f );
+        const uint32_t gx = to10Bit( 0.300f ), gy = to10Bit( 0.600f );
+        const uint32_t bx = to10Bit( 0.150f ), by = to10Bit( 0.060f );
+        const uint32_t wx = to10Bit( 0.3127f ), wy = to10Bit( 0.3290f );
+        edid[0x19] = ( ( rx & 3 ) << 6 ) | ( ( ry & 3 ) << 4 ) | ( ( gx & 3 ) << 2 ) | ( gy & 3 );
+        edid[0x1a] = ( ( bx & 3 ) << 6 ) | ( ( by & 3 ) << 4 ) | ( ( wx & 3 ) << 2 ) | ( wy & 3 );
+        edid[0x1b] = rx >> 2;
+        edid[0x1c] = ry >> 2;
+        edid[0x1d] = gx >> 2;
+        edid[0x1e] = gy >> 2;
+        edid[0x1f] = bx >> 2;
+        edid[0x20] = by >> 2;
+        edid[0x21] = wx >> 2;
+        edid[0x22] = wy >> 2;
+
+        // The template's 45-90Hz range limits contradict the real mode; blanking it
+        // also requires clearing the continuous-frequency bit, which mandates one.
+        edid[0x18] &= ~0x01;
+        uint8_t *dummyDescriptor = &edid[0x5a];
+        std::fill( dummyDescriptor, dummyDescriptor + EDID_BYTE_DESCRIPTOR_SIZE, 0 );
+        dummyDescriptor[3] = 0x10;
+
+        // Keep a valid, empty CTA extension so display policy can add metadata
+        // without replacing this baseline EDID.
+        uint8_t *cta = &edid[EDID_BLOCK_SIZE];
+        std::fill( cta, cta + EDID_BLOCK_SIZE, 0 );
+        cta[0] = DI_EDID_EXT_CEA;
+        cta[1] = 3;
+        cta[2] = 4;
+        patch_edid_checksum( cta );
+
+        patch_edid_checksum( &edid[0] );
+        return edid;
+    }
 }
diff --git a/src/edid.h b/src/edid.h
index 137350c..397a089 100644
--- a/src/edid.h
+++ b/src/edid.h
@@ -9,9 +9,27 @@ namespace gamescope
 {
     struct BackendConnectorHDRInfo;
 
+    struct EdidModeInfo
+    {
+        uint32_t clockKHz = 0;
+        uint32_t hdisplay = 0;
+        uint32_t hsyncStart = 0;
+        uint32_t hsyncEnd = 0;
+        uint32_t htotal = 0;
+        uint32_t vdisplay = 0;
+        uint32_t vsyncStart = 0;
+        uint32_t vsyncEnd = 0;
+        uint32_t vtotal = 0;
+        uint32_t physicalWidthMm = 0;
+        uint32_t physicalHeightMm = 0;
+        bool hsyncPositive = false;
+        bool vsyncPositive = false;
+    };
+
     const char *GetPatchedEdidPath();
     void WritePatchedEdid( std::span<const uint8_t> pEdid, const BackendConnectorHDRInfo &hdrInfo, bool bRotate );
     std::vector<uint8_t> GenerateSimpleEdid( uint32_t uWidth, uint32_t uHeight );
+    std::vector<uint8_t> GenerateSimpleEdid( const EdidModeInfo &mode );
     const char *EnsureVirtualEdid();
 
     std::optional<std::vector<uint8_t>> PatchEdid( std::span<const uint8_t> pEdid, const BackendConnectorHDRInfo &hdrInfo, bool bRotate );
