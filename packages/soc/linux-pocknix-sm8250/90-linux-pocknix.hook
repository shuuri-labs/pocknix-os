# Makes a kernel pacman transaction on the device a complete deploy; no-ops in the image-build
# chroot, where pocknix-update-boot finds no mounted /flash.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = boot/Image
Target = boot/dtbs/*
Target = usr/lib/modules/*

[Action]
Description = pocknix: refreshing /flash KERNEL + dtbs (arm-efi)...
When = PostTransaction
Exec = /usr/bin/pocknix-update-boot
