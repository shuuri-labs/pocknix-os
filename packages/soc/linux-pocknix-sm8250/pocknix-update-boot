#!/bin/bash
# pocknix-update-boot — refresh the arm-efi boot files on /flash from the installed kernel.
#
# Run by the linux-pocknix alpm hook after a kernel install/upgrade (and runnable by hand).
# arm-efi contract (SM8250): GRUB's "linux /KERNEL" loads a RAW arm64 Image and the board dtb
# is a separate "devicetree /boot/grub/<board>.dtb" — so a kernel deploy is two copies, no
# mkbootimg. Keeps /flash/KERNEL.bak and writes /flash/KERNEL.md5 (contract parity with the
# qcom-abl devices; GRUB itself doesn't check it).
#
# SRCROOT (default /): alternate root tree to deploy FROM — pocknix-rollback passes the target
# snapshot so the deployed kernel matches the rolled-back modules. OUT_SUFFIX (default empty):
# stage as KERNEL${OUT_SUFFIX} / *.dtb${OUT_SUFFIX} without touching the live files or
# KERNEL.bak (rollback renames after its atomic commit). Defaults = byte-identical hook path.
set -euo pipefail

FLASH="${FLASH:-/flash}"
SRCROOT="${SRCROOT:-}"
OUT_SUFFIX="${OUT_SUFFIX:-}"

[ -f "${SRCROOT}/boot/Image" ] || { echo "pocknix-update-boot: no ${SRCROOT}/boot/Image — nothing to do"; exit 0; }
# In the image-build chroot /flash isn't a real mount; build-sd-image.sh populates the FAT
# there instead, so skip. On the device /flash is the FAT boot partition (fstab) -> refresh.
mountpoint -q "$FLASH" || { echo "pocknix-update-boot: $FLASH not mounted — skipping (build chroot?)"; exit 0; }

mount -o remount,rw "$FLASH" 2>/dev/null || true
if [ -z "$OUT_SUFFIX" ]; then
  [ -f "$FLASH/KERNEL" ] && cp -f "$FLASH/KERNEL" "$FLASH/KERNEL.bak"
fi
cp -f "${SRCROOT}/boot/Image" "$FLASH/KERNEL${OUT_SUFFIX}"
# md5 content always names "KERNEL" (contract parity; correct after the stage-rename)
printf '%s  KERNEL\n' "$(md5sum "$FLASH/KERNEL${OUT_SUFFIX}" | awk '{print $1}')" > "$FLASH/KERNEL.md5${OUT_SUFFIX}"
if ls "${SRCROOT}"/boot/dtbs/*.dtb >/dev/null 2>&1; then
  mkdir -p "$FLASH/boot/grub"
  for d in "${SRCROOT}"/boot/dtbs/*.dtb; do
    cp -f "$d" "$FLASH/boot/grub/$(basename "$d")${OUT_SUFFIX}"
  done
fi
sync
note="KERNEL.bak kept"; [ -n "$OUT_SUFFIX" ] && note="staged, not activated"
echo "pocknix-update-boot: refreshed $FLASH/KERNEL${OUT_SUFFIX} + boot/grub dtbs (kernel $(cat "${SRCROOT}/usr/lib/pocknix/kernelrelease" 2>/dev/null || echo '?'); ${note})"
