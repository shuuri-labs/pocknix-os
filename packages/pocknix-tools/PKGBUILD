# pocknix-tools — the desktop maintenance app: snapshot rollback (running system
# and the internal install from SD), the locked/rolling mode switch, and the
# internal-storage installer GUI. Folds in the old standalone Pocknix Rollback
# and Pocknix Installer shortcuts; the CLIs it fronts stay in their own packages.
pkgname=pocknix-tools
pkgver=0.1.0
pkgrel=1
pkgdesc="Pocknix maintenance app: snapshot rollback, base mode switch, internal install"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('MIT')
depends=('pocknix-snapshots' 'pocknix-base' 'kdialog')
# absorbs the short-lived standalone installer package (never published)
replaces=('pocknix-installer')
conflicts=('pocknix-installer')
install=pocknix-tools.install
source=('pocknix-tools' 'pocknix-tools.desktop' 'pocknix-installer-gui')
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 "${srcdir}/pocknix-tools" "${pkgdir}/usr/bin/pocknix-tools"
  install -Dm755 "${srcdir}/pocknix-installer-gui" "${pkgdir}/usr/bin/pocknix-installer-gui"
  install -Dm644 "${srcdir}/pocknix-tools.desktop" \
    "${pkgdir}/usr/share/applications/pocknix-tools.desktop"
}
