# proton-ge-dxvk2 — proton-ge with DXVK pinned to 2.7 (the sm8250 variant).
# Same rationale + rules as proton-cachyos-dxvk2 (see its header): current GE release
# with only files/lib/wine/dxvk/ swapped; publish to the sm8250 repo ONLY; _srctag
# tracks proton-ge in lockstep.
#
# Donor = VALVE Proton 11 ARM dlls (see README.provenance), NOT a GE release: GE's
# oldest ARM build already carries DXVK's storageBuffer8BitAccess floor (it landed on
# DXVK master pre-3.0-tag; a "2.7.1-*" version string proves nothing, verify per-build).
# Valve's dlls run under GE's wine (same Proton lineage) but CRASH under cachy's —
# mind the lineage rule if either donor ever changes.
pkgname=proton-ge-dxvk2
_srctag=GE-Proton11-3
_ver=${_srctag#GE-Proton}
_major=${_ver%%-*}
pkgver=${_ver//-/.}
pkgrel=2
pkgdesc="GE-Proton (ARM64) with DXVK pinned to 2.7 for GPUs without 8-bit storage (a6xx)"
arch=('aarch64')
url="https://github.com/GloriousEggroll/proton-ge-custom"
license=('BSD' 'LGPL' 'zlib' 'MIT' 'MPL' 'custom')
depends=('bash' 'python' 'pocknix-steam')
options=('!strip' 'emptydirs')
provides=("proton-ge=${pkgver}")
conflicts=('proton-ge')
replaces=('proton-ge')
_donor=dxvk-arm64-2.7.1-467-valve-proton11
source=("https://github.com/GloriousEggroll/proton-ge-custom/releases/download/${_srctag}/${_srctag}-aarch64.tar.gz"
        "https://pocknix.shuuri.net/mirror/${_donor}.tar.xz"
        'compatibilitytool.vdf.in'
        'toolmanifest.vdf'
        'pocknix-proton')
sha512sums=('703fe0f1722e55300f14f425e5985bc903669ee29b9647cfdb8120cb5b361efc8b26bb68cd601daeb612ae2d5c5e615065d375650e6da84f82e8c14fcae48c90'
            '0360fd5c00c16381be4380ea3f7b1f4c4afe6721fef483ad092bfd538bc57b2b4a869a17c084fbc2a795fc99c9dba10cf1a0258910fbb83afbe1a0257cf24962'
            'SKIP'
            'SKIP'
            'SKIP')

build() {
  sed "s|@VER@|${_major}|" compatibilitytool.vdf.in > compatibilitytool.vdf
}

package() {
  local tooldir="usr/share/steam/compatibilitytools.d/proton-ge"
  # Upstream's tarball top dir has moved between releases; resolve it by tag.
  local dist
  dist="$(find "${srcdir}" -maxdepth 1 -mindepth 1 -type d -name "${_srctag}*" | head -1)"
  [ -n "${dist}" ] || return 1

  mkdir -p "${pkgdir}/${tooldir}"
  cp -a "${dist}/." "${pkgdir}/${tooldir}/"

  # The one variant delta: the donor's DXVK 2.7 dir (mirror tarball extracts to dxvk/).
  local dxvk="${pkgdir}/${tooldir}/files/lib/wine/dxvk"
  [ -d "${srcdir}/dxvk" ] || return 1
  rm -rf "${dxvk}"
  cp -a "${srcdir}/dxvk" "${dxvk}"

  install -Dm644 "${srcdir}/compatibilitytool.vdf" "${pkgdir}/${tooldir}/compatibilitytool.vdf"
  install -Dm644 "${srcdir}/toolmanifest.vdf"      "${pkgdir}/${tooldir}/toolmanifest.vdf"
  install -Dm755 "${srcdir}/pocknix-proton"        "${pkgdir}/${tooldir}/pocknix-proton"

  local f
  for f in LICENSE LICENSE.OFL PATENTS.AV1; do
    if [ -f "${pkgdir}/${tooldir}/${f}" ]; then
      install -Dm644 "${pkgdir}/${tooldir}/${f}" "${pkgdir}/usr/share/licenses/${pkgname}/${f}"
      rm -f "${pkgdir}/${tooldir}/${f}"
    fi
  done
}
