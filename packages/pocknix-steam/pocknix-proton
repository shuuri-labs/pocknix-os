#!/bin/sh
# pocknix-proton — compat-tool entrypoint shim. toolmanifest.vdf's commandline points here
# (paths are relative to the tool dir); wraps the real entrypoint next to it with the per-game
# tweak wrapper. In Proton dirs that is `proton`; in SteamLinuxRuntime dirs (Valve x86 Protons
# run inside the container) it is `_v2-entry-point`. Installed by pocknix-proton-prep.
here="$(dirname "$0")"
target="${here}/proton"
[ -e "${target}" ] || target="${here}/_v2-entry-point"
# A container has its own /usr, so the wrapper is unreachable there; launching untweaked beats failing.
WRAPPER=/usr/lib/pocknix/pocknix-proton-wrapper
[ -x "${WRAPPER}" ] || exec "${target}" "$@"
exec "${WRAPPER}" "${target}" "$@"
