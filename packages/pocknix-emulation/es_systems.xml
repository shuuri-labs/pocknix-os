<?xml version="1.0"?>
<!--
  pocknix ES-DE custom system definitions. Seeded to ~/ES-DE/custom_systems/es_systems.xml by
  pocknix-roms-init. A custom entry REPLACES the bundled system of the same name, so each entry
  here is the FULL definition (copied from ES-DE's bundled linuxarm es_systems.xml) with only
  the launch command changed.

  ps2: ES-DE's linuxarm build offers ONLY the RetroArch pcsx2 core (LRPS2) for PS2 — no
  standalone-PCSX2 command at all — and pocknix deliberately doesn't ship that core (PS2 default
  is ARMSX2, see the PCSX2 note in es_find_rules.xml). Command drives the es-armsx2 big-core pin
  wrapper with pocknix-play's verified ARMSX2 flags.

  psx: no bundled PS1 command names a core we ship except pcsx_rearmed, and ES-DE's
  "DuckStation" is the standalone (no arm64 build) — ours is the libretro core it never names.

  gc/wii: bundled default is the RetroArch dolphin core, also not shipped (pocknix default =
  standalone Dolphin, same commands as bundled "Dolphin (Standalone)" alternative — promoted to
  the default here).
-->
<systemList>
    <system>
        <name>gc</name>
        <fullname>Nintendo GameCube</fullname>
        <path>%ROMPATH%/gc</path>
        <extension>.ciso .CISO .dff .DFF .dol .DOL .elf .ELF .gcm .GCM .gcz .GCZ .iso .ISO .json .JSON .m3u .M3U .rvz .RVZ .tgc .TGC .wad .WAD .wbfs .WBFS .wia .WIA .7z .7Z .zip .ZIP</extension>
        <command label="Dolphin">/usr/lib/pocknix/es-dolphin -b -e %ROM%</command>
        <command label="Shortcut or script">%ENABLESHORTCUTS% %EMULATOR_OS-SHELL% %ROM%</command>
        <platform>gc</platform>
        <theme>gc</theme>
    </system>
    <system>
        <name>wii</name>
        <fullname>Nintendo Wii</fullname>
        <path>%ROMPATH%/wii</path>
        <extension>.ciso .CISO .dff .DFF .dol .DOL .elf .ELF .gcm .GCM .gcz .GCZ .iso .ISO .json .JSON .m3u .M3U .rvz .RVZ .tgc .TGC .wad .WAD .wbfs .WBFS .wia .WIA .7z .7Z .zip .ZIP</extension>
        <command label="Dolphin">/usr/lib/pocknix/es-dolphin -b -e %ROM%</command>
        <command label="Shortcut or script">%ENABLESHORTCUTS% %EMULATOR_OS-SHELL% %ROM%</command>
        <platform>wii</platform>
        <theme>wii</theme>
    </system>
    <system>
        <name>psx</name>
        <fullname>Sony PlayStation</fullname>
        <path>%ROMPATH%/psx</path>
        <extension>.bin .BIN .cbn .CBN .ccd .CCD .chd .CHD .cue .CUE .ecm .ECM .exe .EXE .img .IMG .iso .ISO .m3u .M3U .mdf .MDF .mds .MDS .minipsf .MINIPSF .pbp .PBP .psexe .PSEXE .psf .PSF .toc .TOC .z .Z .znx .ZNX .7z .7Z .zip .ZIP</extension>
        <command label="DuckStation">%EMULATOR_RETROARCH% -L %CORE_RETROARCH%/duckstation_libretro.so %ROM%</command>
        <command label="PCSX ReARMed">%EMULATOR_RETROARCH% -L %CORE_RETROARCH%/pcsx_rearmed_libretro.so %ROM%</command>
        <command label="Shortcut or script">%ENABLESHORTCUTS% %EMULATOR_OS-SHELL% %ROM%</command>
        <platform>psx</platform>
        <theme>psx</theme>
    </system>
    <system>
        <name>ps2</name>
        <fullname>Sony PlayStation 2</fullname>
        <path>%ROMPATH%/ps2</path>
        <extension>.bin .BIN .chd .CHD .ciso .CISO .cso .CSO .desktop .dump .DUMP .elf .ELF .gz .GZ .m3u .M3U .mdf .MDF .img .IMG .iso .ISO .isz .ISZ .ngr .NRG .zso .ZSO</extension>
        <command label="ARMSX2">/usr/lib/pocknix/es-armsx2 -batch -fullscreen -- %ROM%</command>
        <command label="Shortcut or script">%ENABLESHORTCUTS% %EMULATOR_OS-SHELL% %ROM%</command>
        <platform>ps2</platform>
        <theme>ps2</theme>
    </system>
    <system>
        <name>psp</name>
        <fullname>Sony PlayStation Portable</fullname>
        <path>%ROMPATH%/psp</path>
        <extension>.chd .CHD .cso .CSO .elf .ELF .iso .ISO .pbp .PBP .prx .PRX .zso .ZSO</extension>
        <command label="PPSSPP">/usr/lib/pocknix/es-psp --fullscreen %ROM%</command>
        <command label="Shortcut or script">%ENABLESHORTCUTS% %EMULATOR_OS-SHELL% %ROM%</command>
        <platform>psp</platform>
        <theme>psp</theme>
    </system>
    <system>
        <name>xbox</name>
        <fullname>Microsoft Xbox</fullname>
        <path>%ROMPATH%/xbox</path>
        <extension>.iso .ISO</extension>
        <command label="xemu">/usr/lib/pocknix/es-xemu -dvd_path %ROM%</command>
        <command label="Shortcut or script">%ENABLESHORTCUTS% %EMULATOR_OS-SHELL% %ROM%</command>
        <platform>xbox</platform>
        <theme>xbox</theme>
    </system>
    <system>
        <name>n3ds</name>
        <fullname>Nintendo 3DS</fullname>
        <path>%ROMPATH%/n3ds</path>
        <extension>.3ds .3DS .3dsx .3DSX .app .APP .axf .AXF .cci .CCI .cxi .CXI .elf .ELF</extension>
        <command label="Azahar">/usr/lib/pocknix/es-azahar %ROM%</command>
        <command label="Shortcut or script">%ENABLESHORTCUTS% %EMULATOR_OS-SHELL% %ROM%</command>
        <platform>n3ds</platform>
        <theme>n3ds</theme>
    </system>
    <system>
        <name>ps3</name>
        <fullname>Sony PlayStation 3</fullname>
        <path>%ROMPATH%/ps3</path>
        <extension>.ps3 .PS3 .ps3dir .PS3DIR .bin .BIN .elf .ELF .self .SELF</extension>
        <command label="RPCS3">/usr/lib/pocknix/es-rpcs3 --no-gui %ROM%</command>
        <command label="Shortcut or script">%ENABLESHORTCUTS% %EMULATOR_OS-SHELL% %ROM%</command>
        <platform>ps3</platform>
        <theme>ps3</theme>
    </system>
    <system>
        <name>wiiu</name>
        <fullname>Nintendo Wii U</fullname>
        <path>%ROMPATH%/wiiu</path>
        <extension>.rpx .RPX .wua .WUA .wud .WUD .wux .WUX</extension>
        <command label="Cemu">/usr/lib/pocknix/es-cemu -f -g %ROM%</command>
        <command label="Shortcut or script">%ENABLESHORTCUTS% %EMULATOR_OS-SHELL% %ROM%</command>
        <platform>wiiu</platform>
        <theme>wiiu</theme>
    </system>
    <system>
        <name>psvita</name>
        <fullname>Sony PlayStation Vita</fullname>
        <path>%ROMPATH%/psvita</path>
        <extension>.psvita .PSVITA</extension>
        <command label="Vita3K">/usr/lib/pocknix/es-vita3k -r %BASENAME%</command>
        <command label="Shortcut or script">%ENABLESHORTCUTS% %EMULATOR_OS-SHELL% %ROM%</command>
        <platform>psvita</platform>
        <theme>psvita</theme>
    </system>
</systemList>
