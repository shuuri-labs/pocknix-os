#!/bin/sh
# vhci_hcd refuses to suspend while a virtual USB device is attached ("We have N active
# connection. Do not suspend." -> -EBUSY aborts the whole system suspend), and InputPlumber's
# `deck` target attaches over USB/IP. So stop InputPlumber before sleep -- but only then: the
# desktop session's `xb360` target is plain uinput, and stopping there destroys the pad's evdev
# node for nothing (ES-DE and friends rescan only on focus change, so they come back pad-less).
STATUS=/sys/devices/platform/vhci_hcd.0/status
FLAG=/run/pocknix-inputplumber-resume

# sockfd is nonzero hex on an attached port; the hex test also skips the header row.
vhci_attached() {
  [ -r "${STATUS}" ] || return 1
  awk '$6 ~ /^[0-9a-f]+$/ && $6 != "000000" {f=1} END{exit !f}' "${STATUS}" 2>/dev/null
}

if vhci_attached && systemctl is-active --quiet inputplumber; then
  : > "${FLAG}"
  systemctl stop inputplumber
fi

# `systemctl stop` returns before the kernel has torn the port down; suspend still aborts if we
# leave now. Wait ~3s for it to drain.
i=0
while vhci_attached; do
  [ "${i}" -ge 30 ] && break
  i=$((i + 1))
  sleep 0.1
done
exit 0
