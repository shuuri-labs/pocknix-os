[Unit]
Description=Re-assert the pocknix session gamepad target
# InputPlumber always comes back on the YAML default; see pocknix-gamepad-target.
After=inputplumber.service
BindsTo=inputplumber.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/pocknix-gamepad-target --apply

[Install]
WantedBy=inputplumber.service
