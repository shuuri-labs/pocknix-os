#!/bin/bash
# pocknix-share - SMB share on/off, login as deck with deck's password. status stays
# unprivileged (the menu polls it every draw); the rest arrives via pkexec under
# 55-pocknix-share.rules.
set -euo pipefail

# smb.service alone defines the state; the Decky plugin reads its enable symlink, so consulting
# avahi here would split the two UIs whenever something else enables avahi.
SHARE_UNIT=smb.service
UNITS=(smb.service avahi-daemon.service)
# Sockets move with their services or the next connection restarts them. smb.socket does not
# exist in Arch's samba; listing it is harmless and survives it appearing.
SOCKETS=(smb.socket avahi-daemon.socket)

# valid users in smb.conf; kept in sync by hand because smb.conf ships alongside this.
SHARE_USER=deck
# Samba keeps its own password copy (Linux stores a hash Samba cannot use). This marker says one
# was set from deck's login password, readable without root for status.
PASSWORD_SET=/var/lib/pocknix/share-password-set

# pocknix-tools depends on samba; `install` stays for Pocknix Control's install button.
is_installed() { command -v smbd >/dev/null 2>&1; }

is_on() {
  [ "$(systemctl is-enabled "${SHARE_UNIT}" 2>/dev/null || true)" = enabled ] && return 0
  systemctl is-active --quiet "${SHARE_UNIT}"
}

need_root() { [ "$(id -u)" -eq 0 ] || { echo "pocknix-share: must run as root" >&2; exit 1; }; }

# One line on stdin, checked against deck's login (unix_chkpwd, as the login screen does), so the
# share password is always the account password at the time sharing was turned on.
set_password() {
  local pw
  IFS= read -r pw || true
  [ -n "${pw}" ] || { echo "pocknix-share: no password given" >&2; exit 2; }
  printf '%s\0' "${pw}" | /usr/bin/unix_chkpwd "${SHARE_USER}" nullok \
    || { echo "pocknix-share: that is not ${SHARE_USER}'s password" >&2; exit 1; }
  printf '%s\n%s\n' "${pw}" "${pw}" | smbpasswd -a -s "${SHARE_USER}" >/dev/null
  install -d /var/lib/pocknix
  : > "${PASSWORD_SET}"
}

case "${1:-status}" in
  status)
    is_installed && echo "installed=yes" || echo "installed=no"
    is_on && echo "state=on" || echo "state=off"
    [ -e "${PASSWORD_SET}" ] && echo "password=yes" || echo "password=no"
    echo "active=$(systemctl is-active smb.service 2>/dev/null || true)"
    ;;
  install)
    # Keep the install behind this program's polkit rule: a bare `pkexec pacman` lands in
    # pkexec's text agent, broken on polkit 127 (polkit#686).
    need_root
    is_installed && { echo "installed=yes"; exit 0; }
    pacman -Syu --needed --noconfirm samba
    echo "installed=yes"
    ;;
  on)
    need_root
    is_installed || { echo "pocknix-share: samba is not installed" >&2; exit 3; }
    if [ "${2:-}" = --password-stdin ]; then
      set_password
    elif [ ! -e "${PASSWORD_SET}" ]; then
      echo "pocknix-share: set the sharing password in Pocknix Tools (Network) first" >&2
      exit 1
    fi
    systemctl enable --now "${UNITS[@]}" >/dev/null
    echo "state=on"
    ;;
  off)
    need_root
    # Disable all first, then stop services before sockets, or a surviving socket restarts the
    # service on the next connection. One unit per call: systemctl aborts on an unknown unit.
    for u in "${SOCKETS[@]}" "${UNITS[@]}"; do
      systemctl disable "${u}" >/dev/null 2>&1 || true
    done
    for u in "${UNITS[@]}" "${SOCKETS[@]}"; do
      systemctl stop "${u}" >/dev/null 2>&1 || true
    done
    # a unit bounced mid-teardown lands in failed and would lie to the next status read
    systemctl reset-failed "${UNITS[@]}" >/dev/null 2>&1 || true
    echo "state=off"
    ;;
  *)
    echo "usage: pocknix-share {status|install|on [--password-stdin]|off}" >&2
    exit 2
    ;;
esac
