# PATH prefers /usr/local/bin, so a stale overlay copy would shadow the packaged
# fix on pre-package devices (#34). No-op on fresh images.
_prune_overlay_tools() {
  rm -f /usr/local/bin/pocknix-installer-gui \
        /usr/local/bin/pocknix-install-internal \
        /usr/local/bin/pocknix-uninstall-internal \
        /usr/share/applications/pocknix-installer.desktop
}

post_install() {
  _prune_overlay_tools
}

post_upgrade() {
  _prune_overlay_tools
}
