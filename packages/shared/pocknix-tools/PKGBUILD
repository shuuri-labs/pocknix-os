# pocknix-tools - the Pocknix Tools app (QML on pocknix-ui). It also ships the internal-install CLIs,
# which live here rather than in the image overlay so fixes reach fielded SDs on -Syu (#34).
pkgname=pocknix-tools
pkgver=0.1.0
pkgrel=23
pkgdesc="Pocknix Tools: updates, snapshot rollback, SSH + file sharing, desktop picker, internal install"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL-2.0-or-later')
depends=('pocknix-ui' 'pocknix-snapshots' 'pocknix-base')
install=pocknix-tools.install
source=('pocknix-tools' 'pocknix-tools.desktop' 'pocknix-tools-run' '58-pocknix-tools-run.rules'
        'pocknix-install-internal' 'pocknix-uninstall-internal' '54-pocknix-installer.rules'
        'pocknix-internal-boot-rename' 'pocknix-internal-boot-rename.service'
        'pocknix-ssh' '53-pocknix-ssh.rules' '10-pocknix-no-root-login.conf'
        'pocknix-share' '55-pocknix-share.rules' 'smb.conf' 'pocknix-smb.service'
        'pocknix-layer' '56-pocknix-layer.rules')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')
backup=('etc/ssh/sshd_config.d/10-pocknix-no-root-login.conf'
        'etc/samba/smb.conf')

package() {
  install -Dm755 "${srcdir}/pocknix-tools" "${pkgdir}/usr/bin/pocknix-tools"
  install -Dm644 -t "${pkgdir}/usr/share/pocknix-tools/qml" "${startdir}"/qml/*.qml
  install -Dm644 -t "${pkgdir}/usr/share/pocknix/tiles" "${startdir}"/tiles/*.conf
  install -Dm755 "${srcdir}/pocknix-tools-run" "${pkgdir}/usr/bin/pocknix-tools-run"
  install -Dm644 "${srcdir}/58-pocknix-tools-run.rules" \
    "${pkgdir}/usr/share/polkit-1/rules.d/58-pocknix-tools-run.rules"
  install -Dm755 "${srcdir}/pocknix-install-internal" "${pkgdir}/usr/bin/pocknix-install-internal"
  install -Dm755 "${srcdir}/pocknix-uninstall-internal" "${pkgdir}/usr/bin/pocknix-uninstall-internal"
  # ROCKNIX->POCKNIX boot-partition migration, statically enabled via wants symlink
  install -Dm755 "${srcdir}/pocknix-internal-boot-rename" "${pkgdir}/usr/bin/pocknix-internal-boot-rename"
  install -Dm644 "${srcdir}/pocknix-internal-boot-rename.service" \
    "${pkgdir}/usr/lib/systemd/system/pocknix-internal-boot-rename.service"
  install -d "${pkgdir}/usr/lib/systemd/system/local-fs.target.wants"
  ln -s ../pocknix-internal-boot-rename.service \
    "${pkgdir}/usr/lib/systemd/system/local-fs.target.wants/pocknix-internal-boot-rename.service"
  install -Dm644 "${srcdir}/54-pocknix-installer.rules" \
    "${pkgdir}/usr/share/polkit-1/rules.d/54-pocknix-installer.rules"
  install -Dm755 "${srcdir}/pocknix-ssh" "${pkgdir}/usr/bin/pocknix-ssh"
  install -Dm644 "${srcdir}/pocknix-tools.desktop" \
    "${pkgdir}/usr/share/applications/pocknix-tools.desktop"
  install -Dm644 "${srcdir}/53-pocknix-ssh.rules" \
    "${pkgdir}/usr/share/polkit-1/rules.d/53-pocknix-ssh.rules"
  install -Dm644 "${srcdir}/10-pocknix-no-root-login.conf" \
    "${pkgdir}/etc/ssh/sshd_config.d/10-pocknix-no-root-login.conf"

  install -Dm755 "${srcdir}/pocknix-share" "${pkgdir}/usr/bin/pocknix-share"
  install -Dm644 "${srcdir}/55-pocknix-share.rules" \
    "${pkgdir}/usr/share/polkit-1/rules.d/55-pocknix-share.rules"
  # samba ships no default smb.conf (only empty /etc/samba), so this is the whole config
  install -Dm644 "${srcdir}/smb.conf" "${pkgdir}/etc/samba/smb.conf"
  install -Dm644 "${srcdir}/pocknix-smb.service" \
    "${pkgdir}/etc/avahi/services/pocknix-smb.service"

  install -Dm755 "${srcdir}/pocknix-layer" "${pkgdir}/usr/bin/pocknix-layer"
  install -Dm644 "${srcdir}/56-pocknix-layer.rules" \
    "${pkgdir}/usr/share/polkit-1/rules.d/56-pocknix-layer.rules"
}
