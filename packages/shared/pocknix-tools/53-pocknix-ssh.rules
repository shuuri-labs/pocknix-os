// wheel may pkexec pocknix-ssh without a prompt (same trust as
// 50-pocknix-deck.rules). The GUI does the warning before it turns SSH on.
polkit.addRule(function(action, subject) {
    if (!subject.isInGroup("wheel")) { return; }
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/bin/pocknix-ssh") {
        return polkit.Result.YES;
    }
});
