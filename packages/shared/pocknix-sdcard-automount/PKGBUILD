# pocknix-sdcard-automount — the userspace half of SteamOS-style microSD support: a udev rule,
# the mount helper that registers the card with the running Steam client, and the Storage-UI
# formatter. The kernel half is CONFIG_UNICODE (in scripts/build-kernel.sh): without it the
# kernel refuses to mount a SteamOS-formatted card, which carries the ext4 `casefold` feature.
pkgname=pocknix-sdcard-automount
pkgver=0.1.0
pkgrel=7
pkgdesc="SteamOS-style microSD automount + format + Steam library registration for the gamescope session"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL2')
depends=('jq' 'util-linux' 'systemd' 'parted' 'e2fsprogs')
source=('sdcard-mount.sh' 'format-device.sh' '99-pocknix-sdcard-automount.rules')
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 "${srcdir}/sdcard-mount.sh" "${pkgdir}/usr/lib/hwsupport/sdcard-mount.sh"
  # pkexec'd by the steamos-format-device shim in pocknix-steamos-shim.
  install -Dm755 "${srcdir}/format-device.sh" "${pkgdir}/usr/lib/hwsupport/format-device.sh"
  install -Dm644 "${srcdir}/99-pocknix-sdcard-automount.rules" \
    "${pkgdir}/usr/lib/udev/rules.d/99-pocknix-sdcard-automount.rules"
}
