# cemu — Wii U emulator, vendored from upstream's aarch64 AppImage CI build of a pinned main
# commit: releases are x86-only and the AArch64 recompiler exists only on main. CI artifacts
# expire, so the AppImage is fetched from our mirror (provenance in README.provenance). Bump =
# a newer main commit's cemu-appimage-arm, mirrored, with pkgver <last release>.<commit date>.<short sha>.
pkgname=cemu
_sha=3b10316
pkgver=2.6.20261104.${_sha}
pkgrel=1
pkgdesc="Cemu — Wii U emulator, upstream aarch64 AppImage with the ARM64 recompiler (vendored)"
arch=('aarch64')
url="https://cemu.info"
license=('MPL2')
depends=('fuse2')
options=('!strip')   # AppImage = ELF runtime + squashfs payload; strip would corrupt it
_asset=Cemu-${_sha}-aarch64.AppImage
source=("https://pocknix.shuuri.net/mirror/${_asset}"
        'Cemu.desktop')
sha512sums=('612a4236c370c2b09744b678c241bc3aefc280b0d1dbba28ccf6b682315855244fa7b5a8881e70207ddafc0b0e6c7a485f0dddd6c2e37c27ca68479c4d682283'
            'SKIP')
noextract=("${_asset}")

prepare() {
  # --appimage-extract needs no FUSE, so the icon can be pulled in the build chroot.
  cd "${srcdir}"
  chmod u+x "${_asset}"
  rm -rf squashfs-root
  "./${_asset}" --appimage-extract 'usr/share/icons/hicolor/128x128/apps/info.cemu.Cemu.png' >/dev/null
  # fail the build if the icon vanished upstream
  [ -s squashfs-root/usr/share/icons/hicolor/128x128/apps/info.cemu.Cemu.png ]
}

package() {
  # Path is fixed: emu-resolve.sh and es_find_rules.xml both hardcode it.
  install -Dm755 "${srcdir}/${_asset}" "${pkgdir}/opt/pocknix/emulators/cemu/Cemu.AppImage"
  # Same icon name and desktop ID as the source build: existing Steam tiles and menu
  # favourites reference them, and an upgrade never rewrites either.
  install -Dm644 "${srcdir}/squashfs-root/usr/share/icons/hicolor/128x128/apps/info.cemu.Cemu.png" \
    "${pkgdir}/usr/share/icons/hicolor/128x128/apps/info.cemu.Cemu.png"
  install -Dm644 "${srcdir}/Cemu.desktop" "${pkgdir}/usr/share/applications/Cemu.desktop"
}
