# Enabled at image time with `systemctl --global enable`, not by the package: it is a --user
# unit and there is no user to enable it for at install time.
[Unit]
Description=pocknix: create ~/ROMs tree and seed emulator configs on first login
After=graphical-session-pre.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/pocknix-roms-init
RemainAfterExit=yes

[Install]
WantedBy=default.target
