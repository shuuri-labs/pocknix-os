#!/bin/bash
# pocknix-roms-init — first-login setup for the emulation layer, run as 'deck' by
# pocknix-roms-init.service. Builds the ~/Emulation drop tree and seeds emulator configs.
# A pacman package cannot write /home/deck at install time, hence staging under
# /usr/share/pocknix-emulation and copying here. Every seed is skipped if the user already
# has one; every step is guarded so a failure never fails the login.
set -u

SHARE=/usr/share/pocknix-emulation
EMU="${HOME}/Emulation"

# Seed files are authored with the 120Hz values; the substitutions below adapt them to 60Hz
# panels. Fallback 120 = pass the authored values through unchanged.
[ -r /usr/lib/pocknix/device.conf ] && . /usr/lib/pocknix/device.conf
[ -r /etc/pocknix/device.conf ] && . /etc/pocknix/device.conf
REFRESH="${POCKNIX_PANEL_REFRESH:-120}"
# ES-DE's ROMDirectory setting is the single source of truth for where ROMs live (the user can
# repoint it at an SD card); this skeleton and pocknix-steam-sync both follow it. Empty/absent
# means ES-DE's own default ~/ROMs. The settings file is a rootless XML fragment, hence sed.
ESDE_SETTINGS="${HOME}/ES-DE/settings/es_settings.xml"
_roms_setting="$(sed -n 's/.*name="ROMDirectory" value="\([^"]*\)".*/\1/p' "${ESDE_SETTINGS}" 2>/dev/null | head -1)"
case "${_roms_setting}" in "~"*) _roms_setting="${HOME}${_roms_setting#\~}" ;; esac
if [ -n "${_roms_setting}" ]; then
  ROMS="${_roms_setting}"
elif [ -f "${ESDE_SETTINGS}" ]; then
  ROMS="${HOME}/ROMs"          # settings exist but no/empty ROMDirectory = ES-DE default
else
  ROMS="${EMU}/ROMs"           # fresh install: the seed below points ES-DE here
fi

# ES-DE's own default folder names — creating one only gives the user a labelled drop point;
# ES-DE still shows a system only once it is populated.
SYSTEMS=(
  nes snes n64 gb gbc gba nds n3ds
  genesis megadrive mastersystem gamegear segacd saturn dreamcast
  tg16 pcengine neogeo arcade mame
  atari2600 atari7800 atarilynx atarijaguar wonderswan
  psx ps2 ps3 psp psvita
  gc wii wiiu switch xbox
)

mkdir -p "${EMU}/BIOS" "${EMU}/Saves" "${EMU}/States"
for s in "${SYSTEMS[@]}"; do mkdir -p "${ROMS}/${s}"; done

# Refreshed every run (not seed-once) so doc updates reach existing installs.
if [ -f "${SHARE}/ROMS-README.txt" ]; then
  cp -f "${SHARE}/ROMS-README.txt" "${EMU}/README.txt" 2>/dev/null || true
fi

# Seeded only before ES-DE's first run; after that ES-DE's own setting is authoritative.
if [ ! -f "${ESDE_SETTINGS}" ]; then
  mkdir -p "${HOME}/ES-DE/settings"
  printf '<?xml version="1.0"?>\n<string name="ROMDirectory" value="%s" />\n' "${ROMS}" > "${ESDE_SETTINGS}" 2>/dev/null || true
fi

ESDE_CUSTOM="${HOME}/ES-DE/custom_systems"
if [ -f "${SHARE}/es_find_rules.xml" ] && [ ! -f "${ESDE_CUSTOM}/es_find_rules.xml" ]; then
  mkdir -p "${ESDE_CUSTOM}"
  cp "${SHARE}/es_find_rules.xml" "${ESDE_CUSTOM}/es_find_rules.xml" 2>/dev/null || true
fi

if [ -f "${SHARE}/es_systems.xml" ] && [ ! -f "${ESDE_CUSTOM}/es_systems.xml" ]; then
  mkdir -p "${ESDE_CUSTOM}"
  cp "${SHARE}/es_systems.xml" "${ESDE_CUSTOM}/es_systems.xml" 2>/dev/null || true
fi

# ARMSX2 moved from PCSX2's stock ~/.config/PCSX2 to ~/.config/ARMSX2 (same tree layout inside).
# The migration copy must precede the seed check, or an upgraded device gets a fresh seed, the
# setup wizard, and orphaned memcards/savestates.
if [ -f "${HOME}/.config/PCSX2/inis/PCSX2.ini" ] && [ ! -f "${HOME}/.config/ARMSX2/inis/PCSX2.ini" ]; then
  mkdir -p "${HOME}/.config/ARMSX2"
  cp -a "${HOME}/.config/PCSX2/." "${HOME}/.config/ARMSX2/" 2>/dev/null || true
fi
if [ -f "${SHARE}/armsx2-PCSX2.ini.in" ] && [ ! -f "${HOME}/.config/ARMSX2/inis/PCSX2.ini" ]; then
  mkdir -p "${HOME}/.config/ARMSX2/inis"
  sed "s|__HOME__|${HOME}|g" "${SHARE}/armsx2-PCSX2.ini.in" > "${HOME}/.config/ARMSX2/inis/PCSX2.ini" 2>/dev/null || true
fi

# --- seed Eden (Switch) config: pad bindings + per-device vsync + 1x resolution ---
# Eden ships no pad bindings (dead controller otherwise). vsync is per-device: Mailbox (1) on
# 120Hz panels, FIFO (2) on 60Hz ones, where Mailbox is bouncy. resolution_setup=2 (1x) overrides
# Eden's 1.5x default: 1620p internal render pegs the GPU and slips frames, and docked 1x already
# matches the 1080p panels. Partial seed (Eden fills the
# rest with its defaults on first run). Never clobbers an existing config.
if [ -f "${SHARE}/eden-qt-config.ini.in" ] && [ ! -f "${HOME}/.config/eden/qt-config.ini" ]; then
  mkdir -p "${HOME}/.config/eden"
  _vs=2; [ "${REFRESH}" -ge 120 ] 2>/dev/null && _vs=1
  sed "s/^use_vsync=.*/use_vsync=${_vs}/" "${SHARE}/eden-qt-config.ini.in" \
    > "${HOME}/.config/eden/qt-config.ini" 2>/dev/null || true
fi

# --- seed Dolphin (GameCube/Wii) config: Vulkan + pad bindings + no blocking dialogs ---
# Dolphin ships keyboard-only pad bindings (dead controller) and pops two modals unreachable in
# game mode (analytics consent, confirm-stop). Never clobbers an existing config.
if [ -f "${SHARE}/dolphin-Dolphin.ini.in" ] && [ ! -f "${HOME}/.config/dolphin-emu/Dolphin.ini" ]; then
  mkdir -p "${HOME}/.config/dolphin-emu"
  cp "${SHARE}/dolphin-Dolphin.ini.in"   "${HOME}/.config/dolphin-emu/Dolphin.ini"   2>/dev/null || true
  cp "${SHARE}/dolphin-GFX.ini.in"       "${HOME}/.config/dolphin-emu/GFX.ini"       2>/dev/null || true
  cp "${SHARE}/dolphin-GCPadNew.ini.in"  "${HOME}/.config/dolphin-emu/GCPadNew.ini"  2>/dev/null || true
fi

# --- seed Cemu (Wii U) config: game path, fullscreen, no update nag ---
# Also skips Cemu's onboarding wizard, which runs only when settings.xml is absent (CemuApp
# isFirstStart). The controller profile is session-dependent, so pocknix-cemu-profile writes
# that one at launch.
if [ -f "${SHARE}/cemu-settings.xml.in" ] && [ ! -f "${HOME}/.config/Cemu/settings.xml" ]; then
  mkdir -p "${HOME}/.config/Cemu"
  sed "s|__ROMS__|${ROMS}|g" "${SHARE}/cemu-settings.xml.in" \
    > "${HOME}/.config/Cemu/settings.xml" 2>/dev/null || true
fi

# --- seed PPSSPP (PSP) config: 4x internal resolution ---
# PSP native is 480x272; 4x = 1920x1088, matching the 1080p panels. PPSSPP's "auto"
# default scales with the window, which lands inconsistently on the rotated panels.
# Partial seed (PPSSPP fills the rest with defaults). Never clobbers an existing config.
if [ -f "${SHARE}/ppsspp.ini.in" ] && [ ! -f "${HOME}/.config/ppsspp/PSP/SYSTEM/ppsspp.ini" ]; then
  mkdir -p "${HOME}/.config/ppsspp/PSP/SYSTEM"
  cp "${SHARE}/ppsspp.ini.in" "${HOME}/.config/ppsspp/PSP/SYSTEM/ppsspp.ini" 2>/dev/null || true
fi

# --- seed RetroArch joypad autoconfig profiles (only what's missing) ---
# From retroarch-autoconfig-pocknix (/usr/share/libretro/autoconfig). Copied (not symlinked) into
# RetroArch's default, WRITABLE autoconfig dir so user-saved custom profiles coexist. Without
# these, RetroArch sees Steam Input's virtual X360 pad but has no bindings: controls fully dead.
# -n = never clobber a user-customized profile.
RA_AUTOCFG_SRC=/usr/share/libretro/autoconfig/udev
RA_AUTOCFG_DST="${HOME}/.config/retroarch/autoconfig/udev"
if [ -d "${RA_AUTOCFG_SRC}" ]; then
  mkdir -p "${RA_AUTOCFG_DST}"
  cp -n "${RA_AUTOCFG_SRC}/"*.cfg "${RA_AUTOCFG_DST}/" 2>/dev/null || true
fi

# --- link the vendored slang shader set into RetroArch's shader dir ---
# From retroarch-shaders-pocknix. Symlink (not copy — 79 MB): the shader dir itself stays the
# writable user default so preset saving keeps working; presets reference shaders relative to the
# shader dir and resolve through the link. Skipped if the user already has a real shaders_slang
# (e.g. downloaded via Online Updater before this package existed).
RA_SHADERS_SRC=/usr/share/libretro/shaders/shaders_slang
RA_SHADERS_DST="${HOME}/.config/retroarch/shaders/shaders_slang"
if [ -d "${RA_SHADERS_SRC}" ] && [ ! -e "${RA_SHADERS_DST}" ]; then
  mkdir -p "${HOME}/.config/retroarch/shaders"
  ln -s "${RA_SHADERS_SRC}" "${RA_SHADERS_DST}" 2>/dev/null || true
fi

# --- seed per-system RetroArch tuning (content-dir overrides + shader presets) ---
# From /usr/share/pocknix-emulation/retroarch-config (e.g. mGBA/gba.cfg = integer scaling,
# mGBA/gba.slangp = lcd3x). cp -Rn: a user's own saved overrides/presets are never clobbered.
RA_CONF_SRC=/usr/share/pocknix-emulation/retroarch-config
RA_CONF_DST="${HOME}/.config/retroarch/config"
if [ -d "${RA_CONF_SRC}" ]; then
  mkdir -p "${RA_CONF_DST}"
  cp -Rn "${RA_CONF_SRC}/." "${RA_CONF_DST}/" 2>/dev/null || true
fi

# --- seed RetroArch defaults (only if the user has no retroarch.cfg) ---
# system_directory -> ~/ROMs/bios etc. RetroArch expands any missing keys itself on first run, so a
# minimal seed is fine; if the user already has a config we leave it entirely alone.
RA_CFG="${HOME}/.config/retroarch/retroarch.cfg"
# refresh/swap-interval are per-device: the seed's authored values (120Hz, interval 2 =
# present-every-2nd-vblank) are right ONLY for 120Hz panels; on a 60Hz panel interval 2 paces
# at 30fps. Substitute from POCKNIX_PANEL_REFRESH: 60Hz -> 60/1, 120Hz -> 120/2.
if [ -f "${SHARE}/retroarch.cfg" ] && [ ! -f "${RA_CFG}" ]; then
  mkdir -p "${HOME}/.config/retroarch"
  _si=$(( REFRESH / 60 )); [ "${_si}" -lt 1 ] && _si=1
  sed -e "s/^video_refresh_rate = .*/video_refresh_rate = \"${REFRESH}.000000\"/" \
      -e "s/^video_swap_interval = .*/video_swap_interval = \"${_si}\"/" \
      "${SHARE}/retroarch.cfg" > "${RA_CFG}" 2>/dev/null || true
fi

exit 0
