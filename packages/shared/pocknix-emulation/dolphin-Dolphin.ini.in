# Dolphin core config seed (-> ~/.config/dolphin-emu/Dolphin.ini). The confirm-stop dialog and
# the analytics prompt are pre-answered: both are blocking modals with no way out in game mode.
[Core]
GFXBackend = Vulkan
[Display]
Fullscreen = True
[Interface]
ConfirmStop = False
[Analytics]
Enabled = False
PermissionAsked = True
