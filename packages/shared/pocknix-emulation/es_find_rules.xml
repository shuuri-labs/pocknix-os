<?xml version="1.0"?>
<!--
  pocknix ES-DE emulator find-rules, seeded to ~/ES-DE/custom_systems/ by pocknix-roms-init.
  This does NOT redefine systems: it only tells ES-DE where our binaries live so the bundled
  launch commands resolve. Each staticpath lists the AppImage and a /usr/bin fallback, first
  match wins. PS2 rides the stock "PCSX2" emulator name to reach ARMSX2.
-->
<ruleList>

  <!-- The bundled rule is systempath-only, and that PATH lookup comes up empty under the
       Steam-launched ES-DE environment: every RetroArch system then fails to find an
       emulator. The absolute path is what makes it resolve. -->
  <emulator name="RETROARCH">
    <rule type="systempath">
      <entry>retroarch</entry>
    </rule>
    <rule type="staticpath">
      <entry>/usr/bin/retroarch</entry>
    </rule>
  </emulator>

  <!-- GameCube / Wii -->
  <emulator name="DOLPHIN">
    <rule type="staticpath">
      <entry>/opt/pocknix/emulators/dolphin/dolphin-emu.AppImage</entry>
      <entry>/usr/bin/dolphin-emu</entry>
    </rule>
  </emulator>

  <!-- PS2 -> ARMSX2, via the stock PCSX2 name. First entry is the big-core pin wrapper. -->
  <emulator name="PCSX2">
    <rule type="staticpath">
      <entry>/usr/lib/pocknix/es-armsx2</entry>
      <entry>/opt/pocknix/emulators/armsx2/ARMSX2.AppImage</entry>
      <entry>/usr/bin/armsx2</entry>
    </rule>
  </emulator>

  <!-- PS3 -->
  <emulator name="RPCS3">
    <rule type="staticpath">
      <entry>/opt/pocknix/emulators/rpcs3/rpcs3.AppImage</entry>
      <entry>/usr/bin/rpcs3</entry>
    </rule>
  </emulator>

  <!-- PSP -->
  <emulator name="PPSSPP">
    <rule type="staticpath">
      <entry>/usr/bin/ppsspp</entry>
      <entry>/usr/bin/PPSSPPSDL</entry>
    </rule>
  </emulator>

  <!-- PS Vita -->
  <emulator name="VITA3K">
    <rule type="staticpath">
      <entry>/opt/pocknix/emulators/vita3k/Vita3K.AppImage</entry>
      <entry>/usr/bin/Vita3K</entry>
    </rule>
  </emulator>

  <!-- Wii U -->
  <emulator name="CEMU">
    <rule type="staticpath">
      <entry>/usr/bin/Cemu</entry>
    </rule>
  </emulator>

  <!-- 3DS -->
  <emulator name="AZAHAR">
    <rule type="staticpath">
      <entry>/usr/bin/azahar</entry>
    </rule>
  </emulator>

  <!-- Original Xbox -->
  <emulator name="XEMU">
    <rule type="staticpath">
      <entry>/opt/pocknix/emulators/xemu/xemu.AppImage</entry>
      <entry>/usr/bin/xemu</entry>
    </rule>
  </emulator>

  <!-- Switch. First entry is the big-core pin wrapper. -->
  <emulator name="EDEN">
    <rule type="staticpath">
      <entry>/usr/lib/pocknix/es-eden</entry>
      <entry>/opt/pocknix/emulators/eden/Eden.AppImage</entry>
    </rule>
  </emulator>

</ruleList>
