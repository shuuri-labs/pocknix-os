#!/bin/bash
# ES-DE launch wrapper for azahar: big-core taskset pin, mirroring es-armsx2.
# AppImage emulators also need this as their bridge into ES-DE (not in PATH).
[ -r /usr/lib/pocknix/device.conf ] && . /usr/lib/pocknix/device.conf
[ -r /etc/pocknix/device.conf ] && . /etc/pocknix/device.conf
exec taskset -c "${POCKNIX_BIG_CORES:-3-7}" /usr/bin/azahar "$@"
