# pocknix-emulation — the "drop ROMs in and play" layer: ES-DE + preconfigured emulator
# configs, shipped as an arch=any data/scripts package.
pkgname=pocknix-emulation
pkgver=0.1.0
pkgrel=14
pkgdesc="ES-DE + preconfigured emulators for the RP6: drop ROMs into ~/Emulation and play; star -> Steam"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL2')
# depends() stays 'bash': the emulator runtime ships via config/packages/emulation.list so
# makepkg -s does not drag ES-DE/RetroArch/Qt into the build chroot for this data package.
# The scripts `command -v`-guard their callees, so a runtime-less install degrades gracefully.
depends=('bash')
source=('pocknix-roms-init' 'pocknix-roms-init.service' 'pocknix-steam-sync' 'pocknix-play'
        'es-eden' 'es-armsx2' 'es-dolphin' 'es-psp' 'es-xemu'
        'es-azahar' 'es-rpcs3' 'es-cemu' 'es-vita3k'
        'es_find_rules.xml' 'es_systems.xml' 'retroarch.cfg' 'ROMS-README.txt' 'armsx2-PCSX2.ini.in'
        'eden-qt-config.ini.in' 'ppsspp.ini.in'
        'pocknix-cemu-profile' 'cemu-settings.xml.in' 'cemu-controller0.xml.in'
        'dolphin-Dolphin.ini.in' 'dolphin-GFX.ini.in' 'dolphin-GCPadNew.ini.in'
        # FLAT names: makepkg cannot retrieve local sources from subdirectory paths, so
        # package() maps retroarch-<Core>-<file> back into the retroarch-config/<Core>/ tree.
        'retroarch-mGBA-gba.cfg' 'retroarch-mGBA-gba.slangp')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 "${srcdir}/pocknix-roms-init" "${pkgdir}/usr/bin/pocknix-roms-init"
  install -Dm755 "${srcdir}/pocknix-play"      "${pkgdir}/usr/bin/pocknix-play"
  install -Dm755 "${srcdir}/pocknix-steam-sync" "${pkgdir}/usr/bin/pocknix-steam-sync"

  install -Dm755 "${srcdir}/es-eden"    "${pkgdir}/usr/lib/pocknix/es-eden"
  install -Dm755 "${srcdir}/es-armsx2"  "${pkgdir}/usr/lib/pocknix/es-armsx2"
  install -Dm755 "${srcdir}/es-psp"     "${pkgdir}/usr/lib/pocknix/es-psp"
  install -Dm755 "${srcdir}/es-xemu"    "${pkgdir}/usr/lib/pocknix/es-xemu"
  install -Dm755 "${srcdir}/es-azahar"  "${pkgdir}/usr/lib/pocknix/es-azahar"
  install -Dm755 "${srcdir}/es-rpcs3"   "${pkgdir}/usr/lib/pocknix/es-rpcs3"
  install -Dm755 "${srcdir}/es-cemu"    "${pkgdir}/usr/lib/pocknix/es-cemu"
  install -Dm755 "${srcdir}/es-vita3k"  "${pkgdir}/usr/lib/pocknix/es-vita3k"
  install -Dm755 "${srcdir}/es-dolphin" "${pkgdir}/usr/lib/pocknix/es-dolphin"

  install -Dm644 "${srcdir}/pocknix-roms-init.service" \
    "${pkgdir}/usr/lib/systemd/user/pocknix-roms-init.service"

  install -Dm644 "${srcdir}/es_find_rules.xml" \
    "${pkgdir}/usr/share/pocknix-emulation/es_find_rules.xml"
  install -Dm644 "${srcdir}/es_systems.xml" \
    "${pkgdir}/usr/share/pocknix-emulation/es_systems.xml"
  install -Dm644 "${srcdir}/retroarch.cfg" \
    "${pkgdir}/usr/share/pocknix-emulation/retroarch.cfg"
  install -Dm644 "${srcdir}/ROMS-README.txt" \
    "${pkgdir}/usr/share/pocknix-emulation/ROMS-README.txt"
  install -Dm644 "${srcdir}/armsx2-PCSX2.ini.in" \
    "${pkgdir}/usr/share/pocknix-emulation/armsx2-PCSX2.ini.in"
  install -Dm644 "${srcdir}/eden-qt-config.ini.in" \
    "${pkgdir}/usr/share/pocknix-emulation/eden-qt-config.ini.in"
  install -Dm644 "${srcdir}/ppsspp.ini.in" \
    "${pkgdir}/usr/share/pocknix-emulation/ppsspp.ini.in"
  install -Dm755 "${srcdir}/pocknix-cemu-profile" "${pkgdir}/usr/lib/pocknix/pocknix-cemu-profile"
  install -Dm644 "${srcdir}/cemu-settings.xml.in" \
    "${pkgdir}/usr/share/pocknix-emulation/cemu-settings.xml.in"
  install -Dm644 "${srcdir}/cemu-controller0.xml.in" \
    "${pkgdir}/usr/share/pocknix-emulation/cemu-controller0.xml.in"
  install -Dm644 "${srcdir}/dolphin-Dolphin.ini.in" \
    "${pkgdir}/usr/share/pocknix-emulation/dolphin-Dolphin.ini.in"
  install -Dm644 "${srcdir}/dolphin-GFX.ini.in" \
    "${pkgdir}/usr/share/pocknix-emulation/dolphin-GFX.ini.in"
  install -Dm644 "${srcdir}/dolphin-GCPadNew.ini.in" \
    "${pkgdir}/usr/share/pocknix-emulation/dolphin-GCPadNew.ini.in"
  install -Dm644 "${srcdir}/retroarch-mGBA-gba.cfg"    "${pkgdir}/usr/share/pocknix-emulation/retroarch-config/mGBA/gba.cfg"
  install -Dm644 "${srcdir}/retroarch-mGBA-gba.slangp" "${pkgdir}/usr/share/pocknix-emulation/retroarch-config/mGBA/gba.slangp"
}
