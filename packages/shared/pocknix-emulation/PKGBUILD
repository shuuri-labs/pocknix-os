# pocknix-emulation - the emulation layer under the name it shipped as before the split: an
# empty package whose only dep is the layer meta. Kept for good: devices and rollback snapshots
# that still carry this name reach every pocknix-emu-* package through it, and the meta stays
# required here instead of turning into an orphan that `pacman -Rns $(pacman -Qdtq)` strips.
pkgname=pocknix-emulation
pkgver=0.1.0
pkgrel=23
pkgdesc="pocknix emulation layer (old name, pulls in pocknix-emulation-full)"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL-2.0-or-later')
depends=('pocknix-emulation-full')

package() {
  :   # pure metapackage
}
