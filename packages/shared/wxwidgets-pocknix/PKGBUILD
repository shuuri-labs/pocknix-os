# wxwidgets-pocknix — wxWidgets 3.3 (gtk3), existing solely because cemu needs >=3.3 and ALARM
# ships 3.2. The name plus provides/conflicts is the resolution trick: ALARM's 3.2 cannot satisfy
# cemu's 'wxwidgets-gtk3>=3.3', so pacman falls through to this provider. A same-name epoch bump
# would NOT work: unqualified `pacman -S <name>` takes the first repo with the name, [pocknix] is last.
pkgname=wxwidgets-pocknix
pkgver=3.3.2
pkgrel=2
pkgdesc="wxWidgets 3.3 (gtk3, lean: no webview/media) — required by cemu, ALARM only has 3.2"
arch=('aarch64')
url="https://wxwidgets.org"
license=('custom:wxWindows')
provides=("wxwidgets-common=${pkgver}" "wxwidgets-gtk3=${pkgver}")
conflicts=('wxwidgets-common' 'wxwidgets-gtk3')
depends=('gtk3' 'libjpeg-turbo' 'libpng' 'libtiff' 'xz' 'expat' 'zlib' 'libnotify' 'libsm' 'glu')
makedepends=('cmake' 'git' 'ninja')
source=("wxWidgets::git+https://github.com/wxWidgets/wxWidgets#tag=v${pkgver}")
sha256sums=('SKIP')

prepare() {
  cd wxWidgets
  git submodule update --init --recursive
}

build() {
  cmake -B build -S wxWidgets -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DwxBUILD_TOOLKIT=gtk3 \
    -DwxUSE_OPENGL=ON \
    -DwxUSE_WEBVIEW=OFF \
    -DwxUSE_MEDIACTRL=OFF \
    -DwxUSE_ZLIB=sys \
    -DwxUSE_EXPAT=sys \
    -DwxUSE_LIBJPEG=sys \
    -DwxUSE_LIBPNG=sys \
    -DwxUSE_LIBTIFF=sys \
    -DwxUSE_LIBLZMA=sys \
    -DwxUSE_PRIVATE_FONTS=ON \
    -DwxUSE_GTKPRINT=ON
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm644 wxWidgets/docs/licence.txt "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
