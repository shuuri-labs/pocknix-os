# pocknix-emu-azahar - pocknix glue for Azahar (3DS): its ES-DE launch wrapper.
# Build with ./nodeps: makepkg -s would install the emulator into the build chroot.
pkgname=pocknix-emu-azahar
pkgver=0.1.0
pkgrel=1
pkgdesc="pocknix setup for Azahar (3DS): ES-DE wiring and preconfigured defaults"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL-2.0-or-later')
depends=('pocknix-emulation-common' 'azahar')
source=('es-azahar')
sha256sums=('SKIP')

package() {
  install -Dm755 "${srcdir}/es-azahar" "${pkgdir}/usr/lib/pocknix/es-azahar"
}
