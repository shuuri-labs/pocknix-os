# depends= IS the manifest: pacman never installs a new name on its own (#49). Optional
# layers stay out, or `pacman -Rs <layer>` becomes impossible.
pkgname=pocknix-core
pkgver=0.1.0
pkgrel=4
pkgdesc="pocknix mandatory layer: GPU stack, input, storage, base/update tooling"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL2')
depends=('mesa'                     # epoch-2 trimmed/tuned freedreno build ([pocknix] outranks ALARM)
         'vulkan-freedreno'
         'inputplumber'             # BSP device configs target it
         'pocknix-sdcard-automount'
         'pocknix-snapshots'
         'pocknix-base'
         'pocknix-base-lock'
         'pocknix-lock-migrate'
         'pocknix-tools'
         'pocknix-branding'         # plymouthd.conf names its theme on every device
         'pocknix-session')

package() {
  :
}
