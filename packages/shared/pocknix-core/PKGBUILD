# pocknix-core — the mandatory layer on every device. Its depends= IS the manifest:
# pacman never installs a new package NAME on its own (#49), so a line here is what
# reaches fielded devices on -Syu. Optional layers (pocknix-*-full) stay out: a hard
# edge from core would make `pacman -Rs <layer>` impossible.
pkgname=pocknix-core
pkgver=0.1.0
pkgrel=3
pkgdesc="pocknix mandatory layer: GPU stack, input, storage, base/update tooling"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL2')
depends=('mesa'                     # epoch-2 trimmed/tuned freedreno build ([pocknix] outranks ALARM)
         'vulkan-freedreno'
         'inputplumber'             # gamepad -> Steam Input; BSP device configs target it
         'pocknix-sdcard-automount'
         'pocknix-snapshots'
         'pocknix-base'
         'pocknix-base-lock'
         'pocknix-lock-migrate'
         'pocknix-tools'
         'pocknix-branding')   # plymouthd.conf names its theme on every device

package() {
  :   # pure metapackage
}
