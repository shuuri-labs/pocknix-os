# pocknix-desktop-full — the Plasma Mobile desktop-session layer. Hard depends= so that
# `pacman -Rs pocknix-desktop-full` removes exactly this layer and nothing else.
# Build with ./nodeps: makepkg -s would drag the whole KDE/Qt stack in to lay out nothing.
pkgname=pocknix-desktop-full
pkgver=0.1.0
pkgrel=2
pkgdesc="pocknix optional layer: Plasma Mobile desktop session, KDE apps, Waydroid, Flatpak"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL2')
depends=('pocknix-desktop'
         'plasma-mobile'
         'plasma-workspace'
         'kwin'
         'plasma-nano'
         'plasma-nm'
         'powerdevil'
         'plasma-settings'
         'kscreen'           # kscreen-doctor drives the rotated-DSI transform
         'xdg-user-dirs'
         'konsole'
         'kate'
         'dolphin'
         'kcalc'
         'ark'
         'unrar'
         'gwenview'
         'okular'
         'koko'
         'kclock'
         'kweather'
         'waydroid'          # needs the kernel's binder/binderfs (build-kernel.sh)
         'flatpak'
         'discover'
         'bluedevil'
         'kdialog'           # the internal installer's GUI dialogs
         'qt6-tools')        # qdbus6 drives the kdialog progress dialog

package() {
  :
}
