# Arch's plymouth package owns /etc/plymouth/plymouthd.conf, so the theme cannot ship as a
# packaged file. The image overlay covers fresh installs; fielded ones only reach the new
# boot splash through here on -Syu. Only spinner is rewritten, so a user's own choice stands.
_pocknix_set_plymouth_theme() {
  local conf=/etc/plymouth/plymouthd.conf
  [ -f "${conf}" ] || return 0
  sed -i 's/^Theme=spinner$/Theme=pocknix/' "${conf}"
}

# 0.1.0-1's seed stamped before the shell had a desktop to write to (see pocknix-branding-init),
# so every stamp it left is false. Drop it where no wallpaper was ever set, so the fixed seed
# gets its first real run. A user who picked a wallpaper since has an Image= line and keeps it.
_pocknix_drop_false_stamps() {
  local home stamp rc
  for home in ${POCKNIX_HOME_ROOT:-/home}/*; do
    stamp="${home}/.config/pocknix/branding-seeded"
    [ -e "${stamp}" ] || continue
    rc="${home}/.config/plasma-org.kde.plasma.mobileshell-appletsrc"
    grep -qs '^Image=' "${rc}" && continue
    rm -f "${stamp}"
  done
}

post_install() {
  _pocknix_set_plymouth_theme
}

post_upgrade() {
  _pocknix_set_plymouth_theme
  case "${2:-}" in 0.1.0-1) _pocknix_drop_false_stamps ;; esac
}
