# Pocknix OS artwork: the plymouth boot theme and the Plasma splash. One package so the two
# stay in step: same wordmark, same #202126 field, so boot -> splash reads as one surface.
pkgname=pocknix-branding
pkgver=0.1.0
pkgrel=5
pkgdesc="Pocknix OS branding: plymouth boot theme, Plasma splash"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL-2.0-or-later')
depends=('bash')
install='pocknix-branding.install'
# The plymouth theme is DERIVED from the installed stock spinner at build time, not committed:
# copied frames would drift from plymouth's own; output in our own dir survives a plymouth upgrade.
makedepends=('plymouth')
source=('watermark.png'
        'Splash.qml' 'splash-metadata.json' 'wordmark.png')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

_spinner=/usr/share/plymouth/themes/spinner

package() {
  # --- plymouth boot theme -------------------------------------------------------------
  [ -d "${_spinner}" ] || { echo "pocknix-branding: ${_spinner} missing (is plymouth installed?)" >&2; return 1; }
  local theme="${pkgdir}/usr/share/plymouth/themes/pocknix"
  install -d "${theme}"
  cp -a "${_spinner}/." "${theme}/"
  mv "${theme}/spinner.plymouth" "${theme}/pocknix.plymouth"
  # our wordmark replaces the Arch watermark; authored at 2x for DeviceScale=2
  install -Dm644 "${srcdir}/watermark.png" "${theme}/watermark.png"

  # Name/Description/ImageDir must point at OUR dir, and the field matches the splash
  # so plymouth does not flash black before handing over.
  sed -i -e '/^Name\[[^]]*\]=/d' \
         -e 's|^Name=.*|Name=Pocknix|' \
         -e 's|^Description=.*|Description=Pocknix OS boot splash: the stock spinner with the Pocknix wordmark.|' \
         -e "s|^ImageDir=.*|ImageDir=/usr/share/plymouth/themes/pocknix|" \
         -e 's|^BackgroundStartColor=.*|BackgroundStartColor=0x202126|' \
         -e 's|^BackgroundEndColor=.*|BackgroundEndColor=0x202126|' \
         "${theme}/pocknix.plymouth"

  # --- Plasma splash (KSplash look-and-feel) -------------------------------------------
  local splash="${pkgdir}/usr/share/plasma/look-and-feel/com.pocknix.splash"
  install -Dm644 "${srcdir}/splash-metadata.json" "${splash}/metadata.json"
  install -Dm644 "${srcdir}/Splash.qml"           "${splash}/contents/splash/Splash.qml"
  install -Dm644 "${srcdir}/wordmark.png"         "${splash}/contents/splash/images/wordmark.png"
}
