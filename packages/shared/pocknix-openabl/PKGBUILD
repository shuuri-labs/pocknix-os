# pocknix-openabl — the OpenABL install kit for every supported SoC, one elf per chip.
# The factory ABL boots only Android, so an ABL must be flashed to abl_a/abl_b ONCE before any SD
# boots. Nothing here flashes at build or install time; both flashing paths (the kit by hand from
# rooted Android, pocknix-update-abl afterwards) are deliberate user actions.
# Its own tree and hook, so it can sit beside a pocknix-bootloader-<soc> kit.
pkgname=pocknix-openabl
pkgver=1.2
pkgrel=1
pkgdesc="OpenABL install kit for every supported SoC (the running SoC's is copied to /flash/openabl)"
arch=('aarch64')
# !strip: a stripped bootloader is an unbootable one.
options=('!strip')
# Older bsp-common cannot read this tree.
depends=('pocknix-bsp-common>=0.1.0-41')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL-3.0-or-later' 'BSD-3-Clause')   # OpenABL; the Qualcomm ABL it patches
_socs=(SM8250 SM8550 SM8750)
source=("https://github.com/OpenHandheldCollective/OpenABL/releases/download/v${pkgver}/openabl-v${pkgver}.tar.gz"
        'README'
        'flash_abl.sh.template'
        'backup_abl.sh'
        'restore_backup_abl.sh'
        '95-pocknix-openabl.hook')
sha512sums=('41f8b0460bc5c2cbbec312911377e52c41eda7c4dcd365bc76486d81cf4da0e9072df00edaf3afacb87565d856487d0aac3c8b5506d46b9ea6c901c319635492'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

prepare() {
  local s
  for s in "${_socs[@]}"; do
    # the release ships a .sha256 sidecar per elf
    ( cd "openabl-v${pkgver}/${s}" && sha256sum -c "abl_signed-${s}.elf.sha256" )
    sed "s/%DEVICE%/${s}/g" flash_abl.sh.template > "flash_abl-${s}.sh"
  done
  # pocknix-update-abl reports the shipped version; the elf itself carries none
  echo "${pkgver}" > version
}

package() {
  local kit="${pkgdir}/usr/share/pocknix/openabl" s

  for s in "${_socs[@]}"; do
    install -Dm644 "openabl-v${pkgver}/${s}/abl_signed-${s}.elf" "${kit}/${s}/abl_signed-${s}.elf"
    install -Dm755 "flash_abl-${s}.sh"                          "${kit}/${s}/flash_abl.sh"
  done
  install -Dm644 README                 "${kit}/README"
  install -Dm755 backup_abl.sh          "${kit}/backup_abl.sh"
  install -Dm755 restore_backup_abl.sh  "${kit}/restore_backup_abl.sh"
  install -Dm644 version                "${kit}/version"

  # pacman never touches /flash, so a hook re-copies the kit there on upgrade.
  install -Dm644 "${srcdir}/95-pocknix-openabl.hook" \
    "${pkgdir}/usr/share/libalpm/hooks/95-pocknix-openabl.hook"
}
