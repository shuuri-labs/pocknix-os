# pocknix-emu-rpcs3 - pocknix glue for RPCS3 (PS3): its ES-DE launch wrapper.
# Build with ./nodeps: makepkg -s would install the emulator into the build chroot.
pkgname=pocknix-emu-rpcs3
pkgver=0.1.0
pkgrel=1
pkgdesc="pocknix setup for RPCS3 (PS3): ES-DE wiring and preconfigured defaults"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL-2.0-or-later')
depends=('pocknix-emulation-common' 'rpcs3-bin')
source=('es-rpcs3')
sha256sums=('SKIP')

package() {
  install -Dm755 "${srcdir}/es-rpcs3" "${pkgdir}/usr/lib/pocknix/es-rpcs3"
}
