pkgname=pocknix-emu-cemu
pkgver=0.1.0
pkgrel=1
pkgdesc="pocknix setup for Cemu (Wii U): ES-DE wiring and preconfigured defaults"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL-2.0-or-later')
depends=('pocknix-emulation-common' 'cemu')
source=('steam-cemu.conf' 'es-cemu' 'pocknix-cemu-profile' 'cemu-settings.xml.in' 'cemu-controller0.xml.in')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm644 "${srcdir}/steam-cemu.conf" "${pkgdir}/usr/share/pocknix-emulation/steam/cemu.conf"
  install -Dm755 "${srcdir}/es-cemu" "${pkgdir}/usr/lib/pocknix/es-cemu"
  install -Dm755 "${srcdir}/pocknix-cemu-profile" "${pkgdir}/usr/lib/pocknix/pocknix-cemu-profile"
  install -Dm644 "${srcdir}/cemu-settings.xml.in" "${pkgdir}/usr/share/pocknix-emulation/cemu-settings.xml.in"
  install -Dm644 "${srcdir}/cemu-controller0.xml.in" "${pkgdir}/usr/share/pocknix-emulation/cemu-controller0.xml.in"
}
