[Unit]
Description=pocknix Qualcomm ADSP sensorspd FastRPC tunnel
After=local-fs.target systemd-udevd.service
Before=pocknix-ssc-imu.service inputplumber.service

[Service]
Type=simple
ExecStart=/usr/lib/pocknix/pocknix-sensorspd-launch
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
