# pocknix-steam — native ARM64 Steam (Big Picture under gamescope): the client installer, the
# gamescope launcher, and the ARM-Proton compat-tool plumbing.
pkgname=pocknix-steam
pkgver=0.1.0
pkgrel=77
pkgdesc="Native ARM64 Steam Big Picture (gamescope) for the RP6 — installer + launcher"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL-2.0-or-later')
# wget/unzip/curl/tar/xorg-server-xvfb serve pocknix-steam-install, which runs in the image bake
# and again at first launch if the client is missing, so they stay depends. The rest are dlopen
# deps the ARM client needs and nothing on a from-scratch ALARM base pulls in.
# ffmpeg (ffplay) + xorg-xprop: pocknix-steam-splash. python-gobject + upower: pocknix-vpower;
# pocknix-session ships the game-session target it hooks into.
# Depends on pocknix-steam-full (a cycle pacman accepts): devices fielded before the metas
# have this package but not the meta, and -Syu only installs a new name something requires.
# Build with ./nodeps so makepkg -s does not drag the layer into the chroot.
depends=('pocknix-steam-full' 'pocknix-bsp-common>=0.1.0-24'
         'gamescope' 'wget' 'unzip' 'curl' 'tar' 'gtk2' 'gdk-pixbuf2' 'openal' 'libcups' 'lsof'
         'noto-fonts' 'noto-fonts-cjk' 'noto-fonts-emoji' 'networkmanager' 'mangohud'
         'pocknix-steamos-shim' 'xorg-server-xvfb' 'ffmpeg' 'xorg-xprop'
         'python-gobject' 'upower' 'pocknix-session>=0.1.0-7')
install=pocknix-steam.install
source=('pocknix-steam-install' 'pocknix-steam' 'pocknix-steam-splash' 'pocknix-tiles' 'pocknix-tiles-users'
        '60-pocknix-tiles-remove.hook' 'steam' 'steam.desktop'
        'steam-256.png' 'steam-512.png' 'registry.vdf'
        'pocknix-proton-prep' 'pocknix-proton-prep.service'
        'pocknix-game-launch' 'pocknix-steam-env' 'pocknix-steam-channel' 'pocknix-proton-wrapper' 'fex-profiles.json'
        'pocknix-guestos-mount' 'pocknix-guestos.service' 'graphics_provider.json'
        'pocknix-steam-storage' 'pocknix_cdp.py'
        'pocknix-vpower' 'pocknix-vpower.service' 'pocknix-vpower.conf')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 "${srcdir}/pocknix-steam-install" "${pkgdir}/usr/bin/pocknix-steam-install"
  install -Dm755 "${srcdir}/pocknix-steam"         "${pkgdir}/usr/bin/pocknix-steam"
  install -Dm755 "${srcdir}/pocknix-steam-splash"  "${pkgdir}/usr/lib/pocknix/pocknix-steam-splash"
  install -Dm755 "${srcdir}/pocknix-steam-storage" "${pkgdir}/usr/lib/pocknix/pocknix-steam-storage"
  install -Dm644 "${srcdir}/pocknix_cdp.py"        "${pkgdir}/usr/lib/pocknix/pocknix_cdp.py"
  # here, not in the emulation packages: it must still run (and prune) after the layer is removed
  install -Dm755 "${srcdir}/pocknix-tiles"         "${pkgdir}/usr/bin/pocknix-tiles"
  install -Dm755 "${srcdir}/pocknix-tiles-users"   "${pkgdir}/usr/lib/pocknix/pocknix-tiles-users"
  install -Dm644 "${srcdir}/60-pocknix-tiles-remove.hook" "${pkgdir}/usr/share/libalpm/hooks/60-pocknix-tiles-remove.hook"
  install -Dm755 "${srcdir}/steam"                 "${pkgdir}/usr/bin/steam"
  install -Dm644 "${srcdir}/steam.desktop"         "${pkgdir}/usr/share/applications/steam.desktop"
  # The native ARM client is not a system package, so nothing else provides the themed `steam`
  # icon that steam.desktop and pocknix-desktop's return-to-gamemode.desktop both reference.
  install -Dm644 "${srcdir}/steam-256.png"         "${pkgdir}/usr/share/icons/hicolor/256x256/apps/steam.png"
  install -Dm644 "${srcdir}/steam-512.png"         "${pkgdir}/usr/share/icons/hicolor/512x512/apps/steam.png"
  # Pre-completed OOBE registry seed: the Deck OOBE's "required update" step tries to update
  # SteamOS, which we are not, and dead-ends with "Updater apply error: 2".
  install -Dm644 "${srcdir}/registry.vdf"          "${pkgdir}/usr/share/pocknix-steam/registry.vdf"
  install -Dm755 "${srcdir}/pocknix-proton-prep"           "${pkgdir}/usr/bin/pocknix-proton-prep"
  install -Dm644 "${srcdir}/pocknix-proton-prep.service"   "${pkgdir}/usr/lib/systemd/user/pocknix-proton-prep.service"
  # Named bare in every game's launch options (Pocknix Control), so it must stay on PATH under
  # this name: never move or rename it.
  install -Dm755 "${srcdir}/pocknix-game-launch"           "${pkgdir}/usr/bin/pocknix-game-launch"
  install -Dm644 "${srcdir}/pocknix-steam-env"             "${pkgdir}/usr/lib/pocknix/pocknix-steam-env"
  install -Dm644 "${srcdir}/pocknix-steam-channel"         "${pkgdir}/usr/lib/pocknix/pocknix-steam-channel"
  install -Dm755 "${srcdir}/pocknix-proton-wrapper"        "${pkgdir}/usr/lib/pocknix/pocknix-proton-wrapper"
  install -Dm644 "${srcdir}/fex-profiles.json"             "${pkgdir}/usr/share/pocknix/fex-profiles.json"
  install -Dm755 "${srcdir}/pocknix-guestos-mount"         "${pkgdir}/usr/lib/pocknix/pocknix-guestos-mount"
  install -Dm644 "${srcdir}/pocknix-guestos.service"       "${pkgdir}/usr/lib/systemd/system/pocknix-guestos.service"
  install -Dm644 "${srcdir}/graphics_provider.json"        "${pkgdir}/usr/share/pocknix-steam/graphics_provider.json"
  install -Dm755 "${srcdir}/pocknix-vpower"                "${pkgdir}/usr/lib/pocknix/pocknix-vpower"
  install -Dm644 "${srcdir}/pocknix-vpower.service"        "${pkgdir}/usr/lib/systemd/user/pocknix-vpower.service"
  install -Dm644 "${srcdir}/pocknix-vpower.conf"           "${pkgdir}/usr/lib/tmpfiles.d/pocknix-vpower.conf"
  install -d "${pkgdir}/usr/lib/systemd/user/pocknix-game-session.target.wants"
  ln -sf "../pocknix-vpower.service" \
    "${pkgdir}/usr/lib/systemd/user/pocknix-game-session.target.wants/pocknix-vpower.service"
}
