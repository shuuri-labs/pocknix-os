# pocknix-steam — native ARM64 Steam (Big Picture under gamescope): the client installer, the
# gamescope launcher, and the ARM-Proton compat-tool plumbing.
pkgname=pocknix-steam
pkgver=0.1.0
pkgrel=59
pkgdesc="Native ARM64 Steam Big Picture (gamescope) for the RP6 — installer + launcher"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL2')
# wget/unzip/curl/tar/xorg-server-xvfb are build-time-only, but pocknix-steam-install runs inside
# the image bake in THIS rootfs, so they must stay depends. The remaining oddities are dlopen deps
# the ARM client needs and nothing on a from-scratch ALARM base pulls in; see dev/steam.md.
depends=('gamescope' 'wget' 'unzip' 'curl' 'tar' 'gtk2' 'gdk-pixbuf2' 'openal' 'libcups' 'lsof'
         'noto-fonts' 'noto-fonts-cjk' 'noto-fonts-emoji' 'networkmanager' 'mangohud'
         'pocknix-steamos-shim' 'xorg-server-xvfb')
install=pocknix-steam.install
source=('pocknix-steam-install' 'pocknix-steam' 'steam' 'steam.desktop'
        'steam-256.png' 'steam-512.png' 'registry.vdf'
        'proton-toolmanifest.vdf'
        'pocknix-proton-prep' 'pocknix-proton-prep.service'
        'pocknix-proton' 'pocknix-proton-wrapper' 'fex-profiles.json'
        'pocknix-guestos-mount' 'pocknix-guestos.service' 'graphics_provider.json')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 "${srcdir}/pocknix-steam-install" "${pkgdir}/usr/bin/pocknix-steam-install"
  install -Dm755 "${srcdir}/pocknix-steam"         "${pkgdir}/usr/bin/pocknix-steam"
  install -Dm755 "${srcdir}/steam"                 "${pkgdir}/usr/bin/steam"
  install -Dm644 "${srcdir}/steam.desktop"         "${pkgdir}/usr/share/applications/steam.desktop"
  # The native ARM client is not a system package, so nothing else provides the themed `steam`
  # icon that steam.desktop and pocknix-desktop's return-to-gamemode.desktop both reference.
  install -Dm644 "${srcdir}/steam-256.png"         "${pkgdir}/usr/share/icons/hicolor/256x256/apps/steam.png"
  install -Dm644 "${srcdir}/steam-512.png"         "${pkgdir}/usr/share/icons/hicolor/512x512/apps/steam.png"
  # Pre-completed OOBE registry seed: the Deck OOBE's "required update" step tries to update
  # SteamOS, which we are not, and dead-ends with "Updater apply error: 2".
  install -Dm644 "${srcdir}/registry.vdf"          "${pkgdir}/usr/share/pocknix-steam/registry.vdf"
  install -Dm644 "${srcdir}/proton-toolmanifest.vdf"       "${pkgdir}/usr/share/pocknix-steam/proton-toolmanifest.vdf"
  install -Dm755 "${srcdir}/pocknix-proton-prep"           "${pkgdir}/usr/bin/pocknix-proton-prep"
  install -Dm644 "${srcdir}/pocknix-proton-prep.service"   "${pkgdir}/usr/lib/systemd/user/pocknix-proton-prep.service"
  install -Dm755 "${srcdir}/pocknix-proton-wrapper"        "${pkgdir}/usr/lib/pocknix/pocknix-proton-wrapper"
  install -Dm755 "${srcdir}/pocknix-proton"                "${pkgdir}/usr/share/pocknix-steam/pocknix-proton"
  install -Dm644 "${srcdir}/fex-profiles.json"             "${pkgdir}/usr/share/pocknix/fex-profiles.json"
  install -Dm755 "${srcdir}/pocknix-guestos-mount"         "${pkgdir}/usr/lib/pocknix/pocknix-guestos-mount"
  install -Dm644 "${srcdir}/pocknix-guestos.service"       "${pkgdir}/usr/lib/systemd/system/pocknix-guestos.service"
  install -Dm644 "${srcdir}/graphics_provider.json"        "${pkgdir}/usr/share/pocknix-steam/graphics_provider.json"
}
