#!/bin/bash
# pocknix-steam — launch the native ARM64 Steam client in Big Picture under gamescope.
set -e

export HOME="${HOME:-/root}"
STEAM="${HOME}/.local/share/Steam"
CLIENT_DIR="${STEAM}/steamrtarm64"
CLIENT="${CLIENT_DIR}/steam"

# Elapsed marks for the phases the user sees as a black screen; the splash shares the clock.
export POCKNIX_STEAM_T0="$(date +%s)"
mark() {
  local m="+$(( $(date +%s) - POCKNIX_STEAM_T0 ))s: $*"
  echo "[pocknix-steam] ${m}"
  logger -t pocknix-steam -- "${m}" 2>/dev/null || true
}

# Order matters: the client's own dir FIRST (its bundled libvpx.so.6 shadows the system one),
# then the aarch64 shim dir.
LDLP="${CLIENT_DIR}:${STEAM}/lib/aarch64-linux-gnu"

# Seeded at BUILD time, so an absent tree is unrecoverable here, not something to fall back from.
if [ ! -x "${CLIENT}" ]; then
  echo "[pocknix-steam] native Steam client missing at ${CLIENT} — the build-time bake didn't seed it." >&2
  exit 1
fi

# Steam resolves its legacy module paths (bin/vgui2_s.dll ...) RELATIVE TO getcwd, and gamescope
# passes our cwd to the client: launching from $HOME gives "Could not load module 'bin/vgui2_s.dll'".
cd "${CLIENT_DIR}" 2>/dev/null || { echo "missing ${CLIENT_DIR}" >&2; exit 1; }

# Marker Decky's CEF remote-debugging connection looks for.
touch "${STEAM}/.cef-enable-remote-debugging" 2>/dev/null || true

# Re-pin EVERY launch: the ARM64 Big-Picture client only works on steamdeck_publicbeta, and
# anything that flips the channel leaves Steam reading "installed version 0", stuck on
# "Installing update" with steamwebhelper crash-looping until this reasserts it.
mkdir -p "${STEAM}/package"
echo steamdeck_publicbeta > "${STEAM}/package/beta"

# Must precede Steam, which enumerates controllers once at startup; desktop mode leaves the pad
# on xb360, and only `deck` gives Steam Input the Steam-native pad (Guide, QAM, L4/L5).
if command -v pocknix-gamepad-target >/dev/null 2>&1; then
  pocknix-gamepad-target deck || true
fi

# Must run BEFORE gamescope: Steam reads compatibilitytools.d only at startup.
/usr/bin/pocknix-proton-prep
mark "proton prep done"

# A session switch SIGTERMs gamescope but the Steam client re-parents and survives holding its
# single-instance lock, so the next launch exits "Steam is already running" and gamescope
# hot-loops. Safe only because this runs at session START, when no legitimate Steam is alive.
uid="$(id -u)"
if pgrep -u "${uid}" -x steam >/dev/null 2>&1 || pgrep -u "${uid}" -f steamwebhelper >/dev/null 2>&1; then
  echo "[pocknix-steam] clearing a stale Steam from a previous session..."
  env LD_LIBRARY_PATH="${LDLP}" "${CLIENT}" -shutdown >/dev/null 2>&1 || true
  for _ in $(seq 1 8); do pgrep -u "${uid}" -x steam >/dev/null 2>&1 || break; sleep 1; done
  pkill -u "${uid}" -KILL -x steam        2>/dev/null || true
  pkill -u "${uid}" -KILL -f steamwebhelper 2>/dev/null || true
fi

# Do NOT seed a global default compat tool here: a CompatToolMapping "0" entry makes Steam refuse
# to install Valve compat tools with "Invalid platform" (steam-for-linux issue 6874).

# Must stay HERE, before Steam starts: Steam rewrites shortcuts.vdf on exit, so a sync against a
# live client is clobbered.
/usr/bin/pocknix-steam-sync || echo "[pocknix-steam] Steam-library sync failed (non-fatal)"
mark "library sync done"

for _dc in /usr/lib/pocknix/device.conf /etc/pocknix/device.conf; do
  [ -r "${_dc}" ] && . "${_dc}"
done
W="${POCKNIX_PANEL_W:-1080}"; H="${POCKNIX_PANEL_H:-1920}"
REFRESH="${POCKNIX_PANEL_REFRESH:-120}"; ORIENT="${POCKNIX_PANEL_ORIENT:-left}"
PANEL_MM="${POCKNIX_PANEL_MM:-177x100}"
# device.conf carries the panel's NATIVE portrait geometry; gamescope wants -W/-H in
# LOGICAL landscape, so transpose for 90/270.
case "${ORIENT}" in
  left|right) GS_W="${H}"; GS_H="${W}" ;;
  *)          GS_W="${W}"; GS_H="${H}" ;;
esac

# --prefer-output pins the main panel; gamescope's modeset disables every other CRTC, which is
# what blanks the second one. Stop pocknix-second-screen so the bottom touchscreen stays off libinput.
GS_OUTPUT=()
if [ -n "${POCKNIX_PANEL_OUTPUT:-}" ]; then
  GS_OUTPUT=(--prefer-output "${POCKNIX_PANEL_OUTPUT}")
fi
if [ -n "${POCKNIX_TOUCH2_NAME:-}" ]; then
  systemctl stop pocknix-second-screen.service 2>/dev/null || true
fi

# Rotation autodetects (scanout when the plane can, else composited; dev/graphics.md).
# Panels past the DPU rotator's 1088-line cap must opt in here or scan out black.
GS_ROTATE=()
if [ "${POCKNIX_PANEL_ROTATE_SHADER:-0}" = "1" ]; then
  GS_ROTATE=(--force-composition-rotation)
fi

# Do NOT add a core pin here: scx_lavd places the bursty threads itself and needs the littles free
# for batch work; a hard taskset fights it.

# Log to a file, never the tty: tty1 is what shows between compositors on a session switch and
# must stay blank. Do NOT exec gamescope either, since the session switch pkills it by name.
GS_LOG="${HOME}/pocknix-steam.log"

# --- DRM/panel readiness gate -------------------------------------------------
# Cold-boot race (verified on the Odin 3, clean image): the session can start before
# the DSI panel probe completes, and gamescope then holds DRM on a BLACK screen — it
# does NOT exit, so the supervisor's <5s fast-fail retry in ~/.bash_profile never
# fires (killing gamescope and letting the supervisor relaunch it brought the session
# up). Wait (bounded) for the main panel connector to report `connected` before
# handing DRM to gamescope. On a normal boot the panel is already up and this returns
# immediately; if it never comes up we proceed after the timeout exactly as before.
_drm_status=""
if [ -n "${POCKNIX_PANEL_OUTPUT:-}" ]; then
  _drm_status="/sys/class/drm/${POCKNIX_PANEL_OUTPUT}/status"
else
  for _c in /sys/class/drm/card*-DSI-*/status; do
    [ -r "${_c}" ] && { _drm_status="${_c}"; break; }   # DSI-1 = main panel (glob order)
  done
fi
_drm_wait=0
while [ -n "${_drm_status}" ] && [ -r "${_drm_status}" ] \
      && [ "$(cat "${_drm_status}" 2>/dev/null)" != connected ] \
      && [ "${_drm_wait}" -lt 30 ]; do
  sleep 1
  _drm_wait=$(( _drm_wait + 1 ))
done
unset _drm_status _drm_wait _c

# gamescope paints black until a client presents; the splash covers that, then execs Steam.
mark "starting gamescope"
# gamepadui sizes its UI from the output's physical mm; the ~96 DPI default reads as a desktop
# monitor and renders the UI tiny. -noshaders keeps fossilize from stealing CPU during play.
env -u WAYLAND_DISPLAY \
  GAMESCOPE_FAKE_OUTPUT_MM="${PANEL_MM}" \
  gamescope "${GS_OUTPUT[@]}" -W "${GS_W}" -H "${GS_H}" -r "${REFRESH}" --xwayland-count 2 --mangoapp --backend drm \
    --force-orientation "${ORIENT}" "${GS_ROTATE[@]}" -e -- \
    /usr/lib/pocknix/pocknix-steam-splash "${GS_W}x${GS_H}" -- \
    env LD_LIBRARY_PATH="${LDLP}" "${CLIENT}" -gamepadui -steamos3 -steampal -steamdeck -noverifyfiles -noshaders \
  >"${GS_LOG}" 2>&1
