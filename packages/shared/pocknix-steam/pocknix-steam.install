_guestos_enable() {
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable --now pocknix-guestos.service >/dev/null 2>&1 || true
}
post_install() { _guestos_enable; }
# Without the mount x86 Proton does not run, so a device upgrading from before the unit (-53)
# gets it enabled once; later upgrades leave the user's choice alone.
post_upgrade() {
  if [ "$(vercmp "$2" 0.1.0-53)" -lt 0 ]; then
    _guestos_enable
  else
    systemctl daemon-reload >/dev/null 2>&1 || true
  fi
}
pre_remove() { systemctl disable --now pocknix-guestos.service >/dev/null 2>&1 || true; }
