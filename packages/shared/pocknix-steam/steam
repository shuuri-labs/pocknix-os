#!/bin/bash
# steam — desktop-mode launcher for the same native ARM64 client pocknix-steam runs under
# gamescope. The client is bootstrapped into $HOME rather than packaged, so nothing else puts a
# `steam` on PATH, which Steam's own per-game shortcuts (`steam steam://rungameid/<id>`) need.
# Same client dir / LD_LIBRARY_PATH / cwd contract as pocknix-steam.
set -e

export HOME="${HOME:-/home/deck}"
STEAM="${HOME}/.local/share/Steam"
CLIENT_DIR="${STEAM}/steamrtarm64"
CLIENT="${CLIENT_DIR}/steam"

# Client's own dir FIRST: its bundled libvpx.so.6 must shadow the system one.
export LD_LIBRARY_PATH="${CLIENT_DIR}:${STEAM}/lib/aarch64-linux-gnu"

if [ ! -x "${CLIENT}" ]; then
  /usr/bin/pocknix-steam-install
fi

# Steam resolves legacy module paths (bin/vgui2_s.dll …) relative to getcwd.
cd "${CLIENT_DIR}" 2>/dev/null || { echo "steam: missing ${CLIENT_DIR}" >&2; exit 1; }

# The client is X11-only and dies "Unable to open a connection to X" without DISPLAY, leaving orphan
# steam procs that wreck the next game session. Plasma does not reliably propagate DISPLAY into
# app-grid launches, so derive it from the live XWayland socket instead of trusting the env.
if [ -z "${DISPLAY:-}" ]; then
  for _s in /tmp/.X11-unix/X*; do
    [ -S "${_s}" ] || continue
    export DISPLAY=":${_s##*/X}"
    echo "steam: derived DISPLAY=${DISPLAY} from the XWayland socket" >&2
    break
  done
  [ -n "${DISPLAY:-}" ] || echo "steam: WARNING no XWayland socket in /tmp/.X11-unix — is the Plasma session up + kwin's XWayland running?" >&2
fi

# Re-pin here too: a desktop-mode `steam` otherwise flips package/beta to steamdeck_stable and
# breaks the next game-mode launch. See pocknix-steam.
mkdir -p "${STEAM}/package"
echo steamdeck_publicbeta > "${STEAM}/package/beta"

exec "${CLIENT}" "$@"
