[Unit]
Description=pocknix: keep the ARM Proton compat tools registered + usable (no reboot after Steam downloads/updates them)
# Must stay a USER service: it reads/writes ~/.local/share/Steam. It covers mid-session downloads
# and desktop mode only; pocknix-steam runs prep synchronously before the game session's Steam.

[Service]
Type=simple
ExecStart=/usr/bin/pocknix-proton-prep --watch
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
