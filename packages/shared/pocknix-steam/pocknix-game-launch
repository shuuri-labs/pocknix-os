#!/usr/bin/env python3
# pocknix-game-launch — launch-option prefix Pocknix Control writes into every Steam game. Steam
# runs it OUTERMOST, before steam-launch-wrapper and every compat tool, so env set here reaches
# pressure-vessel and Valve's FEX alike. Applies /etc/pocknix/game-tweaks.json, then execs the
# command; no tweak may stop the game launching.
import json
import os
import pathlib
import re
import shlex
import stat
import subprocess
import sys
import time


BASE_FEX_CONFIG = pathlib.Path("/usr/share/fex-emu/Config.json")
TWEAKS_CONFIG = pathlib.Path("/etc/pocknix/game-tweaks.json")
FEX_PROFILES_CONFIG = pathlib.Path("/usr/share/pocknix/fex-profiles.json")
TURNIP_ARM_DIR = pathlib.Path("/usr/share/pocknix/vk-arm")
TURNIP_USER_DIR = pathlib.Path.home() / ".local/share/pocknix/turnip"
# Same rule as Pocknix Control's lister: no path separators, no ":" (the prefix), no hidden dirs.
TURNIP_USER_NAME = re.compile(r"[^/:.][^/:]{0,99}")
MAX_DRIVER_BYTES = 256 << 20
# CRT DLLs wine's NATIVE arm64 service processes import; an amd64 redist copy of these in
# the prefix kills wineboot/services.exe with c000007b before any game code runs.
CRT_HEAL_DLLS = ("ucrtbase.dll",)
PE_AMD64 = 0x8664
# Per-game performance override consumed by pocknix-fancontrol + pocknix-lavd-mode.
GAME_MODE_FILE = pathlib.Path("/run/pocknix/game-mode")
FAN_MODES = ("quiet", "moderate", "performance")
LAVD_MODES = ("autopilot", "performance", "balanced", "powersave")
# Exported by pocknix-steam-env from POCKNIX_BIG_CORES; a per-game envVars entry may replace
# them, a launch option that already changed them wins.
PIN_KEYS = ("STEAM_LAUNCH_WRAPPER_AFFINITY_LIST", "WINE_CPU_TOPOLOGY", "PROTON_CPU_TOPOLOGY")
PIN_ENV_SNIPPET = '. /usr/lib/pocknix/pocknix-steam-env; env'


def log(msg):
    print(f"pocknix-game-launch: {msg}", file=sys.stderr)


def appid(args):
    # reaper's AppId= carries the same id for games and shortcuts; a shortcut's env has
    # SteamAppId=0 and a 64-bit SteamGameId, neither of which is the key Pocknix Control saves.
    for a in args:
        if a.startswith("AppId=") and a[6:].isdigit():
            return a[6:]
    for key in ("STEAM_COMPAT_APP_ID", "SteamAppId"):
        value = os.environ.get(key, "").strip()
        if value.isdigit() and value != "0":
            return value
    return None


def proton_dir(args):
    # STEAM_COMPAT_TOOL_PATHS lists every tool in the chain (runtime and Proton); the Proton is
    # the one with `files/`. argv carries the same path when the variable is missing.
    candidates = os.environ.get("STEAM_COMPAT_TOOL_PATHS", "").split(":")
    candidates += [str(pathlib.Path(a).parent) for a in args if pathlib.Path(a).name in ("proton", "pocknix-proton")]
    for c in candidates:
        if c and (pathlib.Path(c) / "proton").is_file() and (pathlib.Path(c) / "files").is_dir():
            return pathlib.Path(c)
    return None


def is_arm(tool):
    # ARM Proton dists (arm64ec wine) ship native arm64 builtins; x86 dists don't.
    return tool is not None and (tool / "files/lib/wine/aarch64-windows").is_dir()


def pe_machine(path):
    try:
        with path.open("rb") as f:
            head = f.read(4096)
        off = int.from_bytes(head[0x3C:0x40], "little")
        return int.from_bytes(head[off + 4:off + 6], "little")
    except (OSError, IndexError, ValueError):
        return None


def load_fex_contract():
    with FEX_PROFILES_CONFIG.open(encoding="utf-8") as f:
        contract = json.load(f)
    profiles = contract.get("profiles")
    if not isinstance(contract.get("defaults"), dict) or not isinstance(profiles, dict) or "default" not in profiles:
        raise ValueError("invalid FEX profile contract")
    for profile in profiles.values():
        if not isinstance(profile, dict) or not isinstance(profile.get("config"), dict):
            raise ValueError("invalid FEX profile contract")
    return contract


def load_tweaks(defaults):
    data = json.loads(json.dumps(defaults))
    try:
        with TWEAKS_CONFIG.open(encoding="utf-8") as f:
            loaded = json.load(f)
    except (OSError, ValueError):
        return data
    if not isinstance(loaded, dict):
        return data
    if isinstance(loaded.get("global"), dict):
        data["global"].update(loaded["global"])
    if isinstance(loaded.get("games"), dict):
        data["games"] = loaded["games"]
    return data


def merged_settings(tweaks, game_id):
    settings = dict(tweaks.get("global", {}))
    if game_id:
        game_settings = tweaks.get("games", {}).get(str(game_id))
        if isinstance(game_settings, dict) and game_settings.get("enabled") is True:
            settings.update(game_settings)
    return settings


def cache_dir(name):
    # pressure-vessel shares $HOME into the container but not XDG_RUNTIME_DIR, and the FEX config
    # and Vulkan driver manifests written here are silently skipped if the game cannot see them.
    cache = os.environ.get("XDG_CACHE_HOME", "")
    base = pathlib.Path(cache) if cache.startswith("/") else pathlib.Path.home() / ".cache"
    return base / name


def resolve_profile(settings, profiles):
    profile_id = settings.get("fexProfile")
    if isinstance(profile_id, str) and profile_id in profiles:
        return profiles[profile_id]
    return profiles["default"]


def apply_fex(settings, game_id, profiles, tool):
    profile = resolve_profile(settings, profiles)
    # Valve's FEX compat tool (x86 tools, native x86 games) only reads this string; Steam exports
    # it empty, so empty counts as unset. "default" equals Valve's own defaults: nothing to say.
    steam = str(profile.get("steam", "") or "")
    if steam and profile is not profiles["default"] and not os.environ.get("STEAM_COMPAT_FEX_CONFIG"):
        os.environ["STEAM_COMPAT_FEX_CONFIG"] = steam
    if not is_arm(tool):
        return
    with BASE_FEX_CONFIG.open(encoding="utf-8") as f:
        config = json.load(f)
    allowed = set().union(*(p["config"].keys() for p in profiles.values()))
    config.setdefault("Config", {}).update({k: v for k, v in profile["config"].items() if k in allowed})

    config_dir = cache_dir("pocknix-fex")
    config_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    cutoff = time.time() - 86400
    for old in config_dir.glob("*.json"):
        try:
            if old.stat().st_mtime < cutoff:
                old.unlink()
        except OSError:
            pass
    name = f"{game_id or 'global'}.{os.getpid()}.json"
    target = config_dir / name
    tmp = target.with_name(f".{name}.tmp")
    try:
        with tmp.open("w", encoding="utf-8") as f:
            json.dump(config, f, indent=2, sort_keys=True)
            f.write("\n")
        os.replace(tmp, target)
        os.environ["FEX_APP_CONFIG"] = str(target)
    finally:
        tmp.unlink(missing_ok=True)


def apply_audio_latency(settings):
    # winepulse honors PULSE_LATENCY_MSEC: a bigger buffer absorbs FEX-translated mixer
    # overruns at the cost of latency, hence per-game rather than global.
    value = str(settings.get("audioLatency", "") or "").strip()
    if value.isdigit() and 10 <= int(value) <= 500 and "PULSE_LATENCY_MSEC" not in os.environ:
        os.environ["PULSE_LATENCY_MSEC"] = value


def read_user_file(path, limit):
    # A FIFO or huge file here would hang or stall the launch: never block, never follow, cap the size.
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_size > limit:
            return None
        return f.read(limit)


def is_arm64_glibc(data):
    # Android (bionic) Turnip builds link "libc.so" and can't load on this host.
    return data[:5] == b"\x7fELF\x02" and data[18:20] == b"\xb7\x00" and b"libc.so.6\0" in data


def user_driver_icd(name):
    # Community Turnip zips ship only the .so (+ meta.json), so the manifest is written here.
    lib = TURNIP_USER_DIR / name / "libvulkan_freedreno.so"
    if not TURNIP_USER_NAME.fullmatch(name):
        return None
    data = read_user_file(lib, MAX_DRIVER_BYTES)
    if not data or not is_arm64_glibc(data):
        return None
    api = "1.4.0"
    for host in sorted(pathlib.Path("/usr/share/vulkan/icd.d").glob("freedreno_icd*.json")):
        try:
            api = json.loads(host.read_text())["ICD"]["api_version"]
            break
        except (OSError, ValueError, KeyError, TypeError):
            pass
    cache = cache_dir("pocknix-turnip")
    cache.mkdir(parents=True, exist_ok=True)
    icd = cache / f"{name}.json"
    tmp = icd.with_name(f".{name}.{os.getpid()}.tmp")
    try:
        tmp.write_text(json.dumps({"file_format_version": "1.0.1", "ICD": {"library_path": str(lib), "api_version": api}}) + "\n")
        os.replace(tmp, icd)
    finally:
        tmp.unlink(missing_ok=True)
    return icd


def apply_mesa_version(settings, tool):
    # "devel" = the mesa main payload, "user:<dir>" = a driver under TURNIP_USER_DIR. Both are
    # aarch64 only; anything else (old series pins included) runs the default driver.
    value = str(settings.get("mesaVersion", "") or "").strip()
    if not value or tool is None:
        return
    # pressure-vessel resolves an x86 game's VK_DRIVER_FILES inside the FEX rootfs, not the host.
    if not is_arm(tool):
        log(f"mesa pick {value}: an x86 Proton always runs its default driver")
        return
    icd = None
    if value in ("devel", "26.3"):  # Shim: "26.3" pins predate mesa main's move to 27.0.
        payloads = [p.name for p in TURNIP_ARM_DIR.glob("*devel*") if (p / "icd.json").is_file()]
        if payloads:
            icd = TURNIP_ARM_DIR / max(payloads, key=lambda v: tuple(int(x) for x in re.findall(r"[0-9]+", v))) / "icd.json"
    elif value.startswith("user:"):
        try:
            icd = user_driver_icd(value[5:])
        except OSError as exc:
            log(f"mesa pick {value}: {exc}")
    else:
        log(f"mesa pick {value} is no longer offered, using default driver")
        return
    if icd is None:
        log(f"mesa pick {value} is not installed or not a glibc aarch64 Turnip, using default driver")
        return
    if "VK_DRIVER_FILES" not in os.environ and "VK_ICD_FILENAMES" not in os.environ:
        os.environ["VK_DRIVER_FILES"] = str(icd)
        os.environ["VK_ICD_FILENAMES"] = str(icd)


def apply_game_modes(settings):
    # Fan curve / scheduler tagged with our pid: the launch chain execs in place, so a dead pid
    # reverts the pick with no cleanup. "-" = field not overridden.
    fan = str(settings.get("fanMode", "") or "").strip()
    lavd = str(settings.get("lavdMode", "") or "").strip()
    fan = fan if fan in FAN_MODES else "-"
    lavd = lavd if lavd in LAVD_MODES else "-"
    if fan == "-" and lavd == "-":
        return
    try:
        GAME_MODE_FILE.write_text(f"{os.getpid()} {fan} {lavd}\n")
    except OSError as exc:
        log(f"failed to write game mode override: {exc}")


def pin_defaults():
    try:
        out = subprocess.run(["/bin/sh", "-c", PIN_ENV_SNIPPET], capture_output=True, text=True,
                             timeout=5, env={"PATH": "/usr/bin:/bin"}).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    pairs = (line.partition("=") for line in out.splitlines())
    return {k: v for k, _, v in pairs if k in PIN_KEYS}


def apply_env_vars(settings):
    # Free-form per-game env ("Environment Variables" tweak). shlex so quoted values with spaces
    # survive. Launch options win; we only fill in unset, except over our own pin defaults.
    raw = settings.get("envVars")
    if not isinstance(raw, str) or not raw.strip():
        return
    try:
        tokens = shlex.split(raw)
    except ValueError:
        return
    defaults = pin_defaults() if any(t.split("=", 1)[0] in PIN_KEYS for t in tokens) else {}
    for token in tokens:
        key, sep, value = token.partition("=")
        if not sep or not key.isidentifier():
            continue
        if key in defaults and os.environ.get(key) == defaults[key]:
            os.environ[key] = value
        else:
            os.environ.setdefault(key, value)


def apply_xalia(settings):
    # Proton starts xalia (gamepad UI helper) for every game, costing CPU inside the pinned
    # tree. Runs after apply_env_vars so launch options and envVars win.
    if "PROTON_USE_XALIA" not in os.environ and settings.get("disableXalia", True) is not False:
        os.environ["PROTON_USE_XALIA"] = "0"


def heal_arm_prefix(tool):
    # Steam's VC-redist installs plant amd64 CRT DLLs that kill wine's arm64 services (c000007b,
    # =b does not help): re-point to the arm64X builtin every launch, as updates restore the file.
    if not is_arm(tool):
        return
    compat = os.environ.get("STEAM_COMPAT_DATA_PATH", "").strip()
    if not compat:
        return
    builtin_dir = tool / "files/lib/wine/aarch64-windows"
    system32 = pathlib.Path(compat) / "pfx/drive_c/windows/system32"
    for name in CRT_HEAL_DLLS:
        target = system32 / name
        builtin = builtin_dir / name
        if not (builtin.is_file() and target.is_file() and not target.is_symlink()):
            continue
        if pe_machine(target) != PE_AMD64:
            continue
        bak = target.with_name(name + ".amd64.bak")
        bak.unlink(missing_ok=True)
        target.rename(bak)
        target.symlink_to(builtin)
        log(f"healed {name} (amd64 redist copy -> arm64 builtin)")


def main():
    args = sys.argv[1:]
    if not args:
        raise SystemExit("usage: pocknix-game-launch COMMAND [ARGS...]")

    game_id = appid(args)
    tool = proton_dir(args)
    settings = {}
    try:
        contract = load_fex_contract()
        settings = merged_settings(load_tweaks(contract["defaults"]), game_id)
        apply_fex(settings, game_id, contract["profiles"], tool)
    except Exception as exc:
        log(f"failed to apply FEX config: {exc}")
    for step in (lambda: apply_audio_latency(settings),
                 lambda: apply_mesa_version(settings, tool),
                 lambda: apply_env_vars(settings),
                 lambda: apply_xalia(settings),
                 lambda: apply_game_modes(settings),
                 lambda: heal_arm_prefix(tool)):
        try:
            step()
        except Exception as exc:
            log(f"tweak skipped: {exc}")

    try:
        os.execvp(args[0], args)
    except OSError as exc:
        raise SystemExit(f"pocknix-game-launch: failed to exec {args[0]}: {exc}")


if __name__ == "__main__":
    main()
