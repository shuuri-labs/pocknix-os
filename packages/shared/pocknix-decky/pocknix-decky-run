#!/bin/bash
# pocknix-decky-run — launch Decky's PluginLoader (x86_64 PyInstaller binary) under FEX.
# The onefile bootloader re-execs itself so it needs the FEX binfmt handler, which pocknix keeps
# globally off (it breaks Steam's Proton compat-tool setup); binfmt_misc is userns-scoped on
# >= 6.7, hence the private instance. CAP_CHOWN is still checked against the init userns, so
# chowning the seeded tree belongs in pocknix-decky-sync.
set -eu

# slave, not unshare's default private: init-ns mounts still propagate IN, so plugin backends
# see live SD automounts instead of pinning a stale copy that keeps the device busy on format.
exec unshare --user --map-users=0,0,4294967295 --map-groups=0,0,4294967295 --mount --propagation slave \
  /bin/bash -c '
    set -eu
    mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc
    grep -h . /usr/lib/binfmt.d/FEX-x86_64.conf > /proc/sys/fs/binfmt_misc/register
    grep -h . /usr/lib/binfmt.d/FEX-x86.conf    > /proc/sys/fs/binfmt_misc/register
    # /usr/bin/FEX, not FEXInterpreter: FEX-2608 deleted the deprecated alias.
    exec /usr/bin/FEX /home/deck/homebrew/services/PluginLoader
  '
