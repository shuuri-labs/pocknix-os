# pocknix-snapshots — pre-update btrfs snapshots plus a rollback that needs no boot
# menu: two alpm hooks wrap every pacman transaction, and pocknix-rollback switches the
# fs default subvolume. Every entry point no-ops when / is not btrfs (build chroot,
# pre-snapshot ext4 installs).
pkgname=pocknix-snapshots
pkgver=0.1.0
pkgrel=3
pkgdesc="pocknix pre-update btrfs snapshots and rollback (subvolume set-default)"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL2')
depends=('btrfs-progs' 'jq' 'util-linux')
backup=('etc/pocknix/snapshots.conf')
source=('05-pocknix-snapshot.hook' '99-pocknix-snapshot-post.hook'
        'snapshot-lib.sh'
        'pocknix-snapshot-pre' 'pocknix-snapshot-post'
        'pocknix-snapshots' 'pocknix-rollback'
        'pocknix-rollback-repair' 'pocknix-rollback-repair.service'
        'snapshots.conf' '50-pocknix-snapshots.rules')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm644 "${srcdir}/05-pocknix-snapshot.hook" \
    "${pkgdir}/usr/share/libalpm/hooks/05-pocknix-snapshot.hook"
  install -Dm644 "${srcdir}/99-pocknix-snapshot-post.hook" \
    "${pkgdir}/usr/share/libalpm/hooks/99-pocknix-snapshot-post.hook"

  install -Dm644 "${srcdir}/snapshot-lib.sh" "${pkgdir}/usr/lib/pocknix/snapshot-lib.sh"

  local bin
  for bin in pocknix-snapshot-pre pocknix-snapshot-post pocknix-snapshots \
             pocknix-rollback pocknix-rollback-repair; do
    install -Dm755 "${srcdir}/${bin}" "${pkgdir}/usr/bin/${bin}"
  done

  install -Dm644 "${srcdir}/snapshots.conf" "${pkgdir}/etc/pocknix/snapshots.conf"

  install -Dm644 "${srcdir}/50-pocknix-snapshots.rules" \
    "${pkgdir}/usr/share/polkit-1/rules.d/50-pocknix-snapshots.rules"

  # statically enabled via a wants symlink; ConditionPathExists keeps it inert
  # except on a rolled-back boot
  install -Dm644 "${srcdir}/pocknix-rollback-repair.service" \
    "${pkgdir}/usr/lib/systemd/system/pocknix-rollback-repair.service"
  install -d "${pkgdir}/usr/lib/systemd/system/multi-user.target.wants"
  ln -s ../pocknix-rollback-repair.service \
    "${pkgdir}/usr/lib/systemd/system/multi-user.target.wants/pocknix-rollback-repair.service"
}
