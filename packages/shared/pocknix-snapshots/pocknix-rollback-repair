#!/bin/bash
# pocknix-rollback-repair — activate boot files left staged as /flash/*.new by a
# rollback that died between its set-default commit and the rename (see
# pocknix-rollback). Marker-gated oneshot; always exits 0.
set -uo pipefail

. /usr/lib/pocknix/snapshot-lib.sh

FLASH=/flash
mountpoint -q "${FLASH}" || exit 0

mapfile -t staged < <(snap_staged_files "${FLASH}")
[ "${#staged[@]}" -gt 0 ] || exit 0

mount -o remount,rw "${FLASH}" 2>/dev/null || true
for f in "${staged[@]}"; do mv -f "${f}" "${f%.new}"; done
sync
echo "pocknix-rollback-repair: activated ${#staged[@]} staged boot file(s) left by an interrupted rollback"
