# Defaults every Plasma flavour shares; the flavours depend on it so no two own the same file.
# Build with ./nodeps: makepkg -s would drag all of KDE/Qt into the chroot for a data package.
pkgname=pocknix-desktop-kde
pkgver=0.1.0
pkgrel=6
pkgdesc="pocknix KDE defaults shared by the Plasma desktop flavours"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL-2.0-or-later')
depends=('bash'
         'plasma-workspace'
         'kwin'
         'glib2'             # gdbus for the live touchscreen pinning
         'powerdevil'
         'kscreen'           # kscreen-doctor drives the rotated-DSI transform
         'plasma-nm'
         'bluedevil')
# These files lived in pocknix-desktop up to -26 and kwinrc in pocknix-desktop-plasma up to -3;
# a lone install against either would collide.
conflicts=('pocknix-desktop<0.1.0-27' 'pocknix-desktop-plasma<0.1.0-4')
source=('pocknix-desktop-rotate' 'pocknix-desktop-rotate.desktop'
        'pocknix-desktop-touchpin' 'pocknix-desktop-touchpin.desktop'
        'ksplashrc' 'powerdevilrc' 'kscreenlockerrc' 'baloofilerc' '50-kde-power-key.sh' 'kwinrc')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 "${srcdir}/pocknix-desktop-rotate"   "${pkgdir}/usr/bin/pocknix-desktop-rotate"
  install -Dm644 "${srcdir}/pocknix-desktop-rotate.desktop" \
    "${pkgdir}/etc/xdg/autostart/pocknix-desktop-rotate.desktop"
  install -Dm755 "${srcdir}/pocknix-desktop-touchpin" "${pkgdir}/usr/bin/pocknix-desktop-touchpin"
  install -Dm644 "${srcdir}/pocknix-desktop-touchpin.desktop" \
    "${pkgdir}/etc/xdg/autostart/pocknix-desktop-touchpin.desktop"
  install -Dm644 "${srcdir}/ksplashrc"                "${pkgdir}/etc/xdg/ksplashrc"
  install -Dm644 "${srcdir}/powerdevilrc"             "${pkgdir}/etc/xdg/powerdevilrc"
  install -Dm644 "${srcdir}/kscreenlockerrc"          "${pkgdir}/etc/xdg/kscreenlockerrc"
  install -Dm644 "${srcdir}/baloofilerc"              "${pkgdir}/etc/xdg/baloofilerc"
  # /etc/xdg is the lowest layer: a keyboard the user picks wins, and Plasma Mobile sets
  # InputMethod in its own kwinrc, so only that key never reaches Mobile.
  install -Dm644 "${srcdir}/kwinrc"                   "${pkgdir}/etc/xdg/kwinrc"
  install -Dm755 "${srcdir}/50-kde-power-key.sh" \
    "${pkgdir}/usr/lib/pocknix/desktop.d/50-kde-power-key.sh"
}
