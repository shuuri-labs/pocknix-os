#!/bin/bash
set -e

export HOME="${HOME:-/home/deck}"

session="$(pocknix-desktop-select current)" || {
  echo "pocknix-desktop: no usable desktop in /usr/share/wayland-sessions" >&2
  exit 1
}
entry="/usr/share/wayland-sessions/${session}.desktop"
exec_line="$(sed -n 's/^Exec=//p' "${entry}" | head -1)"
desktops="$(sed -n 's/^DesktopNames=//p' "${entry}" | head -1)"
desktops="${desktops%;}"
echo "pocknix-desktop: starting ${session}: ${exec_line}" >&2

# kwin starts XWayland only if /tmp/.X11-unix is sticky, and gamescope leaves it deck:0755.
mkdir -p /tmp/.X11-unix 2>/dev/null || true
chmod 1777 /tmp/.X11-unix 2>/dev/null || true

# The game-mode `deck` target publishes no evdev joystick; see pocknix-gamepad-target.
if command -v pocknix-gamepad-target >/dev/null 2>&1; then
  pocknix-gamepad-target xb360 || true
fi

# Before kwin enumerates input: its fallback puts every touchscreen on the FIRST output.
for _dc in /usr/lib/pocknix/device.conf /etc/pocknix/device.conf; do
  [ -r "${_dc}" ] && . "${_dc}"
done
if [ -n "${POCKNIX_TOUCH2_NAME:-}" ]; then
  systemctl start pocknix-second-screen.service 2>/dev/null || true
  map_touch() {  # <evdev name> <output>
    local d vendor product
    for d in /sys/class/input/input*; do
      [ "$(cat "${d}/name" 2>/dev/null)" = "$1" ] || continue
      vendor=$(( 16#$(cat "${d}/id/vendor" 2>/dev/null || echo 0) ))
      product=$(( 16#$(cat "${d}/id/product" 2>/dev/null || echo 0) ))
      kwriteconfig6 --file kcminputrc --group Libinput --group "${vendor}" --group "${product}" \
        --group "$1" --key OutputName "$2" 2>/dev/null || true
      return
    done
    echo "pocknix-desktop: touchscreen '$1' not found — not mapped to $2" >&2
  }
  if command -v kwriteconfig6 >/dev/null 2>&1; then
    [ -n "${POCKNIX_TOUCH_NAME:-}" ]   && map_touch "${POCKNIX_TOUCH_NAME}"  "${POCKNIX_PANEL_OUTPUT:-}"
    map_touch "${POCKNIX_TOUCH2_NAME}" "${POCKNIX_PANEL2_OUTPUT:-}"
  fi
fi

# What a display manager exports: DEs are tested against that, and the supervisor's own
# session says XDG_SESSION_TYPE=tty.
export XDG_SESSION_TYPE=wayland DESKTOP_SESSION="${session}"
export XDG_SESSION_DESKTOP="${desktops%%;*}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-${session}}"
[ -n "${desktops}" ] && export XDG_CURRENT_DESKTOP="${desktops//;/:}"

# Both Plasmas are DesktopNames=KDE, so OnlyShowIn cannot separate them: other desktops' apps
# are shadowed per session. KDE drops a Hidden=true stub and shows the next copy, so NoDisplay.
hide_other_apps() {  # <dir> <data dirs> <own list names, space-separated>
  local list id src d _
  local -a dirs
  rm -rf "$1" && mkdir -p "$1/applications" || return 1
  IFS=: read -ra dirs <<< "$2"
  for list in /usr/share/pocknix/desktop-apps/*.list; do
    [ -r "${list}" ] || continue
    [[ " $3 " == *" $(basename "${list}" .list) "* ]] && continue
    while read -r id _ || [ -n "${id}" ]; do
      [[ -z "${id}" || "${id}" == \#* ]] && continue
      [[ "${id}" == *.desktop && "${id}" != */* ]] || continue
      src=""
      for d in "${dirs[@]}"; do
        [ -r "${d%/}/applications/${id}" ] && { src="${d%/}/applications/${id}"; break; }
      done
      [ -n "${src}" ] || continue
      awk '/^\[/ { g = $0 } g == "[Desktop Entry]" && /^NoDisplay=/ { next } { print }
           $0 == "[Desktop Entry]" { print "NoDisplay=true" }' "${src}" > "$1/applications/${id}" || return 1
    done < "${list}"
  done
}
hide_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pocknix-desktop/share"
data_dirs="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
if hide_other_apps "${hide_dir}" "${data_dirs}" "${session} $(tr '[:upper:];' '[:lower:] ' <<< "${desktops}")"; then
  export XDG_DATA_DIRS="${hide_dir}:${data_dirs}"
else
  echo "pocknix-desktop: could not hide other desktops' apps" >&2
fi

# Flavours drop pre-start hooks here: some DE config is only read when its session starts. Run,
# not sourced, so a failing hook can never keep the desktop from starting.
for _hook in /usr/lib/pocknix/desktop.d/*.sh; do
  [ -r "${_hook}" ] && { bash "${_hook}" || echo "pocknix-desktop: hook ${_hook} failed" >&2; }
done

# exec keeps this PID, so it names the session for steamos-session-select and
# pocknix-desktop-select --now; the supervisor deletes it once the session ends.
# Plain word splitting: session Exec lines carry no quoting or field codes.
read -ra argv <<< "${exec_line}"
echo "$$" > "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pocknix-desktop.pid"
exec "${argv[@]}"
