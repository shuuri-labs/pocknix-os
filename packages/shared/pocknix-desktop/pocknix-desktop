#!/bin/bash
# pocknix-desktop — launch the Plasma Mobile desktop session.
# Exec'd by ~deck/.bash_profile on tty1 so the session inherits the deck PAM session
# (XDG_RUNTIME_DIR + per-user PipeWire). startplasmamobile handles its own D-Bus session.
set -e

export HOME="${HOME:-/home/deck}"

if ! command -v startplasmamobile >/dev/null 2>&1; then
  echo "pocknix-desktop: startplasmamobile not found — is the plasma-mobile stack installed?" >&2
  exit 1
fi

# The getty autologin session is not reliably "active" on seat0, so libseat's default logind
# backend leaves kwin unable to take DRM master or open input. seatd is what gamescope uses.
export LIBSEAT_BACKEND=seatd

# kwin starts XWayland only if /tmp/.X11-unix is sticky; a prior gamescope session leaves it
# deck:0755, so XWayland is refused and the X11 Steam client cannot connect. Re-assert per launch.
mkdir -p /tmp/.X11-unix 2>/dev/null || true
chmod 1777 /tmp/.X11-unix 2>/dev/null || true

# pocknix-powerd owns the power key; the device also delivers the WAKING press to userspace, so
# powerdevil's tablet-mode "Turn Off Screen" binding blanks the panel right after resume.
# Distinct from powerButtonAction (/etc/xdg/powerdevilrc). Value is "active,default,description".
if command -v kwriteconfig6 >/dev/null 2>&1; then
  kwriteconfig6 --file kglobalshortcutsrc --group org_kde_powerdevil \
    --key "Turn Off Screen" "none,Power Off,Turn Off Screen" 2>/dev/null || true
fi

# The game-mode `deck` target publishes no evdev joystick; see pocknix-gamepad-target.
if command -v pocknix-gamepad-target >/dev/null 2>&1; then
  pocknix-gamepad-target xb360 || true
fi

# The community controller DB every SDL app bundles maps InputPlumber's xb360 GUID
# (045e:028e version 0001) to a 180-degree-rotated d-pad. SDL_GAMECONTROLLERCONFIG is
# PRIORITY_USER, the one level a bundled DB cannot overwrite.
export SDL_GAMECONTROLLERCONFIG='030000005e0400008e02000001000000,Microsoft X-Box 360 pad,a:b0,b:b1,back:b6,dpdown:h0.4,dpleft:h0.8,dpright:h0.2,dpup:h0.1,guide:b8,leftshoulder:b4,leftstick:b9,lefttrigger:a2,leftx:a0,lefty:a1,rightshoulder:b5,rightstick:b10,righttrigger:a5,rightx:a3,righty:a4,start:b7,x:b2,y:b3,platform:Linux,'

exec startplasmamobile
