# System default (/etc/xdg/powerdevilrc); a user's ~/.config/powerdevilrc still wins.
# powerButtonAction=0 is NoAction (PowerButtonAction enum). Plasma Mobile defaults to
# ToggleScreenOnOff, which fights pocknix-powerd: the press that WAKES the device arrives as
# a normal KEY_POWER after resume, so the shell blanked the panel again on every wake.
[AC][SuspendAndShutdown]
powerButtonAction=0

[Battery][SuspendAndShutdown]
powerButtonAction=0

[LowBattery][SuspendAndShutdown]
powerButtonAction=0
