#!/bin/bash
# steamos-session-select — the SteamOS-contract name Steam and the Plasma tile both invoke to
# switch sessions. There is no display manager: ~deck/.bash_profile supervises, so switching means
# rewriting the choice file and SIGTERMing the compositor. Never restart getty to do this — the
# same logind session must stay active on seat0 or kwin cannot take DRM master afterwards.
set -u

STATE_HOME="${XDG_STATE_HOME:-${HOME:-/home/deck}/.local/state}"
CHOICE_FILE="${STATE_HOME}/pocknix-session"

usage() { echo "usage: steamos-session-select [gamescope|desktop|plasma]" >&2; exit 2; }

case "${1:-}" in
  desktop|plasma)        sel=plasma    ;;
  gamescope|game|steam)  sel=gamescope ;;
  ""|*)                  usage         ;;
esac

mkdir -p "${STATE_HOME}"
printf '%s\n' "${sel}" > "${CHOICE_FILE}"
echo "steamos-session-select: next session = ${sel} (signalling current compositor to exit)" >&2

# No -x: the patterns must also catch the wrappers (kwin_wayland_wrapper, etc.).
uid="$(id -u)"
pkill -u "${uid}" -TERM gamescope    2>/dev/null || true
pkill -u "${uid}" -TERM kwin_wayland 2>/dev/null || true
# gamescope dying does not take Steam with it: it re-parents and keeps its single-instance lock,
# so the next game-mode launch would bail "Steam is already running". pocknix-steam clears survivors.
if [ "${sel}" = plasma ]; then
  pkill -u "${uid}" -TERM steam          2>/dev/null || true
  pkill -u "${uid}" -TERM steamwebhelper 2>/dev/null || true
fi
exit 0
