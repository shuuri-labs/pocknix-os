[Unit]
Description=pocknix: register the Flathub remote for Discover/flatpak
# remote-add fetches flathub.flatpakrepo, so the first run needs the network; later runs no-op.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/pocknix-flathub-setup
RemainAfterExit=yes

# Do not add [Install]: only the NM dispatcher hook (50-pocknix-flathub) may start this - see
# pocknix-flathub-dispatcher for why a boot transaction cannot work.
