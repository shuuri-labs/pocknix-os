#!/bin/sh
# NM dispatcher hook (/etc/NetworkManager/dispatcher.d/50-pocknix-flathub); $1=interface, $2=action.
# network-online.target lands ~10s before wlan0 has DNS, so a boot-time remote-add always failed;
# the service is Before=multi-user.target, so retrying there would stall boot with no Wi-Fi around.
# NM also fires `up` for its loopback device and connectivity-change while still NONE - both spurious.
[ "$1" = lo ] && exit 0

case "$2" in
  up|vpn-up) ;;
  connectivity-change) [ "${CONNECTIVITY_STATE}" = "FULL" ] || exit 0 ;;
  *) exit 0 ;;
esac

# --no-block: NM serialises dispatcher scripts under a timeout. remote-add is idempotent.
exec systemctl start --no-block pocknix-flathub.service
