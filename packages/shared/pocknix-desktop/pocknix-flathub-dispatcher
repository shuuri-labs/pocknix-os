#!/bin/sh
# NM dispatcher hook -> register the Flathub remote when the link is really up.
# Installed as /etc/NetworkManager/dispatcher.d/50-pocknix-flathub.
# network-online.target is reached ~10s before wlan0 has DNS (NM reports startup complete before the
# iwd backend has the link), so a boot-time remote-add always failed. Retrying at boot would be
# worse: the service is Before=multi-user.target, so it would stall boot with no Wi-Fi in range.
# $1 = interface, $2 = action.
# NM fires two spurious events seconds before any usable link, both of which would just log a failed
# fetch every boot: `up` for the loopback device it manages, and connectivity-change while still
# NONE. Verified by logging every invocation across a boot.
[ "$1" = lo ] && exit 0

case "$2" in
  up|vpn-up) ;;
  connectivity-change) [ "${CONNECTIVITY_STATE}" = "FULL" ] || exit 0 ;;
  *) exit 0 ;;
esac

# --no-block: NM serialises dispatcher scripts under a timeout. remote-add is idempotent.
exec systemctl start --no-block pocknix-flathub.service
