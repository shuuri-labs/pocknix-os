// The Deck UI's power, Wi-Fi, timezone and SD-format actions, promptless for wheel: the gamescope
// session cannot show a polkit dialog.
polkit.addRule(function(action, subject) {
    if (!subject.isInGroup("wheel")) { return; }
    if (action.id.indexOf("org.freedesktop.login1.")         == 0 ||
        action.id.indexOf("org.freedesktop.NetworkManager.") == 0 ||
        action.id.indexOf("org.freedesktop.timedate1.")      == 0) {
        return polkit.Result.YES;
    }
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/lib/hwsupport/format-device.sh") {
        return polkit.Result.YES;
    }
});
