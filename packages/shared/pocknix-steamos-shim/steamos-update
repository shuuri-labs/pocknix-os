#!/bin/bash
# pocknix steamos-update shim — Steam's OS-update hook, always reporting "no update"; without it
# the OOBE's required-update step dead-ends with "Updater apply error: 2".
# Valve's exit convention, which real OTA must keep: 0 = update available / apply ok, 7 = no update.
set -u
for arg in "$@"; do
  case "${arg}" in
    --supports-duplicate-detection) exit 0 ;;   # capability probe
    check) exit 7 ;;                             # no OS update available
  esac
done
exit 0   # apply: nothing to do, report success
