#!/bin/bash
# pocknix steamos-mandatory-update shim — the OOBE's pre-setup "required update" gate.
# Same contract as steamos-update: apply must report "no update" (7) or Steam marks
# "system restart required" and reboots right after the language/WiFi step.
set -u
for arg in "$@"; do
  case "${arg}" in
    --supports-duplicate-detection) exit 0 ;;   # capability probe
  esac
done
echo "No update available" >&2
exit 7   # check and apply: nothing to do -> no "restart required"
