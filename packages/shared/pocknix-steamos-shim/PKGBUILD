# pocknix-steamos-shim — stubs for the SteamOS update/branch/BIOS helpers the Deck UI
# (-steamos3 -steamdeck) shells out to; without them the OOBE "required update" step dead-ends.
# The Steam-facing interface matches Valve's, so real OTA later is a drop-in body swap.
pkgname=pocknix-steamos-shim
pkgver=0.1.0
pkgrel=7
pkgdesc="SteamOS update/branch/timezone/format helper stubs for the Steam Deck UI on a non-SteamOS base (until real OTA)"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL2')
# The format shims pkexec /usr/lib/hwsupport/format-device.sh, shipped by pocknix-sdcard-automount.
depends=('pocknix-sdcard-automount' 'polkit')
source=('steamos-update' 'steamos-select-branch' 'steamos-set-timezone'
        'steamos-format-device' 'steamos-format-sdcard' 'jupiter-biosupdate')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  # Steam calls these helpers by their FULL /usr/bin/steamos-polkit-helpers/ path, not via PATH,
  # so each one ships at both that path and the plain /usr/bin name the checks also use.
  install -Dm755 "${srcdir}/steamos-update"        "${pkgdir}/usr/bin/steamos-polkit-helpers/steamos-update"
  install -Dm755 "${srcdir}/steamos-update"        "${pkgdir}/usr/bin/steamos-update"
  install -Dm755 "${srcdir}/steamos-select-branch" "${pkgdir}/usr/bin/steamos-select-branch"
  install -Dm755 "${srcdir}/steamos-set-timezone"  "${pkgdir}/usr/bin/steamos-polkit-helpers/steamos-set-timezone"
  install -Dm755 "${srcdir}/steamos-set-timezone"  "${pkgdir}/usr/bin/steamos-set-timezone"
  # Both spellings ship: newer clients call steamos-format-device, older ones -sdcard.
  install -Dm755 "${srcdir}/steamos-format-device" "${pkgdir}/usr/bin/steamos-polkit-helpers/steamos-format-device"
  install -Dm755 "${srcdir}/steamos-format-device" "${pkgdir}/usr/bin/steamos-format-device"
  install -Dm755 "${srcdir}/steamos-format-sdcard" "${pkgdir}/usr/bin/steamos-polkit-helpers/steamos-format-sdcard"
  install -Dm755 "${srcdir}/steamos-format-sdcard" "${pkgdir}/usr/bin/steamos-format-sdcard"
  # jupiter-biosupdate needs its OWN always-exit-0 stub, not the steamos-update script: the BIOS
  # check uses the opposite exit convention, where steamos-update's 7 reads as "update available"
  # and prompts spuriously, while a missing helper (127) reads as a check failure.
  install -Dm755 "${srcdir}/jupiter-biosupdate"    "${pkgdir}/usr/bin/steamos-polkit-helpers/jupiter-biosupdate"
  install -Dm755 "${srcdir}/jupiter-biosupdate"    "${pkgdir}/usr/bin/jupiter-biosupdate"
  # Do NOT add a jupiter-dock-updater stub: its presence makes Steam believe a dock is attached
  # and prompt for a dock update.
}
