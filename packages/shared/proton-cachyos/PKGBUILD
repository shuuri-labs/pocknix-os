# CachyOS's ARM64 Proton as a SYSTEM compat tool; the reference for the other Proton packages.
# Keep the tool dir and the compatibilitytool.vdf internal name CONSTANT across bumps: Steam stores
# that name per game, so a -Syu swaps the files under every game set to it. Same reason the label
# carries the MAJOR version only. pocknix-proton-prep (pocknix-steam) registers the user dir: the
# root-owned tool dir cannot symlink itself into ~/.local/share/Steam/compatibilitytools.d.
pkgname=proton-cachyos
_srctag=11.0-20261015
_build=slr
_major=${_srctag%%.*}
pkgver=${_srctag//-/.}
pkgrel=1
pkgdesc="CachyOS Proton (official ARM64 build) as a system Steam compatibility tool"
arch=('aarch64')
url="https://github.com/CachyOS/proton-cachyos"
license=('BSD' 'LGPL' 'zlib' 'MIT' 'MPL' 'custom')
depends=('bash' 'python' 'pocknix-steam')
options=('!strip' 'emptydirs')
_dist="proton-cachyos-${_srctag}-${_build}-arm64"
source=("https://github.com/CachyOS/proton-cachyos/releases/download/cachyos-${_srctag}-${_build}/${_dist}.tar.xz"
        'compatibilitytool.vdf.in'
        'toolmanifest.vdf'
        'pocknix-proton')
sha512sums=('d61bfe4caae66d63c71bb1c84da326ca9af2d66f8c73dbcffe5fb58148ce950339984f84c4a3e3eead883b7f5d3aa7192d020ae413323c5e343dad851e65ed87'
            'SKIP'
            'SKIP'
            'SKIP')

build() {
  sed "s|@VER@|${_major}|" compatibilitytool.vdf.in > compatibilitytool.vdf
}

package() {
  local tooldir="usr/share/steam/compatibilitytools.d/${pkgname}"
  mkdir -p "${pkgdir}/${tooldir}"
  cp -a "${srcdir}/${_dist}/." "${pkgdir}/${tooldir}/"

  # The shim must land next to `proton`: toolmanifest commandline paths resolve relative to the
  # tool dir.
  install -Dm644 "${srcdir}/compatibilitytool.vdf" "${pkgdir}/${tooldir}/compatibilitytool.vdf"
  install -Dm644 "${srcdir}/toolmanifest.vdf"      "${pkgdir}/${tooldir}/toolmanifest.vdf"
  install -Dm755 "${srcdir}/pocknix-proton"        "${pkgdir}/${tooldir}/pocknix-proton"

  # Tolerant of absence: upstream moves these between releases.
  local f
  for f in LICENSE LICENSE.OFL PATENTS.AV1; do
    if [ -f "${pkgdir}/${tooldir}/${f}" ]; then
      install -Dm644 "${pkgdir}/${tooldir}/${f}" "${pkgdir}/usr/share/licenses/${pkgname}/${f}"
      rm -f "${pkgdir}/${tooldir}/${f}"
    fi
  done
}
