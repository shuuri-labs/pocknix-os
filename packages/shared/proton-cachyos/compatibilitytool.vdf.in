// The internal name "proton-cachyos" is what Steam writes into config.vdf; it must never change.
"compatibilitytools"
{
  "compat_tools"
  {
    "proton-cachyos"
    {
      "install_path" "."
      "display_name" "Proton-CachyOS @VER@ (ARM64)"
      "from_oslist"  "windows"
      "to_oslist"    "linux"
    }
  }
}
