#!/bin/bash
# A loop, not an exec: this stays the logind session leader across switches. A fresh session
# per switch leaves kwin without DRM master.

# No login shell runs here; profile.d still has to (locale, flatpak XDG_DATA_DIRS).
[ -r /etc/profile ] && . /etc/profile

# "plasma" means desktop mode, whichever desktop pocknix-desktop-select picks: it is the word
# Steam passes to steamos-session-select.
STATE="${XDG_STATE_HOME:-${HOME}/.local/state}/pocknix-session"
PIDFILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pocknix-desktop.pid"
SWITCH="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pocknix-session.switch"
LOG="${HOME}/pocknix-session.log"

if [ -e "${HOME}/.no-steam" ]; then
  echo "pocknix-session: ~/.no-steam present, leaving tty1 to a login prompt" >&2
  exit 3
fi

# tty1 shows between compositors.
blank() { printf '\033[?25l\033[2J\033[H' >/dev/tty 2>/dev/null; }

# The whole login session is our cgroup, including what got re-parented to PID 1 when its
# parent died (gamescope's reaper, Xwayland), which a walk of our children would miss.
SCOPE="/sys/fs/cgroup$(sed -n 's/^0:://p' /proc/self/cgroup)/cgroup.procs"

# Builtins only, so no helper of ours shows up. (sd-pam) holds the PAM session: killing it
# would end the logind session.
leftovers() {
  local p c
  while read -r p; do
    [ "${p}" = "$$" ] || [ "${p}" = "${BASHPID}" ] && continue
    read -r c < "/proc/${p}/comm" 2>/dev/null
    [ "${c}" = "(sd-pam)" ] || echo "${p}"
  done < "${SCOPE}"
}

sweep() {  # <TERM|KILL>; TERM escalates to KILL after 3s
  local pids t
  mapfile -t pids < <(leftovers)
  [ "${#pids[@]}" -gt 0 ] || return 0
  echo "pocknix-session: ${1} to what the last session left: ${pids[*]}" >&2
  kill -"$1" "${pids[@]}" 2>/dev/null
  [ "$1" = TERM ] || return 0
  for t in 1 2 3; do
    sleep 1
    mapfile -t pids < <(leftovers)
    [ "${#pids[@]}" -gt 0 ] || return 0
  done
  kill -KILL "${pids[@]}" 2>/dev/null
}

# A switch only TERMs the compositor, and one TERM-proof straggler (Wine stuck in ntsync) keeps
# the launcher open forever: whatever is left 6s after a switch, or after the launcher, is killed.
run() {  # <launcher>
  local child t=0
  # Append mode for both writers: a truncating fd would overwrite lines written meanwhile.
  : >"${LOG}"
  "$1" >>"${LOG}" 2>&1 &
  child=$!
  while kill -0 "${child}" 2>/dev/null; do
    sleep 1
    [ -e "${SWITCH}" ] || continue
    t=$(( t + 1 ))
    [ "${t}" -ge 6 ] && { sweep KILL; break; }
  done
  wait "${child}" 2>/dev/null
  sweep TERM
}

# Plasma 6's kwin is a user service that outlives its launcher by seconds, so the next compositor
# lacks DRM master and modesets black. Stopping graphical-session.target only queues kwin's stop.
release_display() {
  local holder i
  timeout 15 systemctl --user stop graphical-session.target \
    || echo "pocknix-session: stopping graphical-session.target failed (rc $?)" >&2
  for i in $(seq 1 50); do
    # kwin's file caps make its fds root-owned, invisible to the card scan: for a service
    # compositor the user manager's pending jobs and deactivating units are the signal.
    holder="$(systemctl --user list-jobs --no-legend --plain 2>/dev/null | head -1)"
    [ -n "${holder}" ] || holder="$(systemctl --user list-units --state=deactivating \
      --no-legend --plain 2>/dev/null | head -1)"
    [ -n "${holder}" ] || holder="$(find /proc/[0-9]*/fd -lname '/dev/dri/card*' -print -quit 2>/dev/null)"
    if [ -z "${holder}" ]; then
      [ "${i}" -gt 1 ] && echo "pocknix-session: display released after $(( (i - 1) * 200 ))ms" >&2
      return 0
    fi
    sleep 0.2
  done
  echo "pocknix-session: ${holder} still holds the display after 10s, starting anyway" >&2
}

# gamescope clears the msm DPU_3D_LUT only on a clean exit and kwin does not know the property,
# so after a gamescope crash the desktop would run with its 3D LUT still applied.
clear_output_luts() {
  local crtc prop
  command -v proptest >/dev/null 2>&1 || return 0
  proptest -M msm 2>/dev/null | awk '/^CRTC /{c=$2} /^\t[0-9]+ DPU_3D_LUT:/{print c, $1}' |
    while read -r crtc prop; do
      proptest -M msm "${crtc}" crtc "${prop}" 0 >/dev/null 2>&1 \
        || echo "pocknix-session: could not clear DPU_3D_LUT on CRTC ${crtc}" >&2
    done
}

fastfails=0
while true; do
  session="$(cat "${STATE}" 2>/dev/null || echo gamescope)"
  rm -f "${SWITCH}"
  blank
  # Before the clock starts: time spent waiting here is no evidence the session works.
  release_display
  clear_output_luts
  start="$(date +%s)"
  case "${session}" in
    plasma|desktop) command -v pocknix-desktop >/dev/null 2>&1 && run pocknix-desktop
                    rm -f "${PIDFILE}" ;;  # a recycled PID must never be signalled as the session
    *)              if command -v pocknix-steam >/dev/null 2>&1; then
                      # --no-block: a slow game-session unit must never hold up Steam.
                      systemctl --user start --no-block pocknix-game-session.target
                      run pocknix-steam
                    fi ;;
  esac
  # Under 5s is a broken session, not a switch.
  if [ "$(( $(date +%s) - start ))" -lt 5 ]; then
    fastfails=$(( fastfails + 1 ))
    # Desktop mode can be gone or broken (the desktop layer is removable) while Steam still
    # offers it; game mode is the screen that always has a way back.
    if [ "${fastfails}" -ge 3 ] && [ "${session}" != gamescope ]; then
      echo "pocknix-session: desktop mode keeps exiting immediately, back to game mode" >&2
      printf 'gamescope\n' > "${STATE}"
      fastfails=0
    elif [ "${fastfails}" -ge 3 ]; then
      printf '\033[?25h' >/dev/tty 2>/dev/null
      echo "pocknix-session: '${session}' keeps exiting immediately, see ${LOG}" >&2
      exit 3
    fi
  else
    fastfails=0
  fi
done
