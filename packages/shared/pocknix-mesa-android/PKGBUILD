# pocknix-mesa-android — Mesa (freedreno + zink + turnip) and the Fossilize layer built against
# bionic, as the Android vendor tree Lepton binds into its container.
pkgname=pocknix-mesa-android
# epoch=2: pacman compares epoch before pkgver, and this name has only ever shipped at epoch 2.
epoch=2
pkgver=26.2.6
# differs from pkgver only for RCs: the tarball keeps the hyphen makepkg forbids in pkgver
_srcver=${pkgver}
pkgrel=1
pkgdesc="Mesa (freedreno + zink + turnip) and the Fossilize layer built against bionic, as an Android vendor tree"
arch=('aarch64')
url="https://www.mesa3d.org/"
# The static libc++ and the NDK compiler-rt archives link in Apache-2.0 WITH LLVM-exception code.
license=("MIT AND BSD-3-Clause AND SGI-B-2.0 AND Apache-2.0 WITH LLVM-exception")
depends=()
makedepends=(meson ninja python-mako python-packaging python-yaml python-ply glslang
             clang lld llvm cmake)
# bionic ELF: makepkg's glibc-oriented strip/debug split has nothing to do here
options=(!strip !debug)
# The NDK's own clang is x86_64-only, so the host clang links against the NDK sysroot and
# its prebuilt aarch64-android compiler-rt instead. Lepton's rootfs is Android 11 (API 30).
_ndkver=r28c
_androidapi=30
# The fleet's oldest core (sm8250's A77): one binary serves every SoC, and armv9 objects
# SIGILL there. -mtune stays off: the big.LITTLE spellings are GCC-only.
_march=-march=armv8.2-a+crypto+crc+fp+simd
# libdrm.wrap's pin in this mesa release; bionic has no libdrm, so meson builds the fallback.
_libdrmver=2.4.133
# Lepton aborts without the Fossilize capture layer; rapidjson is Fossilize's submodule at
# that commit.
_fossilizecommit=556da9ff7d7616704dda515756219ab1dab693ec
_rapidjsoncommit=8f4c021fa2f1e001d2376095928fc0532adf2ae6
source=("https://archive.mesa3d.org/mesa-${_srcver}.tar.xz"
        "https://dl.google.com/android/repository/android-ndk-${_ndkver}-linux.zip"
        "https://dri.freedesktop.org/libdrm/libdrm-${_libdrmver}.tar.xz"
        "fossilize-${_fossilizecommit}.tar.gz::https://github.com/ValveSoftware/Fossilize/archive/${_fossilizecommit}.tar.gz"
        "rapidjson-${_rapidjsoncommit}.tar.gz::https://github.com/miloyip/rapidjson/archive/${_rapidjsoncommit}.tar.gz")
noextract=("android-ndk-${_ndkver}-linux.zip" "libdrm-${_libdrmver}.tar.xz")
sha256sums=('b9436b3e1a8be76fbd4823dc884f90596ab7c6ac5e1867a305e66ffccfb31a92'
            'dfb20d396df28ca02a8c708314b814a4d961dc9074f9a161932746f815aa552f'
            'fc68f9d0ba2ea63c9432a299e14fea09fad7a8a66e8039fcd7802ca59f77b4f5'
            '2802294470007bd71bc36b169bebde25d63008c4ad65a84d288741b33d7d27e1'
            '3c8e1044b9b3226ff839663ff482b00750ca7dedb53026f8d8a31999865b8466')

prepare() {
  cd "mesa-${_srcver}"
  # package release in the version string, which SurfaceFlinger's GLES line shows
  echo "${pkgver}-pocknix${epoch}.${pkgrel}" > VERSION
  # meson takes a hash-matching tarball from packagecache instead of downloading it
  install -Dm644 "${srcdir}/libdrm-${_libdrmver}.tar.xz" -t subprojects/packagecache

  cd "${srcdir}"
  local _ndkllvm="android-ndk-${_ndkver}/toolchains/llvm/prebuilt/linux-x86_64"
  bsdtar -xf "android-ndk-${_ndkver}-linux.zip" "${_ndkllvm}/sysroot" "${_ndkllvm}/lib/clang"
  # Headers must match the compiler that reads them (host clang); runtime archives must be
  # the NDK's, since the host clang ships none for android.
  rm -rf android-rd && mkdir -p android-rd/lib
  cp -r "$(clang -print-resource-dir)/include" android-rd/
  cp -r "${_ndkllvm}"/lib/clang/*/lib/linux android-rd/lib/
}

build() {
  local _ndk="${srcdir}/android-ndk-${_ndkver}/toolchains/llvm/prebuilt/linux-x86_64"
  local _cc="'--target=aarch64-linux-android${_androidapi}', '--sysroot=${_ndk}/sysroot', '-resource-dir=${srcdir}/android-rd'"
  # Static libc++, no exceptions or unwind tables: the outputs need no libc++_shared.so and import
  # no unwinder, so they load against the image's bionic libs alone.
  cat > "${srcdir}/android-cross.ini" <<END
[binaries]
c = ['clang', ${_cc}]
cpp = ['clang++', ${_cc}]
ar = 'llvm-ar'
strip = 'llvm-strip'
c_ld = 'lld'
cpp_ld = 'lld'

[built-in options]
c_args = ['${_march}']
cpp_args = ['${_march}', '-fno-exceptions', '-fno-unwind-tables', '-fno-asynchronous-unwind-tables']
cpp_link_args = ['-static-libstdc++']

[host_machine]
system = 'android'
cpu_family = 'aarch64'
cpu = 'aarch64'
endian = 'little'
END

  # makepkg's glibc flags must not reach the bionic objects. gbm-backends-path: gralloc dlopens
  # dri_gbm from there. nodownload: optional fallbacks stay unfound instead of fetched mid-build.
  env -u CFLAGS -u CXXFLAGS -u CPPFLAGS -u LDFLAGS \
  meson setup build-android "mesa-${_srcver}" --cross-file "${srcdir}/android-cross.ini" \
    --wrap-mode=nodownload \
    --buildtype=release \
    -Db_ndebug=true \
    -Dplatforms=android \
    -Dplatform-sdk-version=${_androidapi} \
    -Dandroid-stub=true \
    -Dandroid-strict=false \
    -Dandroid-libbacktrace=disabled \
    -Dgallium-drivers=freedreno,zink \
    -Dvulkan-drivers=freedreno \
    -Dfreedreno-kmds=msm \
    -Degl=enabled \
    -Dgbm=enabled \
    -Dgbm-backends-path=/vendor/lib64 \
    -Dllvm=disabled \
    -Dallow-fallback-for=libdrm \
    -Dbuild-tests=false
  meson compile -C build-android

  # Not the NDK's cmake toolchain file (it hardcodes the x86_64 prebuilt compilers), so ANDROID
  # is set by hand: the cmake var for liblog, the macro for the shm_open guard.
  env -u CFLAGS -u CXXFLAGS -u CPPFLAGS -u LDFLAGS \
  cmake -S "Fossilize-${_fossilizecommit}" -B build-fossilize -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_SYSTEM_NAME=Linux \
    -DCMAKE_SYSTEM_PROCESSOR=aarch64 \
    -DCMAKE_C_COMPILER=clang \
    -DCMAKE_CXX_COMPILER=clang++ \
    -DCMAKE_C_COMPILER_TARGET=aarch64-linux-android${_androidapi} \
    -DCMAKE_CXX_COMPILER_TARGET=aarch64-linux-android${_androidapi} \
    -DCMAKE_SYSROOT="${_ndk}/sysroot" \
    -DCMAKE_C_FLAGS="-resource-dir=${srcdir}/android-rd ${_march} -DANDROID" \
    -DCMAKE_CXX_FLAGS="-resource-dir=${srcdir}/android-rd ${_march} -DANDROID" \
    -DCMAKE_SHARED_LINKER_FLAGS="-fuse-ld=lld -static-libstdc++" \
    -DANDROID=ON \
    -DFOSSILIZE_RAPIDJSON_INCLUDE_PATH="${srcdir}/rapidjson-${_rapidjsoncommit}/include" \
    -DFOSSILIZE_CLI=OFF \
    -DFOSSILIZE_TESTS=OFF
  cmake --build build-fossilize --target VkLayer_fossilize
}

package() {
  # Android's loaders match these by filename, not soname. Real files in the tree Lepton binds
  # into its container's /vendor: it mounts only regular files from there, never symlinks.
  local b=build-android d="${pkgdir}/usr/share/guestos/android/vendor"
  local v="$d/lib64"
  install -Dm644 $b/src/freedreno/vulkan/libvulkan_freedreno.so "$v/hw/vulkan.freedreno.so"
  install -Dm644 $b/src/gallium/targets/dri/libgallium_dri.so   "$v/libgallium_dri.so"
  install -Dm644 $b/src/gbm/libgbm_mesa.so                      "$v/libgbm_mesa.so"
  install -Dm644 $b/src/gbm/backends/dri/dri_gbm.so             "$v/dri_gbm.so"
  install -Dm644 $b/src/egl/libEGL.so                           "$v/egl/libEGL_mesa.so"
  install -Dm644 $b/src/mesa/glapi/es2api/libGLESv2.so          "$v/egl/libGLESv2_mesa.so"
  install -Dm644 $b/src/mesa/glapi/es1api/libGLESv1_CM.so       "$v/egl/libGLESv1_CM_mesa.so"
  install -Dm644 build-fossilize/layer/libVkLayer_fossilize.so "$d/vulkan_layers/libVkLayer_fossilize.so"

  install -Dm644 "mesa-${_srcver}/docs/license.rst" -t "${pkgdir}/usr/share/licenses/${pkgname}"
  install -Dm644 "Fossilize-${_fossilizecommit}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.fossilize"
}
