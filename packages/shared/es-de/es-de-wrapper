#!/bin/bash
# SDL2 discards joystick events while no SDL window has keyboard focus, and the ES-DE window
# comes back from suspend without it; ES-DE sets no hint of its own. Game mode never loses focus.
STATE_HOME="${XDG_STATE_HOME:-${HOME:-/home/deck}/.local/state}"
if [ "$(cat "${STATE_HOME}/pocknix-session" 2>/dev/null)" = "plasma" ]; then
  export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1
fi

exec /opt/pocknix/es-de/ES-DE.AppImage "$@"
