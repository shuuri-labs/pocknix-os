#!/bin/sh
# 0xFF = the kernel PM path and every post-resume hook completed; see the pre hook.
case "$(tr '\0' ' ' < /proc/device-tree/compatible 2>/dev/null)" in
  *qcom,sm8550*) ;;
  *) exit 0 ;;
esac
printf '\xFF' | dd of=/sys/bus/nvmem/devices/spmi_sdam0/nvmem \
  bs=1 count=1 seek=80 conv=notrunc 2>/dev/kmsg \
  || echo "003-sdam-debug: SDAM write failed" >/dev/kmsg
