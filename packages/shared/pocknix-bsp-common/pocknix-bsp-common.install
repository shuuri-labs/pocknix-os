_enable_fan_lavd() {
  systemctl enable pocknix-fancontrol.service pocknix-lavd.service 2>/dev/null || true
}

# Old images' overlay copies (/etc units shadow /usr/lib, enable links point at /etc) must go.
# Only that migration re-enables: a plain upgrade must keep a unit the user disabled off.
_migrate_fan_lavd() {
  legacy=
  for f in /usr/local/bin/pocknix-fancontrol /usr/local/bin/pocknix-fan-mode \
           /usr/local/bin/pocknix-lavd-mode \
           /etc/systemd/system/pocknix-fancontrol.service \
           /etc/systemd/system/pocknix-lavd.service \
           /etc/tmpfiles.d/pocknix-game-mode.conf; do
    [ -e "${f}" ] && { legacy=1; rm -f "${f}"; }
  done
  [ -d /run/systemd/system ] || return 0
  systemctl daemon-reload
  systemd-tmpfiles --create /usr/lib/tmpfiles.d/pocknix-game-mode.conf 2>/dev/null || true
  [ -n "${legacy}" ] && _enable_fan_lavd
  systemctl try-restart pocknix-fancontrol.service pocknix-lavd.service 2>/dev/null || true
}

# pocknix-powerd is retired (logind owns the power key). Stop nothing: until the reboot into the
# patched kernel, the running powerd and logind's old setting stop the wake press re-suspending.
_retire_powerd() {
  rm -f /usr/local/bin/pocknix-powerd /etc/systemd/system/pocknix-powerd.service \
        /etc/systemd/system/multi-user.target.wants/pocknix-powerd.service
  [ -d /run/systemd/system ] && systemctl daemon-reload
  return 0
}

# The image overlay's root helper that held gamescope at RR 40 is retired; gamescope's threads
# stay RR until the session restarts.
_retire_gamescope_rt() {
  [ -d /run/systemd/system ] && systemctl disable --now pocknix-gamescope-rt.service 2>/dev/null
  rm -f /usr/local/bin/pocknix-gamescope-rt /etc/systemd/system/pocknix-gamescope-rt.service \
        /etc/systemd/system/multi-user.target.wants/pocknix-gamescope-rt.service
  return 0
}

# 60-pocknix-deck.conf replaces the overlay's limits file. Only the two versions the overlay
# shipped are removed; a user-edited copy is left in place.
_retire_gaming_limits() {
  f=/etc/security/limits.d/60-pocknix-gaming.conf
  [ -f "${f}" ] || return 0
  case "$(sha256sum "${f}" | cut -d' ' -f1)" in
    036a0245493fff6c5afaecc71970ba50f159e075a1d23acc5481799044fe7fab|\
    2ad0dda0f16e3ee1951821eb156f55c6a35dbe65d33f0f7c997ab7615d41139e) rm -f "${f}" ;;
  esac
}

# The image overlay's 50-pocknix-deck.rules granted wheel every systemd1 action; its parts now
# ship packaged and narrowed. Only the seven shipped versions go: a user-edited copy stays.
_retire_deck_polkit() {
  f=/etc/polkit-1/rules.d/50-pocknix-deck.rules
  [ -f "${f}" ] || return 0
  case "$(sha256sum "${f}" | cut -d' ' -f1)" in
    04c269f5a6692aca3e73e7c59dac83c77a6ebd1e7bbe04f3551494951ca39b20|\
    0e907c81015d66b9362331f859f49f026d389a1449506763c794192c09fe667d|\
    327be8461c398755465e063b60e67395a88516280454fd43db1361f1f94c8edf|\
    70fedc281d17cf28605a9e8c6c9addbd90429435acce252aaaf6c2deb2e880d3|\
    743d088ad5659580a998b38bf5d54bed5a586c016ac98372cbbe4accce147b1a|\
    7f1d6e20758e93150e196be6e141ae03b7799f7b9052249b1d731a328b11b5af|\
    c11c5c5f00825ad2a94e2a611a6decb431c2f00264e5e8360a5c738aa185bef7) rm -f "${f}" ;;
  esac
}

# The image overlay shipped these defaults unowned; the packaged copies carry new names (an unowned
# file at a packaged path aborts -Syu). /usr/lib copies go outright, /etc ones only unedited.
_retire_overlay_defaults() {
  rm -f /usr/lib/sysctl.d/60-pocknix-gaming.conf /usr/lib/systemd/journald.conf.d/10-pocknix-flash.conf
  f=/etc/systemd/zram-generator.conf
  if [ -f "${f}" ]; then
    case "$(sha256sum "${f}" | cut -d' ' -f1)" in
      583cbd04f6f2e2bf4ed185017ee807e1cd98f81137cc9d7d562d182662905adb|\
      e96f8062c3af11628e6add631d27369931790d48c442c4fbe774de55264c2c4f) rm -f "${f}" ;;
    esac
  fi
  f=/etc/NetworkManager/conf.d/20-wifi-backend.conf
  if [ -f "${f}" ]; then
    case "$(sha256sum "${f}" | cut -d' ' -f1)" in
      35eb1e312c4d99575a7d517c8820c5eca9c84673b18a69fa5b54fdb2d4bd7a9a|\
      fe419f1e47ec9628194de10c6f2f3e14cb3e77e7e6238692fa9daf00d71baa41) rm -f "${f}" ;;
    esac
  fi
  return 0
}

# Enabled by its wants symlink; restart picks up a new daemon or profile file without a reboot.
_perfd() {
  [ -d /run/systemd/system ] || return 0
  systemctl daemon-reload
  systemctl reload dbus.service 2>/dev/null || true
  systemctl restart pocknix-perfd.service 2>/dev/null || true
}

# Applies the kernel-thread priorities now rather than at the next boot; reruns are harmless.
_rt_ladder() {
  [ -d /run/systemd/system ] || return 0
  systemctl restart --no-block pocknix-rt-ladder.service 2>/dev/null || true
}

post_install() {
  _migrate_fan_lavd
  [ -d /run/systemd/system ] && _enable_fan_lavd
  _retire_powerd
  _retire_gamescope_rt
  _retire_gaming_limits
  _retire_deck_polkit
  _retire_overlay_defaults
  _perfd
  _rt_ladder
}

post_upgrade() {
  _migrate_fan_lavd
  _retire_powerd
  _retire_gamescope_rt
  _retire_gaming_limits
  _retire_deck_polkit
  _retire_overlay_defaults
  _perfd
  _rt_ladder
}
