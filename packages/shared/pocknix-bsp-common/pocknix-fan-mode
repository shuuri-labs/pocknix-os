#!/bin/sh
# pocknix-fan-mode — get/set the pocknix-fancontrol curve (companion to pocknix-lavd-mode).
#
# Persisted in /var/lib/pocknix/fan-mode, which pocknix-fancontrol re-reads every tick, so a set
# is just the file write. Unknown/absent values fall back to quiet (the default).
#
#   pocknix-fan-mode                # print the current mode
#   pocknix-fan-mode moderate       # set a mode (quiet|moderate|performance)
#   pocknix-fan-mode charging [0-255]   # get/set the minimum speed while plugged in, awake or asleep (0 = off, default 51)
MODE_FILE=/var/lib/pocknix/fan-mode
CHARGING_FILE=/var/lib/pocknix/fan-charging
# Must match pocknix-fancontrol's CHARGING_DEFAULT and Pocknix Tools' Low step.
CHARGING_DEFAULT=51
DEFAULT=quiet

case "${1:-}" in
  "")
    m="$(cat "${MODE_FILE}" 2>/dev/null)"
    case "${m}" in quiet|moderate|performance) ;; *) m="${DEFAULT}" ;; esac
    printf '%s\n' "${m}"
    ;;
  quiet|moderate|performance)
    mkdir -p "$(dirname "${MODE_FILE}")" 2>/dev/null
    if ! printf '%s\n' "${1}" > "${MODE_FILE}" 2>/dev/null; then
      echo "pocknix-fan-mode: cannot write ${MODE_FILE} (run as root)" >&2
      exit 1
    fi
    echo "fan mode: ${1}"
    ;;
  charging)
    if [ -z "${2:-}" ]; then
      v="$(cat "${CHARGING_FILE}" 2>/dev/null)"
      case "${v}" in ''|*[!0-9]*) v="${CHARGING_DEFAULT}" ;; esac
      printf '%s\n' "${v}"
      exit 0
    fi
    case "${2}" in *[!0-9]*) echo "pocknix-fan-mode: charging takes 0-255" >&2; exit 2 ;; esac
    [ "${2}" -le 255 ] || { echo "pocknix-fan-mode: charging takes 0-255" >&2; exit 2; }
    mkdir -p "$(dirname "${CHARGING_FILE}")" 2>/dev/null
    if ! printf '%s\n' "${2}" > "${CHARGING_FILE}" 2>/dev/null; then
      echo "pocknix-fan-mode: cannot write ${CHARGING_FILE} (run as root)" >&2
      exit 1
    fi
    echo "minimum fan speed while charging: ${2}"
    ;;
  *)
    echo "usage: pocknix-fan-mode [quiet|moderate|performance | charging [0-255]]" >&2
    exit 2
    ;;
esac
