# pocknix-bsp-common — the device-NEUTRAL board support shared by every pocknix device.
# Device-specific quirks (input maps, audio UCM, SoC suspend/cpuidle tweaks, device.conf)
# live in devices/<name>/packages/pocknix-bsp-<name>, which depends on this package.
pkgname=pocknix-bsp-common
pkgver=0.1.0
pkgrel=30
pkgdesc="pocknix shared board support: sleep.d dispatcher, suspend hooks, power-key policy, session udev rules, wheel sudo, fan/scheduler daemons, ABL updater, second-screen touch policy, power profiles daemon, realtime priority ladder, deck session limits, kernel /flash deploy, coredump storage cap, speaker DSP"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL-2.0-or-later')
# pocknix-core rides along so a plain -Syu delivers the mandatory layer to devices that
# predate it: a new package name only reaches installed devices via a dep edge.
# swh-plugins: the LADSPA lookahead limiter at the end of the speaker DSP chain.
depends=('sudo' 'pocknix-core' 'python' 'python-gobject' 'cpio' 'swh-plugins')
# Older kernels own the /flash deploy files: the versioned conflict makes pacman upgrade the
# kernel in the same transaction instead of failing on file conflicts.
conflicts=('linux-pocknix-sm8550<7.2.10-3' 'linux-pocknix-sm8250<7.2.10-4')
optdepends=('scx-scheds: scx_lavd for pocknix-lavd.service (unit self-skips without it)')
install=pocknix-bsp-common.install
backup=('etc/security/limits.d/60-pocknix-deck.conf')
source=('pocknix-sleep'
        'drain-log-pre' 'drain-log-post'
        'usb-role-sleep-pre' 'usb-role-sleep-post'
        '20-pocknix-powerkey.conf' '50-pocknix-coredump.conf'
        '90-pocknix-backlight.rules' '60-pocknix-controllers.rules'
        '10-pocknix-wheel'
        'pocknix-fancontrol' 'pocknix-fan-mode' 'pocknix-lavd-mode'
        'pocknix-fancontrol.service' 'pocknix-lavd.service' 'pocknix-game-mode.conf'
        'pocknix-update-abl' '52-pocknix-abl.rules' 'pocknix-gpt-abl'
        'pocknix-refresh-abl-kit'
        'pocknix-gamepad-target' 'pocknix-gamepad-target.service'
        'pocknix-second-screen' 'pocknix-second-screen.service'
        'iwd-wait-wlan0.conf'
        'pocknix-perfd' 'pocknix_perf.py' 'pocknix-perf' 'pocknix-perfd.service'
        'org.pocknix.Perf.service' 'org.pocknix.Perf.conf' 'power-profiles.conf'
        '60-pocknix-sdl-xb360.conf' 'pocknix-sdl-xb360.sh'
        'pocknix-rt-ladder' 'pocknix-rt-ladder.service' 'rtkit-limits.conf'
        '60-pocknix-deck.conf'
        'pocknix-cmdline-sync' '91-pocknix-cmdline.hook' 'cores.sh'
        'pocknix-boot-deploy' 'pocknix-build-bootimg' 'pocknix-update-boot' '90-linux-pocknix.hook'
        'pocknix-speaker-dsp' 'pocknix-speaker-dsp-render' 'pocknix-speaker-dsp.service')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 "${srcdir}/pocknix-sleep" \
    "${pkgdir}/usr/lib/systemd/system-sleep/pocknix-sleep"

  # sleep.d hooks run in name order; the numeric prefixes are that ordering.
  install -Dm755 "${srcdir}/usb-role-sleep-pre" \
    "${pkgdir}/usr/lib/pocknix/sleep.d/pre/002-usb-role"
  install -Dm755 "${srcdir}/usb-role-sleep-post" \
    "${pkgdir}/usr/lib/pocknix/sleep.d/post/002-usb-role"
  install -Dm755 "${srcdir}/drain-log-pre" \
    "${pkgdir}/usr/lib/pocknix/sleep.d/pre/004-drain-log"
  install -Dm755 "${srcdir}/drain-log-post" \
    "${pkgdir}/usr/lib/pocknix/sleep.d/post/004-drain-log"

  install -Dm644 "${srcdir}/20-pocknix-powerkey.conf" \
    "${pkgdir}/usr/lib/systemd/logind.conf.d/20-pocknix-powerkey.conf"
  install -Dm644 "${srcdir}/50-pocknix-coredump.conf" \
    "${pkgdir}/usr/lib/systemd/coredump.conf.d/50-pocknix-coredump.conf"

  install -Dm644 "${srcdir}/90-pocknix-backlight.rules" \
    "${pkgdir}/usr/lib/udev/rules.d/90-pocknix-backlight.rules"
  install -Dm644 "${srcdir}/60-pocknix-controllers.rules" \
    "${pkgdir}/usr/lib/udev/rules.d/60-pocknix-controllers.rules"

  # 0440 is a sudoers.d requirement: sudo skips group/world-writable files.
  install -Dm440 "${srcdir}/10-pocknix-wheel" \
    "${pkgdir}/etc/sudoers.d/10-pocknix-wheel"

  install -Dm755 "${srcdir}/pocknix-fancontrol" "${pkgdir}/usr/bin/pocknix-fancontrol"
  install -Dm755 "${srcdir}/pocknix-fan-mode"   "${pkgdir}/usr/bin/pocknix-fan-mode"
  install -Dm755 "${srcdir}/pocknix-lavd-mode"  "${pkgdir}/usr/bin/pocknix-lavd-mode"
  install -Dm644 "${srcdir}/pocknix-fancontrol.service" \
    "${pkgdir}/usr/lib/systemd/system/pocknix-fancontrol.service"
  install -Dm644 "${srcdir}/pocknix-lavd.service" \
    "${pkgdir}/usr/lib/systemd/system/pocknix-lavd.service"
  install -Dm644 "${srcdir}/pocknix-game-mode.conf" \
    "${pkgdir}/usr/lib/tmpfiles.d/pocknix-game-mode.conf"

  install -Dm755 "${srcdir}/pocknix-update-abl" "${pkgdir}/usr/bin/pocknix-update-abl"
  # Not in PATH: it writes a partition table, and has exactly one caller.
  install -Dm755 "${srcdir}/pocknix-gpt-abl" "${pkgdir}/usr/lib/pocknix/pocknix-gpt-abl"
  install -Dm755 "${srcdir}/pocknix-refresh-abl-kit" "${pkgdir}/usr/bin/pocknix-refresh-abl-kit"
  install -Dm644 "${srcdir}/52-pocknix-abl.rules" \
    "${pkgdir}/usr/share/polkit-1/rules.d/52-pocknix-abl.rules"

  # Enabled by a wants symlink rather than an enable hook: it is pulled in by InputPlumber itself.
  install -Dm755 "${srcdir}/pocknix-gamepad-target" "${pkgdir}/usr/bin/pocknix-gamepad-target"
  install -Dm644 "${srcdir}/pocknix-gamepad-target.service" \
    "${pkgdir}/usr/lib/systemd/system/pocknix-gamepad-target.service"
  install -d "${pkgdir}/usr/lib/systemd/system/inputplumber.service.wants"
  ln -sf "../pocknix-gamepad-target.service" \
    "${pkgdir}/usr/lib/systemd/system/inputplumber.service.wants/pocknix-gamepad-target.service"
  install -Dm644 "${srcdir}/60-pocknix-sdl-xb360.conf" \
    "${pkgdir}/usr/lib/environment.d/60-pocknix-sdl-xb360.conf"
  install -Dm644 "${srcdir}/pocknix-sdl-xb360.sh" "${pkgdir}/etc/profile.d/pocknix-sdl-xb360.sh"

  # Dual-screen boards (device.conf POCKNIX_TOUCH2_NAME): a no-op everywhere else.
  install -Dm755 "${srcdir}/pocknix-second-screen" "${pkgdir}/usr/bin/pocknix-second-screen"
  install -Dm644 "${srcdir}/pocknix-second-screen.service" \
    "${pkgdir}/usr/lib/systemd/system/pocknix-second-screen.service"

  install -Dm644 "${srcdir}/iwd-wait-wlan0.conf" \
    "${pkgdir}/usr/lib/systemd/system/iwd.service.d/10-pocknix-wait-wlan0.conf"

  install -Dm755 "${srcdir}/pocknix-perfd" "${pkgdir}/usr/lib/pocknix/pocknix-perfd"
  install -Dm644 "${srcdir}/pocknix_perf.py" "${pkgdir}/usr/lib/pocknix/pocknix_perf.py"
  install -Dm755 "${srcdir}/pocknix-perf" "${pkgdir}/usr/bin/pocknix-perf"
  install -Dm644 "${srcdir}/power-profiles.conf" "${pkgdir}/usr/share/pocknix/power-profiles.conf"
  install -Dm644 "${srcdir}/pocknix-perfd.service" "${pkgdir}/usr/lib/systemd/system/pocknix-perfd.service"
  install -d "${pkgdir}/usr/lib/systemd/system/multi-user.target.wants"
  ln -sf "../pocknix-perfd.service" "${pkgdir}/usr/lib/systemd/system/multi-user.target.wants/pocknix-perfd.service"
  install -Dm644 "${srcdir}/org.pocknix.Perf.service" "${pkgdir}/usr/share/dbus-1/system-services/org.pocknix.Perf.service"
  install -Dm644 "${srcdir}/org.pocknix.Perf.conf" "${pkgdir}/usr/share/dbus-1/system.d/org.pocknix.Perf.conf"

  install -Dm644 "${srcdir}/cores.sh" "${pkgdir}/usr/lib/pocknix/cores.sh"
  install -Dm755 "${srcdir}/pocknix-rt-ladder" "${pkgdir}/usr/lib/pocknix/pocknix-rt-ladder"
  install -Dm644 "${srcdir}/pocknix-rt-ladder.service" "${pkgdir}/usr/lib/systemd/system/pocknix-rt-ladder.service"
  ln -sf "../pocknix-rt-ladder.service" "${pkgdir}/usr/lib/systemd/system/multi-user.target.wants/pocknix-rt-ladder.service"
  install -Dm644 "${srcdir}/rtkit-limits.conf" \
    "${pkgdir}/usr/lib/systemd/system/rtkit-daemon.service.d/10-pocknix-limits.conf"
  install -Dm644 "${srcdir}/60-pocknix-deck.conf" "${pkgdir}/etc/security/limits.d/60-pocknix-deck.conf"

  install -Dm755 "${srcdir}/pocknix-boot-deploy" "${pkgdir}/usr/lib/pocknix/pocknix-boot-deploy"
  install -Dm755 "${srcdir}/pocknix-build-bootimg" "${pkgdir}/usr/bin/pocknix-build-bootimg"
  install -Dm755 "${srcdir}/pocknix-update-boot" "${pkgdir}/usr/bin/pocknix-update-boot"
  install -Dm644 "${srcdir}/90-linux-pocknix.hook" \
    "${pkgdir}/usr/share/libalpm/hooks/90-linux-pocknix.hook"
  # qcom-abl boot images bake the cmdline in; inert on other boot styles.
  install -Dm755 "${srcdir}/pocknix-cmdline-sync" "${pkgdir}/usr/lib/pocknix/pocknix-cmdline-sync"
  install -Dm644 "${srcdir}/91-pocknix-cmdline.hook" \
    "${pkgdir}/usr/share/libalpm/hooks/91-pocknix-cmdline.hook"

  # Speaker DSP: started with the user's PipeWire; boards opt in through device.conf.
  install -Dm755 "${srcdir}/pocknix-speaker-dsp" "${pkgdir}/usr/bin/pocknix-speaker-dsp"
  install -Dm755 "${srcdir}/pocknix-speaker-dsp-render" "${pkgdir}/usr/lib/pocknix/pocknix-speaker-dsp-render"
  install -Dm644 "${srcdir}/pocknix-speaker-dsp.service" \
    "${pkgdir}/usr/lib/systemd/user/pocknix-speaker-dsp.service"
  install -d "${pkgdir}/usr/lib/systemd/user/pipewire.service.wants"
  ln -sf "../pocknix-speaker-dsp.service" \
    "${pkgdir}/usr/lib/systemd/user/pipewire.service.wants/pocknix-speaker-dsp.service"
}
