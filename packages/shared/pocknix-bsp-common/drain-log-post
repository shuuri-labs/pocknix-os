#!/bin/sh
s=/run/pocknix/drain-log
[ -f "$s" ] || exit 0
read -r t0 c0 v0 < "$s"
rm -f "$s"
c1=$(cat /sys/class/power_supply/battery/charge_counter 2>/dev/null)
[ -n "$c1" ] || c1=$(cat /sys/class/power_supply/battery/charge_now 2>/dev/null)
irq=$(cat /sys/power/pm_wakeup_irq 2>/dev/null)
name=$(awk -v i="${irq}:" '$1 == i { print $NF }' /proc/interrupts 2>/dev/null)
if [ -n "$c0" ] && [ -n "$c1" ]; then
  secs=$(( $(date +%s) - t0 ))
  used=$(awk -v a="$c0" -v b="$c1" -v v="${v0:-0}" -v t="$secs" 'BEGIN {
    u = a - b
    if (t <= 0) { printf "0uAh, 0 mA avg, 0 mW" ; exit }
    printf "%duAh, %.1f mA avg, %.1f mW", u, u * 3600 / t / 1000, u * v * 0.0036 / t / 1000
  }')
else
  secs=0; used="no charge sensor"
fi
line="004-drain-log: slept ${secs}s, ${used}, woke by irq ${irq:-none} ${name}"
echo "$line" > /dev/kmsg
# kmsg does not survive a reboot and journald does not persist here; keep the history.
echo "$(date -Is) ${line#004-drain-log: }" >> /var/log/pocknix-drain.log
exit 0
