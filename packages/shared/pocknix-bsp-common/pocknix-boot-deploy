#!/bin/bash
# Picks the /flash deploy by POCKNIX_BOOT_STYLE, not by which script is installed: both ship
# everywhere, and the bootimg builder exits 0 on arm-efi (no mkbootimg), leaving KERNEL stale.
# Every style also writes the OpenABL (BLS) files; a failure of one payload never skips the other.
# FLASH / SRCROOT / OUT_SUFFIX / ROOT_PARTUUID pass through; --style only prints.
# No pipefail: device.conf's model probe is a pipeline that fails without a devicetree.
set -eu

[ -r /usr/lib/pocknix/device.conf ] && . /usr/lib/pocknix/device.conf
[ -r /etc/pocknix/device.conf ] && . /etc/pocknix/device.conf
# A BSP published before family.conf carried the key is qcom-abl.
style="${POCKNIX_BOOT_STYLE:-qcom-abl}"

[ "${1:-}" = --style ] && { echo "${style}"; exit 0; }
[ $# -eq 0 ] || { echo "pocknix-boot-deploy: unknown argument '$1'" >&2; exit 1; }
case "${style}" in
  qcom-abl) legacy=/usr/bin/pocknix-build-bootimg ;;
  arm-efi)  legacy=/usr/bin/pocknix-update-boot ;;
  bls)      legacy="" ;;
  *) echo "pocknix-boot-deploy: unknown boot style '${style}'" >&2; exit 1 ;;
esac
rc=0
[ -z "${legacy}" ] || "${legacy}" || rc=$?
/usr/lib/pocknix/pocknix-bls-deploy || rc=$?
exit "${rc}"
