#!/bin/sh
# Suspend breadcrumb surviving reboot: 0x01 means we entered suspend; the post hook writes 0xFF.
# Only sm8550 carries the SDAM scratch node, and on sm8250 the write failed on every suspend.
case "$(tr '\0' ' ' < /proc/device-tree/compatible 2>/dev/null)" in
  *qcom,sm8550*) ;;
  *) exit 0 ;;
esac
printf '\x01' | dd of=/sys/bus/nvmem/devices/spmi_sdam0/nvmem \
  bs=1 count=1 seek=80 conv=notrunc 2>/dev/kmsg \
  || echo "003-sdam-debug: SDAM write failed" >/dev/kmsg
