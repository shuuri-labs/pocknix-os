#!/bin/sh
# Suspend breadcrumb surviving reboot: 0x01 = entered suspend, so a 0x01 read on the next
# boot means the failure was inside the kernel PM path (the post hook writes 0xFF).
# Offset 0x50 is inside spmi_sdam0's 0x50-0x7f scratch window; offset 0 always fails.
printf '\x01' | dd of=/sys/bus/nvmem/devices/spmi_sdam0/nvmem \
  bs=1 count=1 seek=80 conv=notrunc 2>/dev/kmsg \
  || echo "003-sdam-debug: SDAM write failed" >/dev/kmsg
