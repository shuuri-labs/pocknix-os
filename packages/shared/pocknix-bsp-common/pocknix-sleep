#!/bin/sh
# systemd runs every executable in /usr/lib/systemd/system-sleep/ with $1 = pre|post and
# $2 = suspend|hibernate|hybrid-sleep|suspend-then-hibernate. We fan that out to our own
# name-ordered hooks in /usr/lib/pocknix/sleep.d/{pre,post}/.
stage="$1"
case "${stage}" in
  pre)  dir=/usr/lib/pocknix/sleep.d/pre  ;;
  post) dir=/usr/lib/pocknix/sleep.d/post ;;
  *)    exit 0 ;;
esac

[ -d "${dir}" ] || exit 0
for hook in "${dir}"/*; do
  [ -x "${hook}" ] || continue
  "${hook}" "$@" 2>/dev/kmsg || echo "pocknix-sleep: ${hook##*/} failed" >/dev/kmsg
done
exit 0
