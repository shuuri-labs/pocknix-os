[Unit]
Description=pocknix LAVD scheduler (scx_lavd, big.LITTLE / latency-aware, autopilot mode)
Documentation=https://github.com/sched-ext/scx
# Do NOT order after multi-user.target: it pulls in the Steam session bring-up, which can
# settle late and leave this start job queued forever. The guards below hold from kernel init.
After=basic.target
# /sys/kernel/sched_ext needs CONFIG_SCHED_CLASS_EXT=y; /sys/kernel/btf/vmlinux needs
# DEBUG_INFO_BTF=y + pahole at build time. Skip cleanly until such a kernel is deployed.
ConditionPathExists=/sys/kernel/sched_ext
ConditionPathExists=/sys/kernel/btf/vmlinux
# A kernel without the tracing/BPF-events stack fails the BPF load every time; give up
# rather than crash-loop the journal.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# The mode is not hardcoded: `pocknix-lavd-mode run` supervises scx_lavd on the persisted or
# per-game mode. Needs the schedutil governor for LAVD's scx_bpf_cpuperf_set to take effect.
ExecStart=/usr/bin/pocknix-lavd-mode run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
