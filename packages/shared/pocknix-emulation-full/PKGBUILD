# pocknix-emulation-full — the emulation layer metapackage. depends= is hard so that
# `pacman -Rs pocknix-emulation-full` removes exactly this layer; the source-built emulators
# are optdepends instead, so a failed optional build cannot block the layer.
pkgname=pocknix-emulation-full
pkgver=0.1.0
pkgrel=4
pkgdesc="pocknix optional layer: ES-DE frontend, RetroArch cores, standalone emulators (Switch: bring your own)"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL2')
depends=('pocknix-emulation'
         'es-de'
         'libretro-cores-pocknix'
         'retroarch'
         'libretro-core-info'
         'retroarch-autoconfig-pocknix'
         'retroarch-shaders-pocknix'
         'retroarch-glsl-shaders-pocknix'
         'ppsspp'
         'fuse2'
         'armsx2-bin'
         'rpcs3-bin'
         'xemu-bin'
         'vita3k-bin')
optdepends=('dolphin-emu: GameCube/Wii'
            'azahar: 3DS'
            'cemu: Wii U')

package() {
  :   # pure metapackage
}
