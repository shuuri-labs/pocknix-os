From: theodotdot <59372255+theodotdot@users.noreply.github.com>
Date: Tue, 10 Nov 2026 14:25:10 +0100
Subject: [PATCH] screenbrightnessutil: read brightnessMin and stop the drag
 snap

PowerDevil's BrightnessControl has brightnessMin and brightnessMinChanged, but the
bundled introspection XML predates them. The util guessed a safe floor instead, and
the drag binding uses RestoreNone: restores-mode restores the value the handle had
when the binding went inactive, which jumps the handle on press.

Add brightnessMin/brightnessMinChanged to the XML, read the real minimum, and bind
with RestoreNone. Keep the slider value in step when min/max arrive late.
---
 .../actiondrawer/private/BrightnessItem.qml   | 33 ++++++++++++++-----
 ...erManagement.Actions.BrightnessControl.xml |  6 ++++
 .../screenbrightnessutil.cpp                  | 28 ++++++++++++++++
 .../screenbrightnessutil.h                    |  5 +++
 4 files changed, 63 insertions(+), 9 deletions(-)

diff --git a/components/mobileshell/qml/actiondrawer/private/BrightnessItem.qml b/components/mobileshell/qml/actiondrawer/private/BrightnessItem.qml
index 243348c..1911ddd 100644
--- a/components/mobileshell/qml/actiondrawer/private/BrightnessItem.qml
+++ b/components/mobileshell/qml/actiondrawer/private/BrightnessItem.qml
@@ -32,6 +32,21 @@ Item {
         id: screenBrightness
     }
 
+    // The slider clamps to the new from/to when they arrive late; put the real value back.
+    Connections {
+        target: screenBrightness
+        function onMinBrightnessChanged() {
+            if (!brightnessSlider.pressed) {
+                brightnessSlider.value = screenBrightness.brightness;
+            }
+        }
+        function onMaxBrightnessChanged() {
+            if (!brightnessSlider.pressed) {
+                brightnessSlider.value = screenBrightness.brightness;
+            }
+        }
+    }
+
     MobileShell.PanelBackground {
         anchors.fill: parent
         anchors.leftMargin: -Kirigami.Units.smallSpacing
@@ -65,9 +80,16 @@ Item {
         PC3.Slider {
             id: brightnessSlider
             Layout.fillWidth: true
-            from: 1
+            from: screenBrightness.minBrightness
             to: screenBrightness.maxBrightness
-            value: screenBrightness.brightness
+            // Do not fight the drag with PowerDevil's animated readback.
+            Binding {
+                target: brightnessSlider
+                property: "value"
+                value: screenBrightness.brightness
+                when: !brightnessSlider.pressed
+                restoreMode: Binding.RestoreNone
+            }
             onMoved: screenBrightness.brightness = value;
 
             onPressedChanged: {
@@ -90,13 +112,6 @@ Item {
                 }
             }
 
-            // HACK: for some reason, the slider initial value doesn't set without being done after the component completes loading
-            Timer {
-                interval: 0
-                running: true
-                repeat: false
-                onTriggered: brightnessSlider.value = Qt.binding(() => screenBrightness.brightness)
-            }
         }
 
         Kirigami.Icon {
diff --git a/components/screenbrightnessplugin/dbus/org.kde.Solid.PowerManagement.Actions.BrightnessControl.xml b/components/screenbrightnessplugin/dbus/org.kde.Solid.PowerManagement.Actions.BrightnessControl.xml
index bc61504..db89118 100644
--- a/components/screenbrightnessplugin/dbus/org.kde.Solid.PowerManagement.Actions.BrightnessControl.xml
+++ b/components/screenbrightnessplugin/dbus/org.kde.Solid.PowerManagement.Actions.BrightnessControl.xml
@@ -17,6 +17,9 @@
     <method name="brightnessMax">
       <arg type="i" direction="out" />
     </method>
+    <method name="brightnessMin">
+      <arg type="i" direction="out" />
+    </method>
 
     <signal name="brightnessChanged">
       <arg type="i" direction="out" />
@@ -24,6 +27,9 @@
     <signal name="brightnessMaxChanged">
       <arg type="i" direction="out" />
     </signal>
+    <signal name="brightnessMinChanged">
+      <arg type="i" direction="out" />
+    </signal>
 
     <method name="brightnessSteps">
       <arg type="i" direction="out" />
diff --git a/components/screenbrightnessplugin/screenbrightnessutil.cpp b/components/screenbrightnessplugin/screenbrightnessutil.cpp
index fb5c2a8..8d118a0 100644
--- a/components/screenbrightnessplugin/screenbrightnessutil.cpp
+++ b/components/screenbrightnessplugin/screenbrightnessutil.cpp
@@ -23,9 +23,14 @@ ScreenBrightnessUtil::ScreenBrightnessUtil(QObject *parent)
             &org::kde::Solid::PowerManagement::Actions::BrightnessControl::brightnessMaxChanged,
             this,
             &ScreenBrightnessUtil::fetchMaxBrightness);
+    connect(m_brightnessInterface,
+            &org::kde::Solid::PowerManagement::Actions::BrightnessControl::brightnessMinChanged,
+            this,
+            &ScreenBrightnessUtil::fetchMinBrightness);
 
     fetchBrightness();
     fetchMaxBrightness();
+    fetchMinBrightness();
 
     // Watch the service PowerDevil owns; the interface name is never owned.
     m_brightnessInterfaceWatcher = new QDBusServiceWatcher(QStringLiteral("org.kde.Solid.PowerManagement"),
@@ -36,6 +41,7 @@ ScreenBrightnessUtil::ScreenBrightnessUtil(QObject *parent)
     connect(m_brightnessInterfaceWatcher, &QDBusServiceWatcher::serviceRegistered, this, [this]() -> void {
         fetchBrightness();
         fetchMaxBrightness();
+        fetchMinBrightness();
         Q_EMIT brightnessAvailableChanged();
     });
 
@@ -59,6 +65,11 @@ int ScreenBrightnessUtil::maxBrightness() const
     return m_maxBrightness;
 }
 
+int ScreenBrightnessUtil::minBrightness() const
+{
+    return m_minBrightness;
+}
+
 bool ScreenBrightnessUtil::brightnessAvailable() const
 {
     return m_brightnessInterface->isValid();
@@ -97,3 +108,20 @@ void ScreenBrightnessUtil::fetchMaxBrightness()
         watcher->deleteLater();
     });
 }
+
+void ScreenBrightnessUtil::fetchMinBrightness()
+{
+    QDBusPendingReply<int> reply = m_brightnessInterface->brightnessMin();
+    QDBusPendingCallWatcher *watcher = new QDBusPendingCallWatcher(reply, this);
+
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *watcher) {
+        QDBusPendingReply<int> reply = *watcher;
+        if (reply.isError()) {
+            qWarning() << "Getting min brightness failed:" << reply.error().name() << reply.error().message();
+        } else if (m_minBrightness != reply.value()) {
+            m_minBrightness = reply.value();
+            Q_EMIT minBrightnessChanged();
+        }
+        watcher->deleteLater();
+    });
+}
diff --git a/components/screenbrightnessplugin/screenbrightnessutil.h b/components/screenbrightnessplugin/screenbrightnessutil.h
index c83920e..e25a1a0 100644
--- a/components/screenbrightnessplugin/screenbrightnessutil.h
+++ b/components/screenbrightnessplugin/screenbrightnessutil.h
@@ -19,6 +19,7 @@ class ScreenBrightnessUtil : public QObject
     Q_OBJECT
     Q_PROPERTY(int brightness READ brightness WRITE setBrightness NOTIFY brightnessChanged);
     Q_PROPERTY(int maxBrightness READ maxBrightness NOTIFY maxBrightnessChanged)
+    Q_PROPERTY(int minBrightness READ minBrightness NOTIFY minBrightnessChanged)
     Q_PROPERTY(bool brightnessAvailable READ brightnessAvailable NOTIFY brightnessAvailableChanged)
     QML_ELEMENT
 
@@ -29,21 +30,25 @@ public:
     void setBrightness(int brightness);
 
     int maxBrightness() const;
+    int minBrightness() const;
 
     bool brightnessAvailable() const;
 
 Q_SIGNALS:
     void brightnessChanged();
     void maxBrightnessChanged();
+    void minBrightnessChanged();
     void brightnessAvailableChanged();
 
 private Q_SLOTS:
     void fetchBrightness();
     void fetchMaxBrightness();
+    void fetchMinBrightness();
 
 private:
     int m_brightness{0};
     int m_maxBrightness{0};
+    int m_minBrightness{1};
 
     org::kde::Solid::PowerManagement::Actions::BrightnessControl *m_brightnessInterface;
     QDBusServiceWatcher *m_brightnessInterfaceWatcher;
