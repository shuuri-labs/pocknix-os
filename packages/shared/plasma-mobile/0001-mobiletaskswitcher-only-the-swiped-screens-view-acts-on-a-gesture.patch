diff --git a/kwin/mobiletaskswitcher/plugin/mobiletaskswitchereffect.cpp b/kwin/mobiletaskswitcher/plugin/mobiletaskswitchereffect.cpp
index cbe487e..1ff6fcb 100644
--- a/kwin/mobiletaskswitcher/plugin/mobiletaskswitchereffect.cpp
+++ b/kwin/mobiletaskswitcher/plugin/mobiletaskswitchereffect.cpp
@@ -44,6 +44,12 @@ void MobileTaskSwitcherState::init(KWin::QuickSceneEffect *parent)
     connect(m_effect, &QuickSceneEffect::deactivated, this, &MobileTaskSwitcherState::deactivated);
     connect(this, &MobileTaskSwitcherState::gestureEnabledChanged, this, &MobileTaskSwitcherState::refreshBorders);
     connect(m_border, &EffectTouchBorder::touchPositionChanged, this, &MobileTaskSwitcherState::processTouchPositionChanged);
+    // A swipe while the switcher is open keeps its screen: the other views never ran initialSetup.
+    connect(m_border, &EffectTouchBorder::gestureStarted, this, [this](const QString &screen) {
+        if (!m_effect->isRunning()) {
+            setGestureScreen(screen);
+        }
+    });
     connect(this, &MobileTaskSwitcherState::gestureInProgressChanged, this, [this]() {
         if (gestureInProgress()) {
             invokeEffect();
@@ -88,6 +94,19 @@ void MobileTaskSwitcherState::setGestureInProgress(bool gestureInProgress)
     m_effectState->setInProgress(gestureInProgress);
 }
 
+QString MobileTaskSwitcherState::gestureScreen() const
+{
+    return m_gestureScreen;
+}
+
+void MobileTaskSwitcherState::setGestureScreen(const QString &gestureScreen)
+{
+    if (m_gestureScreen != gestureScreen) {
+        m_gestureScreen = gestureScreen;
+        Q_EMIT gestureScreenChanged();
+    }
+}
+
 bool MobileTaskSwitcherState::wasInActiveTask() const
 {
     return m_wasInActiveTask;
@@ -312,6 +331,7 @@ void MobileTaskSwitcherState::activate()
 
     resetGestureState();
     m_effectState->setInProgress(false);
+    setGestureScreen(QString());
     invokeEffect();
 }
 
