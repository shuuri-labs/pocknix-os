pkgname=pocknix-emu-vita3k
pkgver=0.1.0
pkgrel=1
pkgdesc="pocknix setup for Vita3K (PS Vita): ES-DE wiring and preconfigured defaults"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL-2.0-or-later')
depends=('pocknix-emulation-common' 'vita3k-bin')
source=('steam-vita3k.conf' 'es-vita3k')
sha256sums=('SKIP' 'SKIP')

package() {
  install -Dm644 "${srcdir}/steam-vita3k.conf" "${pkgdir}/usr/share/pocknix-emulation/steam/vita3k.conf"
  install -Dm755 "${srcdir}/es-vita3k" "${pkgdir}/usr/lib/pocknix/es-vita3k"
}
