#!/bin/bash
# The driver comes back at its compiled-in defaults every boot; replay the save.
set -u

CONF=/etc/pocknix/gamepad-calibration.conf
# Probe-time values for `pocknix-gamepad-calibration reset`; per board (devicetree overrides at probe).
DEFAULTS=/run/pocknix/gamepad-calibration.defaults

# sm8250 loads its gamepad driver as a module on device probe, so the parameters
# can appear after this unit is ordered to run.
params=""
for _ in $(seq 1 50); do
  for candidate in /sys/module/*/parameters; do
    [ -e "${candidate}/axis_leftx_max" ] && [ -e "${candidate}/update_params" ] || continue
    params="${candidate}"
    break
  done
  [ -n "${params}" ] && break
  sleep 0.2
done

if [ -z "${params}" ]; then
  echo "no calibratable gamepad driver found, calibration not applied" >&2
  exit 0
fi

# Only once per boot: a unit restart after a replay must not snapshot calibrated values.
if [ ! -e "${DEFAULTS}" ]; then
  mkdir -p "${DEFAULTS%/*}"
  for f in "${params}"/axis_*_* "${params}"/trigger_*_*; do
    case "${f##*/}" in
      *_max|*_min|*_center|*_deadzone|*_antideadzone) printf '%s=%s\n' "${f##*/}" "$(cat "${f}")" ;;
    esac
  done > "${DEFAULTS}.tmp" && mv "${DEFAULTS}.tmp" "${DEFAULTS}"
fi

[ -r "${CONF}" ] || exit 0

applied=0
while IFS='=' read -r key value; do
  key="${key%%[[:space:]]*}"
  value="${value%%[[:space:]]*}"
  # Plain parameter names only: a key with a path in it would write anywhere root can.
  case "${key}" in
    ''|'#'*) continue ;;
    *[!a-z0-9_]*) echo "ignoring malformed key ${key}" >&2; continue ;;
  esac
  [ -w "${params}/${key}" ] || { echo "unknown parameter ${key}, skipped" >&2; continue; }
  if printf '%s' "${value}" > "${params}/${key}"; then
    applied=1
  else
    echo "failed to write ${key}" >&2
  fi
done < "${CONF}"

[ "${applied}" = "1" ] || exit 0
# The driver clears the flag once its new ranges are live; InputPlumber must not open the pad
# before that. 1 s, as REREAD_S in pocknix-gamepad-calibration.
printf '1' > "${params}/update_params"
for _ in $(seq 1 50); do
  [ "$(cat "${params}/update_params" 2>/dev/null)" = 0 ] && exit 0
  sleep 0.02
done
echo "driver did not re-read its parameters; ranges may be stale this boot" >&2
exit 0
