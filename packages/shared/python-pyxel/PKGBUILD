# python-pyxel — the Pyxel retro game engine, from upstream's own aarch64 wheel.
# Wheel, not source: a source build drags in rust + maturin for one small tool.
#
# Pinned to 2.5.3 — the .pyxres resource format must match what GPcal was authored
# against. abi3 survives Python minor bumps but site-packages is version-scoped, so an
# ALARM python bump needs a pkgrel rebuild, not a new pkgver.
pkgname=python-pyxel
pkgver=2.5.3
pkgrel=1
pkgdesc="Pyxel retro game engine for Python (upstream aarch64 wheel)"
arch=('aarch64')
url="https://github.com/kitao/pyxel"
license=('MIT')
depends=('python' 'sdl2')
options=('!strip')
_wheel="pyxel-${pkgver}-cp38-abi3-manylinux_2_17_aarch64.manylinux2014_aarch64.whl"
source=("https://files.pythonhosted.org/packages/42/0c/b81c09db61e981c4d50c7bdd2821cf165210edc6855e3609c81371f79eae/${_wheel}")
sha256sums=('220f35d737022ade2e996b60df4d2335d1502708a045dccdec1edf32508abdba')
noextract=("${_wheel}")

package() {
  local sitedir
  sitedir="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"
  install -d "${pkgdir}${sitedir}"
  # a wheel is a zip; bsdtar (libarchive, in base-devel) unpacks it in place
  bsdtar -xf "${srcdir}/${_wheel}" -C "${pkgdir}${sitedir}" \
    "pyxel" "pyxel-${pkgver}.dist-info"

  install -Dm644 "${pkgdir}${sitedir}/pyxel/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
