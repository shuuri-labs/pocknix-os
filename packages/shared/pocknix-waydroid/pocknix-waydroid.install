# Older images shipped these as unowned overlay files: the /etc unit shadows the packaged one and
# the per-user seed's Exec names the /usr/local/bin copy. Only unedited copies go.
_retire_overlay_waydroid() {
  rm -f /usr/local/bin/pocknix-waydroid-tuning /usr/local/bin/pocknix-waydroid-apk-install
  f=/etc/systemd/system/pocknix-waydroid-tuning.service
  if [ -f "${f}" ] && [ "$(sha256sum "${f}" | cut -d' ' -f1)" = \
       67f839e9c73ec0e2479c9f88ab66b5381f5f3fc7483d874067f8a34e2687c6cf ]; then
    rm -f "${f}"
  fi
  for f in /home/*/.local/share/applications/waydroid-apk-install.desktop; do
    [ -f "${f}" ] || continue
    [ "$(sha256sum "${f}" | cut -d' ' -f1)" = \
      19c55a459b1a7733b62159ed539381909b8b0cdd60ddecd0ee6798ae8478a8ce ] && rm -f "${f}"
  done
}

# A device with the old overlay unit but no enable link had it disabled by the user: keep it off.
post_install() {
  link=/etc/systemd/system/waydroid-container.service.wants/pocknix-waydroid-tuning.service
  enable=1
  [ -e /etc/systemd/system/pocknix-waydroid-tuning.service ] && [ ! -L "${link}" ] && enable=
  _retire_overlay_waydroid
  rm -f "${link}"
  [ -d /run/systemd/system ] && systemctl daemon-reload
  [ -n "${enable}" ] && systemctl enable pocknix-waydroid-tuning.service >/dev/null 2>&1
  return 0
}

pre_remove() { systemctl disable pocknix-waydroid-tuning.service >/dev/null 2>&1 || true; }
