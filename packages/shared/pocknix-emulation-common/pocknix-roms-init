#!/bin/bash
# pocknix-roms-init - login-time setup for the emulation layer, run as 'deck' by its user unit.
# A seed is copied only when its target is absent: an update never rewrites a user's settings,
# --reset <name> is the way to re-apply ours; --seed <name> seeds one emulator now (its launcher
# calls this). --roms <dir> points ES-DE and every emulator at another ROMs folder, moving no
# files; --where prints the current one. A failure must never fail a login.
set -u

SHARE=/usr/share/pocknix-emulation
EMU="${HOME}/Emulation"
. /usr/lib/pocknix/emu-resolve.sh
STATE="${XDG_STATE_HOME:-${HOME}/.local/state}"

# Seeds are authored for a 120Hz, 1080-line panel and adapted below; absent keys pass them through.
[ -r /usr/lib/pocknix/device.conf ] && . /usr/lib/pocknix/device.conf
[ -r /etc/pocknix/device.conf ] && . /etc/pocknix/device.conf
REFRESH="${POCKNIX_PANEL_REFRESH:-120}"
# device.conf carries the NATIVE frame; rotated panels are transposed to get the logical height.
case "${POCKNIX_PANEL_ORIENT:-left}" in
  left|right) LOGICAL_H="${POCKNIX_PANEL_W:-1080}" ;;
  *)          LOGICAL_H="${POCKNIX_PANEL_H:-1920}" ;;
esac
# ES-DE's ROMDirectory setting is the single source of truth for where ROMs live (the user can
# repoint it at an SD card), and this skeleton follows it. Empty/absent means ES-DE's own default
# ~/ROMs. The settings file is a rootless XML fragment, hence sed.
ESDE_SETTINGS="${HOME}/ES-DE/settings/es_settings.xml"
ESDE_CUSTOM="${HOME}/ES-DE/custom_systems"
_roms_setting="$(sed -n 's/.*name="ROMDirectory" value="\([^"]*\)".*/\1/p' "${ESDE_SETTINGS}" 2>/dev/null | head -1)"
case "${_roms_setting}" in "~"*) _roms_setting="${HOME}${_roms_setting#\~}" ;; esac
if [ -n "${_roms_setting}" ]; then
  ROMS="${_roms_setting}"
elif [ -f "${ESDE_SETTINGS}" ]; then
  ROMS="${HOME}/ROMs"          # settings exist but no/empty ROMDirectory = ES-DE default
else
  ROMS="${EMU}/ROMs"           # fresh install: the seed below points ES-DE here
fi
# -s: a symlinked folder keeps the path the configs hold, or --roms would not find it in them
ROMS="$(realpath -ms "${ROMS}")"

# ES-DE's own default folder names - creating one only gives the user a labelled drop point;
# ES-DE still shows a system only once it is populated.
SYSTEMS=(
  nes snes n64 gb gbc gba nds n3ds
  genesis megadrive mastersystem gamegear segacd saturn dreamcast
  tg16 pcengine neogeo cps1 cps2 cps3 arcade mame
  atari2600 atari7800 atarilynx atarijaguar wonderswan
  psx ps2 ps3 psp psvita
  gc wii wiiu switch xbox
)

have_esde()      { command -v es-de >/dev/null 2>&1; }
have_retroarch() { command -v retroarch >/dev/null 2>&1; }
have_armsx2()    { emu_path armsx2 >/dev/null 2>&1; }
have_eden()      { emu_path eden >/dev/null 2>&1; }
have_dolphin()   { emu_path dolphin >/dev/null 2>&1; }
have_cemu()      { emu_path cemu >/dev/null 2>&1; }
have_ppsspp()    { emu_path ppsspp >/dev/null 2>&1; }
have_ryujinx()   { emu_path ryujinx >/dev/null 2>&1; }
have_srm()       { command -v steam-rom-manager >/dev/null 2>&1; }
EMULATORS=(esde retroarch armsx2 eden ryujinx dolphin cemu ppsspp srm)

TMP="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/pocknix-seed.XXXXXX")" || exit 0
trap 'rm -rf "${TMP}"' EXIT

render_all() {  # $1 template dir, $2 out dir
  local src="$1" out="$2"; mkdir -p "${out}"
  printf '<?xml version="1.0"?>\n<string name="ROMDirectory" value="%s" />\n' "${ROMS}" > "${out}/es_settings.xml"
  local si=$(( REFRESH / 60 )); [ "${si}" -lt 1 ] && si=1
  [ -f "${src}/retroarch.cfg" ] && sed -e "s/^video_refresh_rate = .*/video_refresh_rate = \"${REFRESH}.000000\"/" \
      -e "s/^video_swap_interval = .*/video_swap_interval = \"${si}\"/" "${src}/retroarch.cfg" > "${out}/retroarch.cfg"
  [ -f "${src}/armsx2-PCSX2.ini.in" ] && sed -e "s|__ROMS__|${ROMS}|g" -e "s|__HOME__|${HOME}|g" "${src}/armsx2-PCSX2.ini.in" > "${out}/PCSX2.ini"
  local vs=2; [ "${REFRESH}" -ge 120 ] 2>/dev/null && vs=1
  [ -f "${src}/eden-qt-config.ini.in" ] && sed "s/^use_vsync=.*/use_vsync=${vs}/" "${src}/eden-qt-config.ini.in" > "${out}/qt-config.ini"
  [ -f "${src}/ryujinx-Config.json.in" ] && sed "s|__ROMS__|${ROMS}|g" "${src}/ryujinx-Config.json.in" > "${out}/Config.json"
  [ -f "${src}/dolphin-Dolphin.ini.in" ] && sed "s|__ROMS__|${ROMS}|g" "${src}/dolphin-Dolphin.ini.in" > "${out}/Dolphin.ini"
  [ -f "${src}/dolphin-GFX.ini.in" ] && cp "${src}/dolphin-GFX.ini.in" "${out}/GFX.ini"
  [ -f "${src}/cemu-settings.xml.in" ] && sed "s|__ROMS__|${ROMS}|g" "${src}/cemu-settings.xml.in" > "${out}/settings.xml"
  # the largest 272-row multiple that fits the panel, +8 rows slack (4x on 1080 crops 8)
  local res=$(( (LOGICAL_H + 8) / 272 )); [ "${res}" -lt 1 ] && res=1
  [ -f "${src}/ppsspp.ini.in" ] && sed "s/^iInternalResolution = .*/iInternalResolution = ${res}/" "${src}/ppsspp.ini.in" > "${out}/ppsspp.ini"
  if [ -x /usr/lib/pocknix/pocknix-srm-config ]; then
    /usr/lib/pocknix/pocknix-srm-config --settings "${ROMS}" > "${out}/userSettings.json" || rm -f "${out}/userSettings.json"
    /usr/lib/pocknix/pocknix-srm-config "${ROMS}" > "${out}/userConfigurations.json" || rm -f "${out}/userConfigurations.json"
  fi
  return 0
}
render_all "${SHARE}" "${TMP}/new"

seed_file() {  # $1 rendered name, $2 target
  [ -f "${TMP}/new/$1" ] || return 0
  [ -e "$2" ] || [ -L "$2" ] && return 0
  mkdir -p "$(dirname "$2")" 2>/dev/null && cp "${TMP}/new/$1" "$2" 2>/dev/null || true
}
seed_copy() {  # $1 file or dir (absolute, or relative to SHARE), $2 target; per file if a dir
  local src="$1"
  case "$1" in /*) ;; *) src="${SHARE}/$1" ;; esac
  if [ -d "${src}" ]; then
    mkdir -p "$2" && cp -Rn "${src}/." "$2/" 2>/dev/null || true
  elif [ -f "${src}" ] && [ ! -e "$2" ] && [ ! -L "$2" ]; then
    mkdir -p "$(dirname "$2")" 2>/dev/null && cp "${src}" "$2" 2>/dev/null || true
  fi
}

# The custom_systems pair is launch wiring, not settings: a frozen copy would drift from
# pocknix-play and never learn a new emulator, so ES-DE reads ours through a link. A user's own
# real file there is left alone.
ESDE_WIRING="es_systems.xml es_find_rules.xml"
link_esde() {  # $1 file name
  [ -f "${SHARE}/$1" ] || return 0
  [ -e "${ESDE_CUSTOM}/$1" ] || [ -L "${ESDE_CUSTOM}/$1" ] && return 0
  mkdir -p "${ESDE_CUSTOM}" && ln -s "${SHARE}/$1" "${ESDE_CUSTOM}/$1" 2>/dev/null || true
}
seed_esde() {
  seed_file es_settings.xml "${ESDE_SETTINGS}"
  local f; for f in ${ESDE_WIRING}; do link_esde "${f}"; done
}

seed_retroarch() {
  seed_file retroarch.cfg "${HOME}/.config/retroarch/retroarch.cfg"
  # RetroArch's own autoconfig dir, so user-saved profiles coexist; without these the Steam
  # Input pad has no bindings at all.
  [ -d /usr/share/libretro/autoconfig/udev ] && \
    seed_copy /usr/share/libretro/autoconfig/udev "${HOME}/.config/retroarch/autoconfig/udev"
  # Linked, not copied; the dir stays writable so preset saving works. A real
  # shaders_slang (Online Updater) wins.
  local shaders="${HOME}/.config/retroarch/shaders/shaders_slang"
  if [ -d /usr/share/libretro/shaders/shaders_slang ] && [ ! -e "${shaders}" ]; then
    mkdir -p "${HOME}/.config/retroarch/shaders"
    ln -s /usr/share/libretro/shaders/shaders_slang "${shaders}" 2>/dev/null || true
  fi
  [ -d "${SHARE}/retroarch-config" ] && seed_copy retroarch-config "${HOME}/.config/retroarch/config"
}

seed_armsx2() {
  # The PCSX2 -> ARMSX2 dir migration must precede the seed, or an upgraded device gets a
  # fresh seed, the setup wizard and orphaned memcards.
  if [ -f "${HOME}/.config/PCSX2/inis/PCSX2.ini" ] && [ ! -f "${HOME}/.config/ARMSX2/inis/PCSX2.ini" ]; then
    mkdir -p "${HOME}/.config/ARMSX2"
    cp -a "${HOME}/.config/PCSX2/." "${HOME}/.config/ARMSX2/" 2>/dev/null || true
  fi
  seed_file PCSX2.ini "${HOME}/.config/ARMSX2/inis/PCSX2.ini"
}

# Mailbox vsync (1) is bouncy on 60Hz panels, so those get FIFO (2)
seed_eden()    { seed_file qt-config.ini "${HOME}/.config/eden/qt-config.ini"; }
seed_ryujinx() { seed_file Config.json "${HOME}/.config/Ryujinx/Config.json"; }

seed_dolphin() {
  seed_file Dolphin.ini "${HOME}/.config/dolphin-emu/Dolphin.ini"
  seed_file GFX.ini     "${HOME}/.config/dolphin-emu/GFX.ini"
  seed_copy dolphin-GCPadNew.ini.in "${HOME}/.config/dolphin-emu/GCPadNew.ini"
}

seed_cemu() {
  # The file merely existing is what skips Cemu's onboarding wizard (CemuApp isFirstStart);
  # the controller profile is session-dependent, so pocknix-cemu-profile writes it at launch.
  seed_file settings.xml "${HOME}/.config/Cemu/settings.xml"
}

seed_ppsspp() { seed_file ppsspp.ini "${HOME}/.config/ppsspp/PSP/SYSTEM/ppsspp.ini"; }

SRM_DATA="${HOME}/.config/steam-rom-manager/userData"
seed_srm() {
  seed_file userSettings.json "${SRM_DATA}/userSettings.json"
  seed_file userConfigurations.json "${SRM_DATA}/userConfigurations.json"
}

# One-time move off the old settings merge: an unedited custom_systems copy (comment and blank
# line differences ignored) becomes the link, then the merge's per-user baselines and the
# .pocknixnew offers beside our files go.
BASELINE="${STATE}/pocknix/seed-baseline"
xml_body() {  # $1 file -> its lines minus XML comments, blank lines and trailing blanks
  awk '{
    s = $0; out = ""
    while (s != "") {
      if (c) { i = index(s, "-->"); if (!i) break; s = substr(s, i + 3); c = 0 }
      else { i = index(s, "<!--"); if (!i) { out = out s; break }; out = out substr(s, 1, i - 1); s = substr(s, i + 4); c = 1 }
    }
    sub(/[ \t\r]+$/, "", out); if (out != "") print out
  }' "$1" 2>/dev/null
}
retire_merge() {
  [ -d "${BASELINE}" ] || return 0
  local f cur body old
  for f in ${ESDE_WIRING}; do
    cur="${ESDE_CUSTOM}/${f}" old="${BASELINE}/ES-DE/custom_systems/${f}"
    [ -f "${cur}" ] && [ ! -L "${cur}" ] && [ -f "${SHARE}/${f}" ] || continue
    body="$(xml_body "${cur}")"
    if [ "${body}" = "$(xml_body "${SHARE}/${f}")" ] || { [ -f "${old}" ] && [ "${body}" = "$(xml_body "${old}")" ]; }; then
      ln -sf "${SHARE}/${f}" "${cur}" && echo "pocknix-roms-init: ${cur} now links to ${SHARE}/${f}"
    else
      echo "pocknix-roms-init: ${cur} carries your own edits, kept (--reset esde links it back)"
    fi
  done
  find "${BASELINE}" -type f 2>/dev/null | while IFS= read -r f; do
    rm -f "${HOME}/${f#"${BASELINE}/"}.pocknixnew"
  done
  rm -rf "${BASELINE}"
}

# ROMS was read before any reset, so restoring ES-DE defaults keeps the user's ROM location
label() {
  local l own=""
  case "$1" in
    esde) l="ES-DE frontend" ;;          retroarch) l="RetroArch" ;;
    armsx2) l="ARMSX2 (PS2)" ;;          eden) l="Eden (Switch)" ;;
    dolphin) l="Dolphin (GameCube/Wii)" ;; cemu) l="Cemu (Wii U)" ;;
    ppsspp) l="PPSSPP (PSP)" ;;          ryujinx) l="Ryujinx (Switch)" ;;
    srm) l="Steam ROM Manager" ;;
  esac
  case "$(emu_path "$1" 2>/dev/null)" in "${EMU_DROP}"/*) own=" - your own build" ;; esac
  echo "${l}${own}"
}
STAMP="$(date +%Y%m%d-%H%M%S)"
reset_target() {  # $1 target file
  if [ -L "$1" ]; then rm -f "$1"
  elif [ -e "$1" ]; then mv "$1" "$1.bak-${STAMP}" 2>/dev/null
  fi
  return 0
}
reset_dir() {  # $1 shipped dir, $2 target dir: only the files we ship, never the user's own
  local f
  [ -d "$1" ] || return 0
  while IFS= read -r f; do reset_target "$2/${f#"$1/"}"; done < <(find "$1" -type f)
}
reset_esde()      { local f; reset_target "${ESDE_SETTINGS}"; for f in ${ESDE_WIRING}; do reset_target "${ESDE_CUSTOM}/${f}"; done; }
reset_retroarch() {
  reset_target "${HOME}/.config/retroarch/retroarch.cfg"
  reset_dir /usr/share/libretro/autoconfig/udev "${HOME}/.config/retroarch/autoconfig/udev"
  reset_dir "${SHARE}/retroarch-config" "${HOME}/.config/retroarch/config"
}
reset_armsx2()    { reset_target "${HOME}/.config/ARMSX2/inis/PCSX2.ini"; }
reset_eden()      { reset_target "${HOME}/.config/eden/qt-config.ini"; }
reset_ryujinx()   { reset_target "${HOME}/.config/Ryujinx/Config.json"; }
reset_dolphin()   { local f; for f in Dolphin.ini GFX.ini GCPadNew.ini; do reset_target "${HOME}/.config/dolphin-emu/${f}"; done; }
reset_cemu()      { reset_target "${HOME}/.config/Cemu/settings.xml"; }
reset_ppsspp()    { reset_target "${HOME}/.config/ppsspp/PSP/SYSTEM/ppsspp.ini"; }
reset_srm()       { reset_target "${SRM_DATA}/userSettings.json"; reset_target "${SRM_DATA}/userConfigurations.json"; }

present=()
for e in "${EMULATORS[@]}"; do "have_${e}" && present+=("${e}"); done

# Each one rewrites its own config when it closes, so a path changed under it would come back.
# Anchored to the program itself: Steam's launch wrappers carry the app's path in their args.
RUNNING_RE='^([^ ]*/)?(es-de|Cemu|dolphin-emu|ARMSX2|Ryujinx(\.Ava)?|steam-rom-manager)(\.AppImage)?( |$)'
set_roms() {  # $1 new ROMs folder, $2 "--dry-run" or empty
  local new="$1" dry="${2:-}" o list i
  local -a running
  case "${new}" in "~"*) new="${HOME}${new#\~}" ;; esac
  case "${new}" in /*) ;; *) echo "pocknix-roms-init: ${new} is not an absolute path" >&2; return 2 ;; esac
  new="$(realpath -m "${new}")"
  if [ -e "${new}" ]; then
    [ -d "${new}" ] && [ -w "${new}" ] || { echo "pocknix-roms-init: ${new} is not a folder you can write to" >&2; return 2; }
  else
    [ -d "$(dirname "${new}")" ] && [ -w "$(dirname "${new}")" ] || { echo "pocknix-roms-init: cannot create ${new}" >&2; return 2; }
  fi
  # Old roots: the current folder plus both defaults, since ES-DE could be repointed alone before.
  local old=("${ROMS}" "${EMU}/ROMs" "${HOME}/ROMs")
  for o in "${old[@]}"; do
    case "${new}" in "${o}"/*) echo "pocknix-roms-init: pick a folder outside ${o}" >&2; return 2 ;; esac
  done
  mapfile -t running < <(pgrep -u "$(id -u)" -a -f "${RUNNING_RE}" | sed -E 's/^[0-9]+ //; s/ .*//; s|.*/||;
    s/\.AppImage$//; s/^es-de$/ES-DE/; s/^dolphin-emu$/Dolphin/; s/^Ryujinx.*/Ryujinx/; s/^steam-rom-manager$/Steam ROM Manager/' | sort -u)
  if [ "${#running[@]}" -gt 0 ]; then
    list="${running[0]}"
    for ((i = 1; i < ${#running[@]}; i++)); do
      [ "${i}" -eq $((${#running[@]} - 1)) ] && list+=" and ${running[i]}" || list+=", ${running[i]}"
    done
    if [ "${#running[@]}" -eq 1 ]; then
      echo "pocknix-roms-init: Close ${list} first: it saves its settings when it closes, which would undo the change." >&2
    else
      echo "pocknix-roms-init: Close ${list} first: they save their settings when they close, which would undo the change." >&2
    fi
    return 3
  fi
  local args=(--new "${new}")
  for o in "${old[@]}"; do args+=(--old "${o}"); done
  [ -n "${dry}" ] && args+=(--dry-run)
  [ -z "${dry}" ] && { mkdir -p "${new}" || return 1; }
  # ES-DE last: it is the record of where ROMs live, so a run cut short is simply run again
  /usr/lib/pocknix/pocknix-roms-retarget "${args[@]}" \
    srm-settings="${SRM_DATA}/userSettings.json" srm-parsers="${SRM_DATA}/userConfigurations.json" \
    cemu="${HOME}/.config/Cemu/settings.xml" dolphin="${HOME}/.config/dolphin-emu/Dolphin.ini" \
    ryujinx="${HOME}/.config/Ryujinx/Config.json" armsx2="${HOME}/.config/ARMSX2/inis/PCSX2.ini" \
    esde="${ESDE_SETTINGS}" | while IFS="$(printf '\t')" read -r kind file; do
      printf '%s\t%s\n' "$(label "${kind%%-*}")" "${file}"
    done
  return "${PIPESTATUS[0]}"
}

case "${1:-}" in
  --where)
    echo "${ROMS}"
    exit 0 ;;
  --roms)
    [ "$#" -ge 2 ] && { [ -z "${3:-}" ] || [ "${3:-}" = --dry-run ]; } \
      || { echo "usage: pocknix-roms-init --roms <dir> [--dry-run]" >&2; exit 2; }
    set_roms "$2" "${3:-}"; rc=$?
    [ "${rc}" -ne 0 ] || [ -n "${3:-}" ] && exit "${rc}"
    # a normal run from the new folder: system dirs, and seeds for configs not written yet
    exec "$0" ;;
  --list)
    for e in "${present[@]}"; do printf '%s\t%s\n' "${e}" "$(label "${e}")"; done
    exit 0 ;;
  --reset)
    shift
    [ "$#" -gt 0 ] || { echo "usage: pocknix-roms-init --reset <$(IFS="|"; echo "${EMULATORS[*]}")|all>" >&2; exit 2; }
    [ "$1" = all ] && set -- "${present[@]}"
    for e in "$@"; do
      case " ${present[*]} " in *" ${e} "*) ;; *) echo "pocknix-roms-init: ${e} is not installed" >&2; continue ;; esac
      "reset_${e}"; "seed_${e}" || true
    done
    exit 0 ;;
  --seed)
    shift
    [ "$#" -gt 0 ] || { echo "usage: pocknix-roms-init --seed <$(IFS="|"; echo "${EMULATORS[*]}")>" >&2; exit 2; }
    for e in "$@"; do
      case " ${present[*]} " in *" ${e} "*) "seed_${e}" || true ;; *) echo "pocknix-roms-init: ${e} is not installed" >&2 ;; esac
    done
    exit 0 ;;
esac
# a layer-less device must not grow ~/Emulation or emulator config dirs
[ "${#present[@]}" -gt 0 ] || exit 0

mkdir -p "${EMU}/BIOS" "${EMU}/Saves" "${EMU}/States"
for s in "${SYSTEMS[@]}"; do mkdir -p "${ROMS}/${s}"; done
for e in ${EMU_NAMES}; do mkdir -p "${EMU_DROP}/${e}"; done
# Eden is not shipped any more: hand a device that has it its own copy
if [ -x /opt/pocknix/emulators/eden/Eden.AppImage ] && [ -z "$(ls -A "${EMU_DROP}/eden" 2>/dev/null)" ]; then
  cp /opt/pocknix/emulators/eden/Eden.AppImage "${EMU_DROP}/eden/Eden.AppImage" 2>/dev/null || true
fi
# refreshed every run so doc updates reach existing installs
[ -f "${SHARE}/ROMS-README.txt" ] && cp -f "${SHARE}/ROMS-README.txt" "${EMU}/README.txt" 2>/dev/null

retire_merge
for e in "${present[@]}"; do "seed_${e}" || true; done
exit 0
