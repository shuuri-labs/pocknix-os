#!/usr/bin/python3
# pocknix-roms-retarget --new <dir> --old <dir>... [--dry-run] <kind>=<file>... - points the ROM
# paths in emulator configs at a new ROMs folder; pocknix-roms-init --roms calls it. Only a value
# equal to an old root or under it changes: every other key and every folder the user added stays.
# Prints "<kind>\t<file>" per file it changes (or would, with --dry-run).
import json
import os
import re
import sys
import tempfile


def retarget(value: str, old: list[str], new: str) -> str:
    home = os.path.expanduser("~")
    v = home + value[1:] if value.startswith("~") else value
    for o in old:
        if v == o or v.startswith(o + "/"):
            return new + v[len(o):]
    return value


def lines(text: str, pattern: str, old, new) -> str:
    # pattern's group 1 is everything before the value, group 2 the value, group 3 the rest
    return re.sub(pattern, lambda m: m.group(1) + retarget(m.group(2), old, new) + m.group(3), text, flags=re.M)


def esde(text, old, new):
    pat = r'(<string name="ROMDirectory" value=")([^"]*)(")'
    if re.search(pat, text):
        return re.sub(pat, lambda m: m.group(1) + new + m.group(3), text)
    # absent = ES-DE's default ~/ROMs; the new folder is set either way
    return text.rstrip("\n") + ("\n" if text.strip() else "") + f'<string name="ROMDirectory" value="{new}" />\n'


def ini(key):
    return lambda text, old, new: lines(text, rf"^(\s*{key}\s*=\s*)(.*?)(\s*)$", old, new)


def cemu(text, old, new):
    def block(m):
        return lines(m.group(0), r"(<Entry>)([^<]*)(</Entry>)", old, new)
    return re.sub(r"<GamePaths>.*?</GamePaths>", block, text, flags=re.S)


def json_edit(fn):
    def edit(text, old, new):
        data = json.loads(text)
        fn(data, old, new)
        return json.dumps(data, indent=2) + "\n"
    return edit


def ryujinx(data, old, new):
    if isinstance(data.get("game_dirs"), list):
        data["game_dirs"] = [retarget(d, old, new) if isinstance(d, str) else d for d in data["game_dirs"]]


def srm_settings(data, old, new):
    env = data.get("environmentVariables")
    if isinstance(env, dict) and isinstance(env.get("romsDirectory"), str):
        env["romsDirectory"] = retarget(env["romsDirectory"], old, new)


def srm_parsers(data, old, new):
    # only our parsers: one the user made in SRM keeps its own folder
    for p in data if isinstance(data, list) else []:
        if isinstance(p, dict) and str(p.get("parserId", "")).startswith("pocknix-") \
                and isinstance(p.get("romDirectory"), str):
            p["romDirectory"] = retarget(p["romDirectory"], old, new)


KINDS = {
    "esde": esde,
    "dolphin": ini(r"ISOPath\d+"),
    "armsx2": ini("RecursivePaths"),
    "cemu": cemu,
    "ryujinx": json_edit(ryujinx),
    "srm-settings": json_edit(srm_settings),
    "srm-parsers": json_edit(srm_parsers),
}


def write(path: str, text: str) -> None:
    # whole file then rename: an emulator never reads half a config
    d = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".pocknix-retarget.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        st = os.stat(path) if os.path.exists(path) else None
        os.chmod(tmp, st.st_mode & 0o7777 if st else 0o644)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def main(argv: list[str]) -> int:
    new, old, dry, jobs = None, [], False, []
    it = iter(argv)
    for a in it:
        if a == "--new":
            new = next(it, None)
        elif a == "--old":
            old.append(next(it, "").rstrip("/"))
        elif a == "--dry-run":
            dry = True
        elif "=" in a and a.split("=", 1)[0] in KINDS:
            jobs.append(a.split("=", 1))
        else:
            print(f"pocknix-roms-retarget: unknown argument {a}", file=sys.stderr)
            return 2
    if not new or not jobs:
        print("usage: pocknix-roms-retarget --new <dir> --old <dir>... [--dry-run] <kind>=<file>...", file=sys.stderr)
        return 2
    new = new.rstrip("/")
    rc = 0
    for kind, path in jobs:
        if kind != "esde" and not os.path.isfile(path):
            continue
        try:
            text = open(path, encoding="utf-8").read() if os.path.isfile(path) else ""
            out = KINDS[kind](text, old, new)
        except (OSError, ValueError) as e:
            print(f"pocknix-roms-retarget: {path} left as it is: {e}", file=sys.stderr)
            rc = 1
            continue
        if out == text:
            continue
        if not dry:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            write(path, out)
        print(f"{kind}\t{path}")
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
