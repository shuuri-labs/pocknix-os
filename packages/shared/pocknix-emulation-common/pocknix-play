#!/bin/bash
# pocknix-play <system> <rom> | --gui <emulator> - the launch target of every Steam tile we
# make (one per installed emulator, --gui) and of Steam ROM Manager's ROM tiles, so an emulator
# or core swap happens here once and existing tiles keep working. ES-DE launches do NOT come
# through here (es_systems.xml calls the es-* wrappers directly): keep the two aligned.
set -u

if [ "${1:-}" = --gui ]; then
  gui="${2:-}"
else
  system="${1:-}"; rom="${2:-}"
  if [ -z "${system}" ] || [ -z "${rom}" ]; then
    echo "usage: pocknix-play <system> <rom-path> | --gui <emulator>" >&2; exit 2
  fi
  [ -e "${rom}" ] || { echo "pocknix-play: ROM not found: ${rom}" >&2; exit 1; }
fi

. /usr/lib/pocknix/emu-resolve.sh
_big_cores="$(big_cores)"
CORES=/usr/lib/libretro

run_core() {
  local core="${CORES}/$1_libretro.so"
  [ -f "${core}" ] || { echo "pocknix-play: core missing: ${core} (libretro-cores-pocknix not installed?)" >&2; exit 1; }
  # es-retroarch adds -f and the frame-pacing --appendconfig; ES-DE launches use the same wrapper.
  exec /usr/lib/pocknix/es-retroarch -L "${core}" "${rom}"
}

run_emu() {  # $1 = emulator name; remaining args = emulator flags (rom appended by caller)
  local app; app="$(emu_path "$1")" || emu_missing "$1"; shift
  case "${app}" in
    *.AppImage|*.appimage)
      # Steam injects LD_PRELOAD + its runtime LD_LIBRARY_PATH into shortcuts: AppImages with
      # bundled Qt SIGABRT on that mix and then cannot find fusermount via PATH.
      exec env -u LD_PRELOAD -u LD_LIBRARY_PATH FUSERMOUNT_PROG=/usr/bin/fusermount \
        taskset -c "${_big_cores}" "${app}" "$@" ;;
    *) exec taskset -c "${_big_cores}" "${app}" "$@" ;;
  esac
}

# Tiles never point at the es-* wrappers: they skip the Steam env scrub (es-retroarch only adds
# flags). Fullscreen flags only where --help says they cover the UI, not just a running game.
if [ -n "${gui:-}" ]; then
  case "${gui}" in
    retroarch) exec /usr/lib/pocknix/es-retroarch ;;
    ppsspp)    run_emu ppsspp --fullscreen ;;
    vita3k)    run_emu vita3k -F ;;
    azahar)    run_emu azahar -f ;;
    xemu)      run_emu xemu -full-screen ;;
    armsx2|rpcs3|dolphin) run_emu "${gui}" ;;
    cemu)
      /usr/lib/pocknix/pocknix-cemu-profile 2>/dev/null || true   # pad GUID differs per session
      run_emu cemu ;;
    *) echo "pocknix-play: no UI launch for '${gui}'" >&2; exit 2 ;;
  esac
fi

# ES-DE records the per-system alternative emulator in the gamelist; the Steam tile must match.
esde_alt_emulator() {  # $1 system -> prints the label, or nothing
  sed -n 's/.*<label>\(.*\)<\/label>.*/\1/p' "${HOME}/ES-DE/gamelists/$1/gamelist.xml" 2>/dev/null | head -1
}

case "${system}" in
  nes|famicom)                          run_core fceumm ;;
  snes|sfc)                             run_core snes9x ;;
  n64)                                  run_core mupen64plus_next ;;
  gb|gbc)                               run_core gambatte ;;
  gba)                                  run_core mgba ;;
  nds)                                  run_core melonds ;;
  genesis|megadrive|mastersystem|gamegear|segacd|megacd) run_core genesis_plus_gx ;;
  sega32x)                              run_core picodrive ;;
  saturn)                               run_core yabasanshiro ;;
  dreamcast)                            run_core flycast ;;
  psx)                                  run_core duckstation ;;
  tg16|pcengine)                        run_core mednafen_pce_fast ;;
  supergrafx|sgfx)                      run_core mednafen_supergrafx ;;
  neogeo|fbneo)                         run_core fbneo ;;
  cps1|cps2|cps3|arcade|mame)
    # Same default as es_systems.xml (FinalBurn Neo), and the same alternative one selection away.
    case "$(esde_alt_emulator "${system}")" in
      *MAME*) run_core mame2003_plus ;;
      *)      run_core fbneo ;;
    esac ;;
  atari2600)                            run_core stella ;;
  atari7800)                            run_core prosystem ;;
  atarilynx)                            run_core handy ;;
  atarijaguar)                          run_core virtualjaguar ;;
  wonderswan|wonderswancolor)           run_core mednafen_wswan ;;
  ngp|ngpc)                             run_core mednafen_ngp ;;
  virtualboy)                           run_core mednafen_vb ;;

  psp)        run_emu ppsspp --fullscreen "${rom}" ;;
  gc|wii)     run_emu dolphin -b -e "${rom}" ;;
  ps2)        run_emu armsx2 -batch -fullscreen -- "${rom}" ;;
  ps3)        run_emu rpcs3 --no-gui "${rom}" ;;
  xbox)       run_emu xemu -full-screen -dvd_path "${rom}" ;;
  n3ds|3ds)   run_emu azahar "${rom}" ;;
  switch)
    case "$(esde_alt_emulator switch)" in
      *Ryujinx*) run_emu ryujinx "${rom}" ;;
      *)         run_emu eden -f -g "${rom}" ;;
    esac ;;
  psvita)
    # Vita3K -r wants the title id = the ROM's basename (what ES-DE's %BASENAME% passes)
    _id="${rom##*/}"; _id="${_id%.*}"
    run_emu vita3k -r "${_id}" ;;
  wiiu)
    /usr/lib/pocknix/pocknix-cemu-profile 2>/dev/null || true   # pad GUID differs per session
    run_emu cemu -f -g "${rom}" ;;

  *)
    echo "pocknix-play: unknown system '${system}' (see /usr/bin/pocknix-play for the mapping)" >&2
    exit 2 ;;
esac
