#!/usr/bin/python3
# pocknix-store status --json | follow                      (as the user)
# pocknix-store install|remove <id>... | install-all | remove-all   (root, via pkexec)
# pocknix-store adopt [--later]                                     (root, the alpm hook)
# pocknix-store setup <id>       (root) the entry's setup step again: tailscale logout clears the
#                                operator, and Pocknix Tools restores it before signing in
# Root commands take catalogue ids, never package names: the polkit rule allows this program with
# any arguments, so the ids are the allowlist. pacman runs in the pocknix-job unit `store`, which
# re-enters this program as `job <command> <id>...` and resolves the ids again there.
# Exit: 0 done, 1 error, 2 usage or unknown id, 3 busy (a store job or another pacman is running).
import json
import os
import pwd
import re
import subprocess
import sys
import time

SHARE = "/usr/share/pocknix-store"
TILES = ("/usr/share/pocknix-emulation/steam", "/usr/share/pocknix/tiles")
JOB = "/usr/lib/pocknix-ui/pocknix-job"
PACMAN = "/usr/lib/pocknix-ui/pocknix-pacman"
SELF = "/usr/bin/pocknix-store"
ROMS_INIT = "/usr/bin/pocknix-roms-init"
TILES_CLI = "/usr/bin/pocknix-tiles"
LOCK = "/var/lib/pacman/db.lck"
META = "pocknix-emulation-full"
# the pre-split package name, an empty package depending on the meta: it goes with the meta
ALIAS = "pocknix-emulation"
EMU = re.compile(r"pocknix-emu-[a-z0-9-]+")
ID = re.compile(r"[a-z0-9][a-z0-9-]*")
UNIT = re.compile(r"[a-z0-9][a-z0-9@._-]*\.(service|socket)")
SECTIONS = {"emulation": "Emulation", "compatibility": "Compatibility",
            "network": "Network", "streaming": "Streaming", "desktop": "Desktop mode"}
GENERIC_ICON = "applications-games"
OK, ERROR, USAGE, BUSY = 0, 1, 2, 3


class Fail(Exception):
    def __init__(self, msg: str, code: int = ERROR):
        super().__init__(msg)
        self.code = code


def out(line: str) -> None:
    print(line, flush=True)


def progress(**kw) -> None:
    out("POCKNIX:" + json.dumps(kw))


def pacman_q(*args: str) -> list[str]:
    r = subprocess.run(["pacman", *args], capture_output=True, text=True,
                       env=dict(os.environ, LC_ALL="C"))
    return r.stdout.splitlines()


def read_conf(path: str) -> dict:
    m = {}
    with open(path) as f:
        for line in f:
            k, sep, v = line.strip().partition("=")
            if sep and not k.startswith("#"):
                m[k.strip()] = v.strip()
    return m


def device_options(local: set[str]) -> set[str]:
    """The installed device meta's optdepends: which build of a per-SoC package fits this GPU."""
    opts, inside = set(), False
    metas = [p for p in local if p.startswith("pocknix-device-")]
    for line in pacman_q("-Qi", *metas) if metas else []:
        if line.startswith("Optional Deps"):
            inside, line = True, line.partition(":")[2]
        elif inside and not line[:1].isspace():
            inside = False
        if inside:
            name = line.strip().split(":", 1)[0].strip()
            if name and name != "None":
                opts.add(name)
    return opts


def entries(local: set[str], sync: set[str]) -> dict[str, dict]:
    """Entries whose packages are all hosted (local sync db: new ones appear after the next -Syu)
    or installed. Of an entry's variants, the one the device meta lists; none listed hides it."""
    found, claimed, opts = {}, set(), None
    try:
        names = sorted(os.listdir(f"{SHARE}/catalogue.d"))
    except OSError:
        names = []
    for n in names:
        eid = n[:-len(".conf")]
        if not n.endswith(".conf") or not ID.fullmatch(eid):
            continue
        try:
            c = read_conf(f"{SHARE}/catalogue.d/{n}")
        except OSError:
            continue
        pkgs, variants = c.get("packages", "").split(), c.get("variants", "").split()
        if variants:
            claimed.update(variants)
            opts = device_options(local) if opts is None else opts
            pick = [v for v in variants if v in opts][:1]
            if not pick:
                continue
            pkgs += pick
        if not pkgs or c.get("section") not in SECTIONS:
            continue
        claimed.update(pkgs)
        if all(p in sync or p in local for p in pkgs):
            found[eid] = {"name": c.get("name") or eid, "section": c["section"],
                          "description": c.get("description", ""), "icon": c.get("icon", ""),
                          "packages": pkgs, "tile": c.get("tile", ""),
                          "services": [u for u in c.get("services", "").split() if UNIT.fullmatch(u)],
                          "setup": c.get("setup", ""), "note": c.get("note", "")}
    # A new emulator's glue package shows without a store update, under its package description.
    new = sorted(p for p in (sync | local) if EMU.fullmatch(p) and p not in claimed
                 and p[len("pocknix-emu-"):] not in found)
    desc = {}
    if new:
        name = None
        for line in pacman_q("-Si", *new):
            k, _, v = line.partition(":")
            if k.strip() == "Name":
                name = v.strip()
            elif k.strip() == "Description" and name:
                desc[name] = v.strip()
    for p in new:
        eid = p[len("pocknix-emu-"):]
        found[eid] = {"name": eid, "section": "emulation", "description": desc.get(p, ""),
                      "icon": "", "packages": [p], "tile": eid, "services": [], "setup": "", "note": ""}
    return found


def icon(name: str) -> str:
    if name and "/" not in name and os.path.isfile(f"{SHARE}/icons/{name}"):
        return f"file://{SHARE}/icons/{name}"
    return name or GENERIC_ICON


def installed(e: dict, local: set[str]) -> bool:
    return all(p in local for p in e["packages"])


def mode(found: dict, local: set[str]) -> str:
    if META in local:
        return "all"
    emus = [e for e in found.values() if e["section"] == "emulation"]
    return "pick" if any(installed(e, local) for e in emus) else "none"


def job_state() -> str:
    if not os.access(JOB, os.X_OK):
        return "none"
    r = subprocess.run([JOB, "status", "store"], capture_output=True, text=True)
    return r.stdout.strip() or "none"


def resettable() -> set[str]:
    if not os.access(ROMS_INIT, os.X_OK):
        return set()
    r = subprocess.run([ROMS_INIT, "--list"], capture_output=True, text=True)
    return {line.split("\t", 1)[0] for line in r.stdout.splitlines() if line}


def status() -> int:
    local, sync = set(pacman_q("-Qq")), set(pacman_q("-Slq"))
    found = entries(local, sync)
    reset = resettable()
    tiles = os.access(TILES_CLI, os.X_OK)
    rows = []
    for eid, e in found.items():
        on = installed(e, local)
        tile = e["tile"] if on and tiles and e["tile"] and any(
            os.path.isfile(f"{d}/{e['tile']}.conf") for d in TILES) else ""
        rows.append({"id": eid, "name": e["name"], "section": e["section"],
                     "description": e["description"], "icon": icon(e["icon"]), "note": e["note"],
                     "installed": on, "tile": tile, "reset": on and eid in reset})
    used = {r["section"] for r in rows}
    out(json.dumps({"mode": mode(found, local), "job": job_state(),
                    "sections": [{"id": s, "name": n} for s, n in SECTIONS.items() if s in used],
                    "entries": rows}))
    return OK


def need_root() -> None:
    if os.geteuid() != 0:
        raise Fail("must run as root (pkexec pocknix-store ...)")


def not_busy() -> None:
    if os.path.exists(LOCK):
        raise Fail("another install or update is running: try again when it has finished", BUSY)


def resolve(cmd: str, ids: list[str], found: dict) -> list[str]:
    if cmd in ("install-all", "remove-all"):
        if ids:
            raise Fail(f"{cmd} takes no ids", USAGE)
        return []
    if not ids:
        raise Fail(f"{cmd} needs at least one id", USAGE)
    unknown = [i for i in ids if i not in found]
    if unknown:
        raise Fail(f"unknown id: {' '.join(unknown)}", USAGE)
    return list(dict.fromkeys(ids))


def depends_of(pkg: str, local: set[str]) -> list[str]:
    """Its depends from the local db, or from the sync db when it is not installed."""
    deps, inside = [], False
    for line in pacman_q("-Qi" if pkg in local else "-Si", pkg):
        if line.startswith("Depends On"):
            inside, line = True, line.partition(":")[2]
        elif inside and not line[:1].isspace():
            break
        if inside:
            deps += [re.split(r"[<>=]", d, maxsplit=1)[0] for d in line.split() if d != "None"]
    return deps


def mark(how: str, pkgs: list[str]) -> None:
    if pkgs:
        run_pacman(["-D", how, "--quiet", *pkgs])


def run_pacman(args: list[str]) -> None:
    out("$ pacman " + " ".join(args))
    if subprocess.run([PACMAN, *args]).returncode != 0:
        raise Fail(f"pacman {args[0]} failed")


def members(local: set[str]) -> list[str]:
    """The layer's installed packages: the meta's depends plus each pocknix-emu-*'s emulators (older
    devices have those explicit). SRM's depends are system libraries, never walked."""
    found = []
    for p in depends_of(META, local):
        found.append(p)
        if EMU.fullmatch(p):
            found += depends_of(p, local)
    return [p for p in dict.fromkeys(found) if p in local]


def do_install(pkgs: list[str]) -> None:
    # -Syu, never -Sy: a refreshed index on an un-upgraded system is the partial-upgrade trap.
    run_pacman(["-Syu", "--needed", "--noconfirm", *pkgs])


def to_deps(pkgs: list[str]) -> list[str]:
    """Marks the explicitly installed ones as dependencies, so -Rs takes them, and returns those:
    if the removal then fails they must get their mark back, or an orphan cleanup removes them."""
    explicit = set(pacman_q("-Qqe"))
    flipped = [p for p in dict.fromkeys(pkgs) if p in explicit]
    mark("--asdeps", flipped)
    return flipped


def remove_marked(targets: list[str], flipped: list[str]) -> None:
    try:
        run_pacman(["-Rs", "--noconfirm", *dict.fromkeys(targets)])
    except Fail:
        mark("--asexplicit", flipped)
        raise


def do_remove(ids: list[str], found: dict, local: set[str]) -> None:
    # A package another installed entry lists stays (gnome-keyring serves every desktop).
    kept = {p for i, e in found.items() if i not in ids and installed(e, local) for p in e["packages"]}
    targets = [p for i in ids for p in found[i]["packages"] if p in local and p not in kept]
    if not targets:
        out("Nothing to remove: not installed.")
        return
    if META in local:
        layer = depends_of(META, local)
        if any(p in layer for p in targets):
            # All -> Pick: the rest of the layer stays, now installed for its own sake.
            out("Emulation switches to picked emulators: the others stay installed.")
            mark("--asexplicit", [p for p in layer if p in local and p not in targets])
            targets += [META] + ([ALIAS] if ALIAS in local else [])
    # explicit on devices fielded before the metas, which -Rs would keep
    flipped = to_deps([d for p in targets if EMU.fullmatch(p) for d in depends_of(p, local) if d in local])
    remove_marked(targets, flipped)


def do_remove_all(local: set[str]) -> None:
    m = members(local)
    if META not in local and not m:
        out("Nothing to remove: emulation is not installed.")
        return
    flipped = to_deps(m)
    # name only members nothing else needs (fuse2 serves fex-emu too); -Rs cascades the rest
    orphans = set(pacman_q("-Qdtq"))
    targets = [p for p in (META, ALIAS) if p in local] + [p for p in m if p in orphans]
    # ~/Emulation, ~/ES-DE and config dirs stay: a reinstall finds the user's settings as left
    remove_marked(targets, flipped)


def seat_user() -> str | None:
    """The user of the active session on seat0: the one the device belongs to."""
    r = subprocess.run(["loginctl", "show-seat", "seat0", "-P", "ActiveSession"],
                       capture_output=True, text=True)
    if not r.stdout.strip():
        return None
    r = subprocess.run(["loginctl", "show-session", r.stdout.strip(), "-P", "Name"],
                       capture_output=True, text=True)
    return r.stdout.strip() or None


def setup_tailscale_operator() -> None:
    # The user then runs tailscale up/down/login (Pocknix Tools) without root.
    uid = os.environ.get("PKEXEC_UID", "")
    user = pwd.getpwuid(int(uid)).pw_name if uid.isdigit() else seat_user()
    if not user:
        out("No signed-in user: run `sudo tailscale set --operator=<you>` later.")
        return
    for _ in range(10):
        if subprocess.run(["tailscale", "set", f"--operator={user}"]).returncode == 0:
            out(f"Tailscale: {user} may control it without root.")
            return
        time.sleep(1)
    raise Fail("tailscale set --operator failed")


# The only steps a catalogue entry can ask for: the file names one, never a command.
SETUP = {"tailscale-operator": setup_tailscale_operator}


def services(ids: list[str], found: dict, on: bool) -> None:
    for u in (u for i in ids for u in found[i]["services"]):
        out(f"$ systemctl {'enable' if on else 'disable'} --now {u}")
        if subprocess.run(["systemctl", "enable" if on else "disable", "--now", u]).returncode != 0 and on:
            raise Fail(f"{u} did not start")


def setup(eid: str) -> int:
    need_root()
    local, sync = set(pacman_q("-Qq")), set(pacman_q("-Slq"))
    found = entries(local, sync)
    resolve("setup", [eid], found)
    e = found[eid]
    if not installed(e, local) or e["setup"] not in SETUP:
        raise Fail(f"{eid}: not installed, or no setup step", USAGE)
    services([eid], found, on=True)
    SETUP[e["setup"]]()
    return OK


def job(cmd: str, ids: list[str]) -> int:
    need_root()
    not_busy()
    local, sync = set(pacman_q("-Qq")), set(pacman_q("-Slq"))
    found = entries(local, sync)
    ids = resolve(cmd, ids, found)
    if cmd == "install":
        do_install([p for i in ids for p in found[i]["packages"]])
        services(ids, found, on=True)
        for step in (found[i]["setup"] for i in ids if found[i]["setup"]):
            if step in SETUP:
                SETUP[step]()
    elif cmd == "install-all":
        do_install([META])
    elif cmd == "remove":
        running = [i for i in ids if installed(found[i], local)]
        services(running, found, on=False)
        try:
            do_remove(ids, found, local)
        except Fail:
            # still installed: give its services back
            try:
                services(running, found, on=True)
            except Fail:
                pass
            raise
    else:
        do_remove_all(local)
    progress(phase="done", text="Done", progress=1)
    return OK


def adopt(later: bool) -> int:
    """Marks installed non-Emulation catalogue packages nothing requires as explicit, or orphan
    cleanup removes one a meta stopped requiring (Proton). Emulation keeps its All/Pick marks."""
    need_root()
    if later:
        # The hook runs while pacman holds its lock: the marking waits in a unit of its own.
        if not os.path.isdir("/run/systemd/system"):
            out("pocknix-store adopt: no systemd (image build), skipped")
            return OK
        subprocess.run(["systemd-run", "--quiet", "--no-block", "--collect",
                        "--unit", "pocknix-store-adopt", SELF, "adopt"], capture_output=True)
        return OK
    for _ in range(600):
        if not os.path.exists(LOCK):
            break
        time.sleep(1)
    else:
        raise Fail("pacman stayed busy for 10 minutes: nothing adopted", BUSY)
    local, sync = set(pacman_q("-Qq")), set(pacman_q("-Slq"))
    mine = {p for e in entries(local, sync).values() if e["section"] != "emulation"
            for p in e["packages"]}
    # -tt: a package that is only some meta's optdepends counts as unrequired; -Qdt hides it.
    todo = sorted(mine & set(pacman_q("-Qdttq")))
    if todo:
        mark("--asexplicit", todo)
    out(f"adopted: {' '.join(todo) or 'nothing'}")
    return OK


def start(cmd: str, ids: list[str]) -> int:
    need_root()
    not_busy()
    local, sync = set(pacman_q("-Qq")), set(pacman_q("-Slq"))
    ids = resolve(cmd, ids, entries(local, sync))
    os.execv(JOB, [JOB, "run", "store", "--", SELF, "job", cmd, *ids])


USAGE_TEXT = ("usage: pocknix-store status --json | follow | install <id>... | remove <id>... "
              "| install-all | remove-all | adopt [--later] | setup <id>")
ROOT_COMMANDS = ("install", "remove", "install-all", "remove-all")


def main() -> int:
    args = sys.argv[1:]
    try:
        if args == ["status", "--json"]:
            return status()
        if args == ["follow"]:
            os.execv(JOB, [JOB, "follow", "store"])
        if len(args) == 2 and args[0] == "setup":
            return setup(args[1])
        if args in (["adopt"], ["adopt", "--later"]):
            return adopt(later=len(args) == 2)
        if args[:1] and args[0] in ROOT_COMMANDS:
            return start(args[0], args[1:])
        if len(args) >= 2 and args[0] == "job" and args[1] in ROOT_COMMANDS:
            return job(args[1], args[2:])
    except Fail as e:
        print(f"pocknix-store: {e}", file=sys.stderr, flush=True)
        return e.code
    print(USAGE_TEXT, file=sys.stderr)
    return USAGE


if __name__ == "__main__":
    sys.exit(main())
