 class GPCalibrate:
     def __init__(self):
-        pyxel.init(320, 240, title=TITLE,fps=FPS, quit_key=pyxel.KEY_ESCAPE, display_scale=1)
+        pyxel.init(320, 240, title=TITLE,fps=FPS, quit_key=pyxel.KEY_ESCAPE, display_scale=DISPLAY_SCALE)
 
         pyxel.load("assets/gpcal.pyxres")
         
@@ -138,17 +139,20 @@
         self.draw_control_hint(14,225)
         
     def save_calibration(self):
-        savepath = Path.home() / ".config" / "autostart"
-        savepath.mkdir(parents=True,exist_ok=True)
-        savepath = savepath / "GPcal.sh"
-        self.ui_gamepad.calibration.save_configuration(savepath)
-        savepath.chmod(0o777)
-        self.ui_textbox_info.settext(f"Calibration data saved to")
-        self.ui_textbox_info.settext(f"{savepath}")
+        # pocknix: persist to a conf a systemd unit replays at boot, so the
+        # calibration also applies in gaming mode. Upstream wrote a bash script
+        # into ~/.config/autostart, which nothing on pocknix would run.
+        CONFIG_PATH.parent.mkdir(parents=True,exist_ok=True)
+        self.ui_gamepad.calibration.save_configuration(CONFIG_PATH)
+        CONFIG_PATH.chmod(0o644)
+        self.ui_textbox_info.settext(f"Calibration saved, it is restored")
+        self.ui_textbox_info.settext(f"on every boot")
         self.ui_textbox_info.settext("Where to sail now captain ?")
 
     def reset_calibration(self):
+        # Dropping the conf too is the escape hatch from a bad calibration.
         self.ui_gamepad.calibration.reset_all()
+        CONFIG_PATH.unlink(missing_ok=True)
         self.ui_textbox_info.settext("Calibration data reset to default")
         self.ui_textbox_info.settext("Where to sail now captain ?")
 
