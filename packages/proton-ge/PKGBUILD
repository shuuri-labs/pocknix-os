# proton-ge — GE-Proton ARM64 build as a system compat tool.
# Constant tool dir + internal name, so a bump swaps files under existing per-game selections.
pkgname=proton-ge
_srctag=GE-Proton11-3
_ver=${_srctag#GE-Proton}
_major=${_ver%%-*}
pkgver=${_ver//-/.}
pkgrel=2
pkgdesc="GE-Proton (official ARM64 build) as a system Steam compatibility tool"
arch=('aarch64')
url="https://github.com/GloriousEggroll/proton-ge-custom"
license=('BSD' 'LGPL' 'zlib' 'MIT' 'MPL' 'custom')
depends=('bash' 'python' 'pocknix-steam')
options=('!strip' 'emptydirs')
source=("https://github.com/GloriousEggroll/proton-ge-custom/releases/download/${_srctag}/${_srctag}-aarch64.tar.gz"
        'compatibilitytool.vdf.in'
        'toolmanifest.vdf'
        'pocknix-proton')
sha512sums=('703fe0f1722e55300f14f425e5985bc903669ee29b9647cfdb8120cb5b361efc8b26bb68cd601daeb612ae2d5c5e615065d375650e6da84f82e8c14fcae48c90'
            'SKIP'
            'SKIP'
            'SKIP')

build() {
  sed "s|@VER@|${_major}|" compatibilitytool.vdf.in > compatibilitytool.vdf
}

package() {
  local tooldir="usr/share/steam/compatibilitytools.d/${pkgname}"
  # Upstream has moved the tarball's top-level dir name between releases; find it.
  local dist
  dist="$(find "${srcdir}" -maxdepth 1 -mindepth 1 -type d -name 'GE-Proton*' | head -1)"
  [ -n "${dist}" ] || return 1

  mkdir -p "${pkgdir}/${tooldir}"
  cp -a "${dist}/." "${pkgdir}/${tooldir}/"

  # Ours over upstream's: constant internal name, and no require_tool_appid (GE's asks for
  # SLR 4.0 Arm64 / appid 4185400, which Steam cannot download on a fresh install).
  install -Dm644 "${srcdir}/compatibilitytool.vdf" "${pkgdir}/${tooldir}/compatibilitytool.vdf"
  install -Dm644 "${srcdir}/toolmanifest.vdf"      "${pkgdir}/${tooldir}/toolmanifest.vdf"
  install -Dm755 "${srcdir}/pocknix-proton"        "${pkgdir}/${tooldir}/pocknix-proton"

  local f
  for f in LICENSE LICENSE.OFL PATENTS.AV1; do
    if [ -f "${pkgdir}/${tooldir}/${f}" ]; then
      install -Dm644 "${pkgdir}/${tooldir}/${f}" "${pkgdir}/usr/share/licenses/${pkgname}/${f}"
      rm -f "${pkgdir}/${tooldir}/${f}"
    fi
  done
}
