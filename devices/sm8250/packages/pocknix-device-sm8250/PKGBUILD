# pocknix-device-sm8250 — metapackage: the per-SoC members of an SM8250 system.
# ONLY per-SoC packages belong here (BSP, kernel, bootloader, the SoC's proton
# choice, calibration); shared members live on pocknix-core / the
# pocknix-*-full layers — a dep edge from here would block `pacman -Rs` of an
# optional layer.
pkgname=pocknix-device-sm8250
pkgver=0.1.0
pkgrel=8
pkgdesc="pocknix device metapackage: SM8250 family (RP5, RP Flip 2)"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL2')
depends=('pocknix-bsp-sm8250'
         'linux-pocknix-sm8250'
         'pocknix-bootloader-sm8250'
         # a6xx lacks 8-bit storage -> DXVK 3 rejects the GPU: dxvk2-pinned protons
         'proton-cachyos-dxvk2'
         'proton-ge-dxvk2'
         # a6xx donor prep swaps into downloaded Valve ARM Protons (dep edge = delivery)
         'pocknix-dxvk2-donor'
         # sm8250-only: the raw trigger view reads retroid/mangmi ABS_HAT2X/Y, dead on
         # rsinput. A dep edge, not a list entry: -Syu never installs a new package name.
         'pocknix-gamepad-calibration')
# Exactly one device metapackage per install (wrong-device guard, same pattern
# as the BSPs).
provides=('pocknix-device')
conflicts=('pocknix-device')

package() {
  :   # pure metapackage
}
