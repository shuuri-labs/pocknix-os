# One package serves every SM8250 board: device.conf picks a boards/ file by devicetree
# model and the input maps are model-gated, so a new board needs no new package.
pkgname=pocknix-bsp-sm8250
pkgver=0.1.0
pkgrel=27
pkgdesc="pocknix board support: SM8250 family (RP5, RP Flip 2) — runtime board dispatch, input maps, audio UCM, wake quirks"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL-2.0-or-later')
# An older bsp-common has no speaker DSP renderer, so the board profiles would sit unused.
depends=('pocknix-bsp-common>=0.1.0-29')
install=pocknix-bsp-sm8250.install
# Exactly one device BSP may be installed (wrong-device guard for a shared repo).
provides=('pocknix-bsp')
conflicts=('pocknix-bsp')
optdepends=('inputplumber: gamepad -> Steam Input mapping (01-retroid-*.yaml)'
            'alsa-ucm-conf: base UCM (codec include sequences for the RetroidPocket UCM)')

package() {
  # scripts/render-bsp.sh renders device.conf and family.conf into ./staged (build-packages.sh).
  install -Dm644 "${startdir}/staged/device.conf" "${pkgdir}/usr/lib/pocknix/device.conf"
  # root/ is the install tree. makepkg's umask 022 turns git's exec bit into 755/644, and
  # files created under fakeroot are root-owned; -d keeps the symlinks as links. The units
  # ship enabled through their wants links so a plain pacman -U activates them, and the
  # extra UCM conf.d names are inert: only the card's own longname is looked up.
  cp -dr "${startdir}/root/." "${pkgdir}/"
  # boards/ also comes from startdir (build-packages.sh copies the whole package dir);
  # models is not installed, and the rendered family.conf replaces the committed one.
  local b
  for b in "${startdir}/boards/"*.conf "${startdir}/staged/family.conf"; do
    install -Dm644 "${b}" "${pkgdir}/usr/lib/pocknix/boards/$(basename "${b}")"
  done
}
