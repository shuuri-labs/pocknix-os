# Must sort after 90-linux-pocknix.hook, so a kernel upgrade already carries the new cmdline.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/lib/pocknix/kernel-cmdline

[Action]
Description = pocknix: syncing the boot image cmdline...
When = PostTransaction
Exec = /usr/lib/pocknix/pocknix-cmdline-sync
