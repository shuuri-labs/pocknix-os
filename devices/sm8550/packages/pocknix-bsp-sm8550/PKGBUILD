pkgname=pocknix-bsp-sm8550
pkgver=0.2.0
pkgrel=13
pkgdesc="pocknix board support: SM8550 family (RP6, Nova, Odin 2 family, Thor) — runtime board dispatch, input maps, suspend quirks, audio UCM, dual-screen touch policy"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL2')
# The firmware reaches the fleet through this edge: -Syu never installs a new name alone.
depends=('pocknix-bsp-common' 'pocknix-firmware-sm8550')
# One BSP per device (wrong-device guard); replaces= migrates the retired per-device BSPs.
provides=('pocknix-bsp')
conflicts=('pocknix-bsp')
replaces=('pocknix-bsp' 'pocknix-bsp-rp6' 'pocknix-bsp-odin2' 'pocknix-bsp-odin2mini' 'pocknix-bsp-odin2portal')
optdepends=('inputplumber: gamepad -> Steam Input mapping (01-rsinput-controller.yaml, 02-ayn-thor-controller.yaml)'
            'alsa-ucm-conf: base UCM (codec include sequences for the AYN-Odin2 / AYN-Thor UCMs)')
source=('device.conf'
        '01-rsinput-controller.yaml' 'sm8550-gamepad.yaml'
        '02-ayn-thor-controller.yaml' 'thor-gamepad.yaml'
        'AYN-Odin2.conf' 'HiFi.conf' 'AYN-Thor.conf' 'HiFi-Thor.conf'
        '71-pocknix-thor-touch.rules'
        '10-pocknix-s2idle.conf' '30-pocknix-cpuidle.conf'
        '99-pocknix-sm8550-usb-autosuspend.rules'
        'cpuidle-state1-sleep-pre' 'cpuidle-state1-sleep-post'
        'kernel-cmdline' 'pocknix-cmdline-sync' '91-pocknix-cmdline.hook')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  # makepkg sources are flat, so boards/ comes from startdir (build-packages.sh fills it).
  install -Dm644 "${srcdir}/device.conf" "${pkgdir}/usr/lib/pocknix/device.conf"
  local b
  for b in "${startdir}/boards/"*.conf; do
    install -Dm644 "${b}" "${pkgdir}/usr/lib/pocknix/boards/$(basename "${b}")"
  done

  # The cluster-sleep kernel stack is s2idle-only; a deep entry wedges.
  install -Dm644 "${srcdir}/10-pocknix-s2idle.conf" \
    "${pkgdir}/usr/lib/systemd/sleep.conf.d/10-pocknix-s2idle.conf"
  # cpu0 idle state1 off while awake: GMU issues.
  install -Dm644 "${srcdir}/30-pocknix-cpuidle.conf" \
    "${pkgdir}/usr/lib/tmpfiles.d/30-pocknix-cpuidle.conf"
  # An idle DWC3 otherwise holds its USB-to-DDR interconnect vote while awake.
  install -Dm644 "${srcdir}/99-pocknix-sm8550-usb-autosuspend.rules" \
    "${pkgdir}/usr/lib/udev/rules.d/99-pocknix-sm8550-usb-autosuspend.rules"
  install -Dm644 "${srcdir}/71-pocknix-thor-touch.rules" \
    "${pkgdir}/usr/lib/udev/rules.d/71-pocknix-thor-touch.rules"
  # Re-enable cpu0 state1 only across suspend, so s2idle reaches cluster sleep without
  # touching the awake-time GMU workaround.
  install -Dm755 "${srcdir}/cpuidle-state1-sleep-pre" \
    "${pkgdir}/usr/lib/pocknix/sleep.d/pre/010-cpuidle-state1"
  install -Dm755 "${srcdir}/cpuidle-state1-sleep-post" \
    "${pkgdir}/usr/lib/pocknix/sleep.d/post/010-cpuidle-state1"

  install -Dm644 "${srcdir}/01-rsinput-controller.yaml" \
    "${pkgdir}/usr/share/inputplumber/devices/01-rsinput-controller.yaml"
  install -Dm644 "${srcdir}/sm8550-gamepad.yaml" \
    "${pkgdir}/usr/share/inputplumber/capability_maps/sm8550-gamepad.yaml"
  install -Dm644 "${srcdir}/02-ayn-thor-controller.yaml" \
    "${pkgdir}/usr/share/inputplumber/devices/02-ayn-thor-controller.yaml"
  install -Dm644 "${srcdir}/thor-gamepad.yaml" \
    "${pkgdir}/usr/share/inputplumber/capability_maps/thor-gamepad.yaml"

  # Family boards report card "AYN-Odin2", the Thor "AYN-Thor".
  local ucm="${pkgdir}/usr/share/alsa/ucm2"
  install -Dm644 "${srcdir}/AYN-Odin2.conf" "${ucm}/AYN/Odin2/AYN-Odin2.conf"
  install -Dm644 "${srcdir}/HiFi.conf"      "${ucm}/AYN/Odin2/HiFi.conf"
  install -d "${ucm}/conf.d/sm8550"
  ln -sf "../../AYN/Odin2/AYN-Odin2.conf" "${ucm}/conf.d/sm8550/AYN-Odin2.conf"
  install -Dm644 "${srcdir}/AYN-Thor.conf" "${ucm}/AYN/Thor/AYN-Thor.conf"
  install -Dm644 "${srcdir}/HiFi-Thor.conf" "${ucm}/AYN/Thor/HiFi.conf"
  ln -sf "../../AYN/Thor/AYN-Thor.conf" "${ucm}/conf.d/sm8550/AYN-Thor.conf"

  # build-packages.sh asserts it matches devices/sm8550/profile.conf.
  install -Dm644 "${srcdir}/kernel-cmdline" "${pkgdir}/usr/lib/pocknix/kernel-cmdline"
  install -Dm755 "${srcdir}/pocknix-cmdline-sync" "${pkgdir}/usr/lib/pocknix/pocknix-cmdline-sync"
  install -Dm644 "${srcdir}/91-pocknix-cmdline.hook" \
    "${pkgdir}/usr/share/libalpm/hooks/91-pocknix-cmdline.hook"
}
