# ayn_mcu.yaml maps BTN_BACK (Quick Access) to gamepad QuickAccess, not keyboard F1:
# Steam has no Quick Access button otherwise.
pkgname=pocknix-bsp-sm8750
pkgver=0.2.0
pkgrel=2
pkgdesc="pocknix board support: SM8750 family (AYN Odin 3) — runtime board dispatch, input maps, audio UCM"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL-2.0-or-later')
# pocknix-firmware-sm8750 rides this dep edge to the fleet: -Syu never installs
# a new package name without one
depends=('pocknix-bsp-common' 'pocknix-firmware-sm8750')
# Exactly one device BSP may be installed (wrong-device guard for a shared repo).
provides=('pocknix-bsp')
conflicts=('pocknix-bsp')
optdepends=('inputplumber: gamepad -> Steam Input mapping (01-ayn-controller.yaml)'
            'alsa-ucm-conf: base UCM (codec include sequences for the AYN-Odin3 UCM)')
# device.conf is rendered from boards/models. Consumers source it (some under set -e, cores.sh
# inside $(...)), so it stays POSIX sh, prints nothing and always returns 0.
_device_conf() {  # $1 = boards/models
  awk -v q="'" '
    /^[[:space:]]*(#|$)/ { next }
    {
      b = $1; m = $0
      sub(/^[[:space:]]*[^[:space:]]+[[:space:]]+/, "", m); sub(/[[:space:]]+$/, "", m)
      if (fb == "") fb = b
      arms = arms "  \"" m "\")\n    . /usr/lib/pocknix/boards/" b ".conf\n    ;;\n"
    }
    END {
      print "# /usr/lib/pocknix/device.conf, generated from the BSP" q "s boards/models: picks the board"
      print "# file by devicetree model. An unknown or absent model (the image-build chroot) gets"
      print "# the first board and POCKNIX_BOARD_UNKNOWN=1. /etc/pocknix/device.conf overrides."
      print "_pocknix_model=\"$(cat /proc/device-tree/model 2>/dev/null | tr -d " q "\\0" q ")\""
      print "case \"${_pocknix_model}\" in"
      printf "%s", arms
      print "  *)"
      print "    POCKNIX_BOARD_UNKNOWN=1"
      print "    . /usr/lib/pocknix/boards/" fb ".conf"
      print "    [ -n \"${_pocknix_model}\" ] && \\"
      print "      logger -t pocknix \"device.conf: unknown DT model " q "${_pocknix_model}" q " - using " fb " board defaults\" 2>/dev/null || true"
      print "    ;;"
      print "esac"
      print "unset _pocknix_model"
    }' "$1"
}

package() {
  install -d "${pkgdir}/usr/lib/pocknix"
  _device_conf "${startdir}/boards/models" > "${pkgdir}/usr/lib/pocknix/device.conf"
  # root/ is the install tree. makepkg's umask 022 turns git's exec bit into 755/644, and
  # files created under fakeroot are root-owned; -d keeps the UCM symlink as a link (it is
  # named for the card longname SM8750-AYN; codec sequences come from base alsa-ucm-conf).
  cp -dr "${startdir}/root/." "${pkgdir}/"
  # boards/ also comes from startdir (build-packages.sh copies the whole package dir);
  # models is not installed, family.conf is.
  local b
  for b in "${startdir}/boards/"*.conf; do
    install -Dm644 "${b}" "${pkgdir}/usr/lib/pocknix/boards/$(basename "${b}")"
  done
}
