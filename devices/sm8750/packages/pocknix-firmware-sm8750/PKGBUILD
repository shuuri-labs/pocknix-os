# Odin 3 firmware upstream linux-firmware lacks (ath12k WCN7860, ADSP/CDSP, audio topology).
# Pinned by commit + sha256, nothing in git. adsp.mbn/adsp_dtb.mbn come from a separate pin:
# that pair is the ADSP build that charges the battery. /usr/lib/firmware/updates/ wins the
# kernel's search and no ALARM package writes there, so linux-firmware updates never revert it.
pkgname=pocknix-firmware-sm8750
pkgver=0.1.0
pkgrel=1
pkgdesc="SM8750 family vendor firmware (Odin 3 wifi, ADSP/CDSP, audio), immune to linux-firmware updates"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('custom:qcom-firmware')   # Qualcomm vendor blobs
# firmware blobs must ship byte-identical; some parse as ELF and strip would alter them
options=('!strip')

_extrafw=30c56e2f34af37fe372166b739d6ab277f5155b5   # ROCKNIX/extra-firmware, SM8750/
_armada=e0143ceb8e5752ce2b991d8c4490b3cb5be1e1e3    # armada-os/armada, system_files/usr/lib/firmware/
_extrafw_files=(
  ath12k/WCN7860/hw2.0/amss.bin
  ath12k/WCN7860/hw2.0/aux_ucode.bin
  ath12k/WCN7860/hw2.0/bdwlan.elf
  ath12k/WCN7860/hw2.0/board-2.bin
  ath12k/WCN7860/hw2.0/m3.bin
  ath12k/WCN7860/hw2.0/qdss.cfg
  ath12k/WCN7860/hw2.0/regdb.bin
  qca/gngbtfw20.mbn
  qca/gngbtnv20.bin
  qcom/sm8750/SM8750-AYN-tplg.bin
  qcom/sm8750/ayn/odin3/adspr.jsn
  qcom/sm8750/ayn/odin3/adsps.jsn
  qcom/sm8750/ayn/odin3/adspua.jsn
  qcom/sm8750/ayn/odin3/adspuo.jsn
  qcom/sm8750/ayn/odin3/aw883xx_acf.bin
  qcom/sm8750/ayn/odin3/battmgr.jsn
  qcom/sm8750/ayn/odin3/cdsp.mbn
  qcom/sm8750/ayn/odin3/cdsp_dtb.mbn
  qcom/sm8750/ayn/odin3/cdspr.jsn
  qcom/sm8750/gen80000_zap.mbn
  qcom/vpu/vpu35_p4.mbn
)
_armada_files=(
  qcom/sm8750/ayn/odin3/adsp.mbn
  qcom/sm8750/ayn/odin3/adsp_dtb.mbn
)
source=()
for _f in "${_extrafw_files[@]}"; do
  source+=("${_f//\//_}::https://raw.githubusercontent.com/ROCKNIX/extra-firmware/${_extrafw}/SM8750/${_f}")
done
for _f in "${_armada_files[@]}"; do
  source+=("${_f//\//_}::https://raw.githubusercontent.com/armada-os/armada/${_armada}/system_files/usr/lib/firmware/${_f}")
done
