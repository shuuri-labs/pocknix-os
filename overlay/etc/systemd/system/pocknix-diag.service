[Unit]
Description=pocknix first-boot diagnostic dump (writes pocknix-diag.txt to the boot partition)
# Started by pocknix-diag.timer (OnBootSec=45s), NOT by the boot transaction. This unit
# used to be WantedBy=multi-user.target with After=multi-user.target, which kept
# multi-user.target in `activating` for the whole 30s sleep + dump and delayed the boot
# and the Steam session launch. The timer fires after boot has settled, so
# multi-user.target completes immediately.

[Service]
Type=oneshot
# delay so device probing AND a wifi association attempt have time to settle
ExecStartPre=/bin/sh -c 'sleep 30'
ExecStart=/usr/local/bin/pocknix-diag
RemainAfterExit=yes

# No [Install]: enabled via pocknix-diag.timer (WantedBy=timers.target).
