# One package per line; '#' comments and blank lines ignored.

# --- core system ---
base
systemd
systemd-sysvcompat
dbus-broker
mkinitcpio

# --- boot splash ---
plymouth

# --- package management ---
pacman-contrib       # paccache: stock pacman grows its cache without bound on the one rw fs

# --- networking ---
networkmanager
iwd
wireless-regdb
openssh

# --- filesystem / storage ---
e2fsprogs
dosfstools
btrfs-progs
util-linux
parted
rsync
cloud-guest-utils

# --- graphics stack ---
# Bootstrap only: install_local_packages replaces both with our [pocknix] builds.
mesa
vulkan-freedreno
vulkan-icd-loader
libdrm
mesa-utils
vulkan-tools

# --- firmware ---
# build-image.sh removes the tarball's linux-firmware meta, so every split a device loads is
# listed here. Adreno sqe/zap ship .zst: the kernel needs FW_LOADER_COMPRESS_ZSTD.
linux-firmware-qcom
linux-firmware-atheros   # wifi, bluetooth
linux-firmware-realtek   # USB Ethernet docks (rtl_nic)
linux-firmware-mediatek  # USB wifi dongles

# --- audio ---
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
rtkit               # deck has no blanket rtprio, so PipeWire's realtime goes through rtkit
alsa-utils
alsa-ucm-conf
swh-plugins         # pocknix-bsp-common dep (speaker DSP limiter)

# --- utilities ---
sudo
nano
less
htop
jq
zstd
python-evdev
bluez
bluez-utils
sbc                  # without a codec lib, BT headphones pair but give no audio sink
libfreeaptx

# --- power / battery ---
upower               # Steam's battery source, queried once at startup (pocknix-vpower feeds game mode from it): keep it enabled

# --- storage ---
udisks2              # Steam lists formattable drives only via UDisks2, once at startup: keep it enabled

# --- memory / swap ---
zram-generator
