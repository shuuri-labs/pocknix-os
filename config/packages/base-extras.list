# ALARM packages hosted in [pocknix-base] but installed by no image (opt-in via
# pacman -S on a locked device). The harvest only sees what a build installed, hence
# a hand list; every dep must be hosted too or snapshot-base.sh refuses.

# --- VPN / remote access ---
tailscale
wireguard-tools      # no openresolv for wg-quick DNS: conflicts with the base's systemd-resolvconf

# --- emulation layer (opt-in: no image installs it, the Pocknix Store does) ---
# Its ALARM deps, plus those of the old emulator source builds. Derive changes from an orphan
# set on a device, not from the snapshot guard: that reads the metas' and their glue packages'
# depends= only, never the emulators' own.
retroarch
libretro-core-info
ppsspp
ppsspp-assets        # ppsspp's own deps from here down
sdl2_ttf
openxr
jsoncpp
miniupnpc
glew
glu
boost-libs           # the old dolphin-emu/azahar/cemu source builds from here down
crypto++
enet
libspng
pugixml
sfml
soundtouch
zlib-ng

# --- desktop Plasma flavour (opt-in: pacman -S pocknix-desktop-plasma) ---
plasma-desktop
systemsettings
kmenuedit
polkit-kde-agent

# --- game streaming ---
moonlight-qt

# --- desktops (opt-in: hosted only, no image installs them) ---
# GNOME, COSMIC and Hyprland for desktop mode's session picker. The full closure is listed
# because the guard checks one dependency level; derive changes with pacman -Sp in a root
# whose local db is the base, not from the guard.
# shared: needed by more than one desktop (or by printing too)
gnome-keyring
xdg-desktop-portal-gtk
gcr
gcr-4
geoclue
gnome-desktop-common
gsound
gvfs
libcdio
libcdio-paranoia
libdbusmenu-glib
libdbusmenu-gtk3
libnma-common
playerctl
