From: theodotdot <59372255+theodotdot@users.noreply.github.com>
Subject: [PATCH] drm/panel: ddic-ch13726a: bend the backlight level with a per-panel gamma

The Thor's bottom AMOLED puts out visibly more light than the top panel at
the same raw backlight percentage, and every writer drives both to the same
percentage: PowerDevil merges the two raw nodes into one device and scales
each by the same fraction (#152), and Steam writes the first node directly
(#80). The panels cannot be matched that way.

Correcting it from a second writer in userspace cannot work. The bottom
node is on the same DSI link and one write to it costs ~33 ms, so a
correcting write can never land in the same frame as the one it corrects
and the panel steps visibly during kwin's animation; measured variants
(polling, settle after the burst, chasing the burst) all flash. Collapse it
to one write: bend the level here, so every writer is right by construction
and the sysfs range stays 0..255 for all of them.

The curve is x^gamma, gamma in thousandths, integer only: x^whole times the
square roots picked by the binary fractions of the remainder. It tracks an
exact pow() to within one level across the whole range and is monotonic.

Per panel and probably per unit, so it comes from the devicetree rather than
a compile-time constant:

  pocknix,brightness-gamma-milli = <2700>;   /* 2.7; absent or 1000 = linear */
  pocknix,brightness-min = <1>;              /* raw floor for a non-zero level */

A requested level of 0 stays 0 (the panel is off on purpose), and the floor
keeps a 1 % request dim rather than black: at gamma 2.7 a 1 % level rounds to
0/255, which makes the #108 darkness floor worse without a minimum. The
lowering happens inside backlight update_status, the driver's only write of
the brightness register; this driver has no restore path of its own (no
BL_CORE_SUSPENDRESUME, no brightness write in on()), so there is nothing
else to bend.

The level the panel is actually sent is logged at debug level, because the
sysfs readback stays the requested value by design (the backlight class
stores what userspace asked for) and there is no other way to see the curve
on a unit:

  echo 'file panel-ddic-ch13726a.c +p' | sudo tee /sys/kernel/debug/dynamic_debug/control
  journalctl -k -f | grep 'level '

Boards without the properties are byte-identical to before.
---
 drivers/gpu/drm/panel/panel-ddic-ch13726a.c | 72 ++++++++++++++++++++
 1 file changed, 71 insertions(+), 1 deletion(-)

--- a/drivers/gpu/drm/panel/panel-ddic-ch13726a.c
+++ b/drivers/gpu/drm/panel/panel-ddic-ch13726a.c
@@ -7,6 +7,7 @@
 #include <linux/backlight.h>
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
+#include <linux/math.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/regulator/consumer.h>
@@ -24,6 +25,8 @@
 	struct gpio_desc *reset_gpio;
 	const struct drm_display_mode *display_mode;
 	enum drm_panel_orientation orientation;
+	u32 brightness_gamma_milli;
+	u32 brightness_min;
 	bool prepared;
 };
 
@@ -195,12 +198,74 @@
 	.get_orientation = ch13726a_get_orientation,
 };
 
+#define CH13726A_Q32_ONE	(1ULL << 32)
+
+/*
+ * Panels do not put out the same light at the same raw backlight percentage,
+ * and every writer of these nodes (PowerDevil through kwin, Steam's own sysfs
+ * write, a plain echo) drives them to the same percentage. Correcting that from
+ * a second writer in userspace cannot work: a write to this panel costs ~33 ms
+ * on the DSI link, so a correcting write can never land in the same frame as
+ * the one it corrects and the panel visibly steps. Bend the curve here instead,
+ * inside the single write, so every writer is right by construction.
+ *
+ * gamma is a per-panel, probably per-unit property: integer only, x^gamma with
+ * gamma in thousandths, computed as x^whole times the square roots selected by
+ * the binary fractions of the remainder (1/2, 1/4, 1/8, ...). Good to within
+ * one level of an exact pow() over the whole 0..max range, monotonic.
+ */
+static u16 ch13726a_gamma_level(struct ch13726a_panel *ctx, u16 level)
+{
+	struct backlight_device *bl = ctx->panel.backlight;
+	u32 max = bl->props.max_brightness;
+	u32 gamma = ctx->brightness_gamma_milli;
+	u32 whole, frac, weight, out;
+	u64 acc = CH13726A_Q32_ONE;
+	u64 root, x;
+
+	if (!level)
+		return 0;
+
+	out = level;
+	if (max && level < max && gamma && gamma != 1000) {
+		x = ((u64)level << 32) / max;
+
+		for (whole = gamma / 1000; whole; whole--)
+			acc = (acc * x) >> 32;
+
+		frac = ((gamma % 1000) << 10) / 1000;
+		root = x;
+		for (weight = 512; weight; weight >>= 1) {
+			root = int_sqrt64(root << 32);
+			if (frac & weight)
+				acc = (acc * root) >> 32;
+		}
+
+		out = (u32)((acc * max + CH13726A_Q32_ONE / 2) >> 32);
+	}
+
+	/* A requested level above the floor stays above it, so 1 % is dim, not off */
+	if (out > max)
+		out = max;
+	if (out < ctx->brightness_min)
+		out = ctx->brightness_min;
+	if (out > max)
+		out = max;
+
+	return out;
+}
+
 static int ch13726a_bl_update_status(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
-	u16 brightness = backlight_get_brightness(bl);
+	struct ch13726a_panel *ctx = mipi_dsi_get_drvdata(dsi);
+	int level = backlight_get_brightness(bl);
+	u16 brightness = ch13726a_gamma_level(ctx, level);
 	int ret;
 
+	/* What the panel is actually sent, for calibrating the curve on a unit */
+	dev_dbg(&dsi->dev, "level %d -> %u\n", level, brightness);
+
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
 	ret = mipi_dsi_dcs_set_display_brightness(dsi, brightness);
@@ -243,6 +308,11 @@
 
 	ctx->display_mode = of_device_get_match_data(dev);
 
+	of_property_read_u32(dev->of_node, "pocknix,brightness-gamma-milli",
+			     &ctx->brightness_gamma_milli);
+	of_property_read_u32(dev->of_node, "pocknix,brightness-min",
+			     &ctx->brightness_min);
+
 	ctx->supplies[0].supply = "vdd1v2";
 	ctx->supplies[1].supply = "vddio";
 	ctx->supplies[2].supply = "vdd";
