+/* opmode of each DSPP color block; 0 = bypassed */
+static int dpu_debugfs_dspp_show(struct seq_file *s, void *v)
+{
+	struct dpu_kms *dpu_kms = s->private;
+	int i, ret;
+
+	ret = pm_runtime_resume_and_get(&dpu_kms->pdev->dev);
+	if (ret)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(dpu_kms->rm.dspp_blks); i++) {
+		const struct dpu_dspp_sub_blks *sblk;
+		struct dpu_hw_dspp *dspp;
+
+		if (!dpu_kms->rm.dspp_blks[i])
+			continue;
+		dspp = to_dpu_hw_dspp(dpu_kms->rm.dspp_blks[i]);
+		sblk = dspp->cap->sblk;
+		seq_printf(s, "dspp%d", i);
+		if (sblk->igc.version)
+			seq_printf(s, " igc %#x", DPU_REG_READ(&dspp->hw, sblk->igc.base));
+		if (sblk->pcc.base)
+			seq_printf(s, " pcc %#x", DPU_REG_READ(&dspp->hw, sblk->pcc.base));
+		if (sblk->gamut.base)
+			seq_printf(s, " gamut %#x", DPU_REG_READ(&dspp->hw, sblk->gamut.base));
+		if (sblk->gc.base)
+			seq_printf(s, " gc %#x", DPU_REG_READ(&dspp->hw, sblk->gc.base));
+		seq_puts(s, "\n");
+	}
+	pm_runtime_put_sync(&dpu_kms->pdev->dev);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(dpu_debugfs_dspp);
