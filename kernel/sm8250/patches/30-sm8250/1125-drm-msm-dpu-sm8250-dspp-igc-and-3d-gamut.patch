+/* every DSPP reserved for this CRTC must carry the LUT blocks the state uses */
+static int _dpu_crtc_check_cp_blocks(struct drm_crtc *crtc, struct drm_crtc_state *crtc_state)
+{
+	struct dpu_kms *dpu_kms = _dpu_crtc_get_kms(crtc);
+	struct dpu_crtc_state *cstate = to_dpu_crtc_state(crtc_state);
+	struct dpu_global_state *global_state;
+	struct dpu_hw_blk *hw_dspp[MAX_CHANNELS_PER_CRTC];
+	int i, num_dspp;
+
+	global_state = dpu_kms_get_global_state(crtc_state->state);
+	if (IS_ERR(global_state))
+		return PTR_ERR(global_state);
+
+	num_dspp = dpu_rm_get_assigned_resources(&dpu_kms->rm, global_state, crtc,
+						 DPU_HW_BLK_DSPP, hw_dspp, ARRAY_SIZE(hw_dspp));
+	for (i = 0; i < num_dspp; i++) {
+		struct dpu_hw_dspp *dspp = to_dpu_hw_dspp(hw_dspp[i]);
+
+		if ((crtc_state->degamma_lut && !dspp->ops.setup_igc) ||
+		    (cstate->lut3d && !dspp->ops.setup_gamut)) {
+			DRM_DEBUG_ATOMIC("crtc%d: dspp %d lacks the requested LUT block\n",
+					 crtc->base.id, dspp->idx - DSPP_0);
+			return -EINVAL;
+		}
+	}
+
+	return 0;
+}
+
 static int dpu_crtc_atomic_check(struct drm_crtc *crtc,
 		struct drm_atomic_commit *state)
 {
@@ -1555,14 +1642,28 @@
 
 	bool needs_dirtyfb = dpu_crtc_needs_dirtyfb(crtc_state);
 
-	/* don't reallocate resources if only ACTIVE has beeen changed */
-	if (crtc_state->mode_changed || crtc_state->connectors_changed ||
-	    crtc_state->color_mgmt_changed) {
+	/* DEGAMMA_LUT_SIZE only caps the blob; the IGC table needs every entry */
