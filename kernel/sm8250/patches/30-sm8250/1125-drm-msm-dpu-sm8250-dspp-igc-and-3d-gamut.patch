diff -ruN a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.c
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_dspp.c
@@ -2,6 +2,8 @@
 /* Copyright (c) 2015-2018, The Linux Foundation. All rights reserved.
  */
 
+#include <linux/mutex.h>
+
 #include <drm/drm_managed.h>
 
 #include "dpu_hwio.h"
@@ -115,6 +117,100 @@
 	DPU_REG_WRITE(&ctx->hw, base, reg);
 }
 
+static u16 lut_chan(const struct drm_color_lut *e, int chan)
+{
+	return chan == 0 ? e->red : chan == 1 ? e->green : e->blue;
+}
+
+/* DSPP_IGC v3.1: tables in the DSPP top behind one shared index, c0 = G, c1 = B, c2 = R;
+ * 257 samples at i / 256, and inputs above 1020 read the 257th, so it must be written */
+#define IGC_EN			BIT(0)
+#define IGC_TOP_OFF		0x300
+#define IGC_DATA_MASK		GENMASK(11, 0)
+#define IGC_INDEX_UPDATE	BIT(25)
+#define IGC_DSPP_SKIP(n)	((0xf & ~BIT(n)) << 28)
+#define IGC_SAMPLES		257
+
+/* the DSPP top's index is shared, so CRTCs committing in parallel must not interleave */
+static DEFINE_MUTEX(dpu_igc_lock);
+
+/* sample i of the hardware table sits at i / 256, DEGAMMA_LUT entry i at i / 255 */
+static u16 igc_sample(const struct drm_color_lut *lut, int i, int chan)
+{
+	int pos = i * (DPU_DEGAMMA_LUT_SIZE - 1);
+	int idx = pos / (IGC_SAMPLES - 1);
+	int frac = pos % (IGC_SAMPLES - 1);
+	int a = lut_chan(&lut[idx], chan);
+	int b = lut_chan(&lut[min(idx + 1, DPU_DEGAMMA_LUT_SIZE - 1)], chan);
+
+	return (a * (IGC_SAMPLES - 1 - frac) + b * frac + (IGC_SAMPLES - 1) / 2) /
+	       (IGC_SAMPLES - 1);
+}
+
+static void dpu_setup_dspp_igc(struct dpu_hw_dspp *ctx, const struct drm_color_lut *lut)
+{
+	static const int chan[3] = { 1, 2, 0 };
+	u32 skip = IGC_DSPP_SKIP(ctx->idx - DSPP_0);
+	int c, i;
+
+	if (!lut) {
+		DPU_REG_WRITE(&ctx->hw, ctx->cap->sblk->igc.base, 0);
+		return;
+	}
+
+	mutex_lock(&dpu_igc_lock);
+	for (c = 0; c < 3; c++) {
+		for (i = 0; i < IGC_SAMPLES; i++) {
+			u32 v = drm_color_lut_extract(igc_sample(lut, i, chan[c]), 12);
+
+			DPU_REG_WRITE(&ctx->hw_top, c * 4, (v & IGC_DATA_MASK) | skip |
+				      (i ? 0 : IGC_INDEX_UPDATE));
+		}
+	}
+	mutex_unlock(&dpu_igc_lock);
+
+	DPU_REG_WRITE(&ctx->hw, ctx->cap->sblk->igc.base, IGC_EN);
+}
+
+/* DSPP_GAMUT v4.2 mode 17: LOWER = G << 16 | B then UPPER = R, 12 bits; nodes in
+ * drm_color_lut order (red fastest) rotate through the four tables */
+#define GAMUT_EN		BIT(0)
+#define GAMUT_TABLE_SEL_OFF	0x4
+#define GAMUT_UPPER_OFF		0x8
+#define GAMUT_LOWER_OFF		0xc
+#define GAMUT_TABLE_SEL(t)	BIT(12 + (t))
+#define GAMUT_TBL_NUM		4
+#define GAMUT_TBL_LEN		1229
+
+static void dpu_setup_dspp_gamut(struct dpu_hw_dspp *ctx, const struct drm_color_lut *lut)
+{
+	u32 base = ctx->cap->sblk->gamut.base;
+	int t, e, n;
+
+	if (!lut) {
+		DPU_REG_WRITE(&ctx->hw, base, 0);
+		return;
+	}
+
+	for (t = 0; t < GAMUT_TBL_NUM; t++) {
+		DPU_REG_WRITE(&ctx->hw, base + GAMUT_TABLE_SEL_OFF, GAMUT_TABLE_SEL(t));
+		for (e = 0; e < GAMUT_TBL_LEN; e++) {
+			u32 r = 0, g = 0, b = 0;
+
+			n = e * GAMUT_TBL_NUM + t;
+			if (n < DPU_GAMUT_3D_SIZE) {
+				r = drm_color_lut_extract(lut[n].red, 12);
+				g = drm_color_lut_extract(lut[n].green, 12);
+				b = drm_color_lut_extract(lut[n].blue, 12);
+			}
+			DPU_REG_WRITE(&ctx->hw, base + GAMUT_LOWER_OFF, (g << 16) | b);
+			DPU_REG_WRITE(&ctx->hw, base + GAMUT_UPPER_OFF, r);
+		}
+	}
+
+	DPU_REG_WRITE(&ctx->hw, base, GAMUT_EN);
+}
+
 /**
  * dpu_hw_dspp_init() - Initializes the DSPP hw driver object.
  * should be called once before accessing every DSPP.
@@ -138,6 +234,8 @@
 
 	c->hw.blk_addr = addr + cfg->base;
 	c->hw.log_mask = DPU_DBG_MASK_DSPP;
+	c->hw_top.blk_addr = addr + IGC_TOP_OFF;
+	c->hw_top.log_mask = DPU_DBG_MASK_DSPP;
 
 	/* Assign ops */
 	c->idx = cfg->id;
@@ -146,6 +244,11 @@
 		c->ops.setup_pcc = dpu_setup_dspp_pcc;
 	if (c->cap->sblk->gc.base)
 		c->ops.setup_gc = dpu_setup_dspp_gc;
+	/* only the block revisions whose table layout is known */
+	if (c->cap->sblk->igc.version == 0x30001)
+		c->ops.setup_igc = dpu_setup_dspp_igc;
+	if (c->cap->sblk->gamut.version == 0x40002)
+		c->ops.setup_gamut = dpu_setup_dspp_gamut;
 
 	return c;
 }
