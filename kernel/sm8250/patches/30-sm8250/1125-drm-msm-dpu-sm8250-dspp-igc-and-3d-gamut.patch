+static int dpu_crtc_atomic_set_property(struct drm_crtc *crtc,
+					struct drm_crtc_state *state,
+					struct drm_property *property, uint64_t val)
+{
+	struct dpu_crtc *dpu_crtc = to_dpu_crtc(crtc);
+	struct dpu_crtc_state *cstate = to_dpu_crtc_state(state);
+	bool replaced = false;
+	int ret;
+
+	if (property != dpu_crtc->lut3d_property)
+		return -EINVAL;
+
+	ret = drm_property_replace_blob_from_id(crtc->dev, &cstate->lut3d, val, -1,
+						DPU_GAMUT_3D_SIZE * sizeof(struct drm_color_lut),
+						sizeof(struct drm_color_lut), &replaced);
+	if (!ret)
+		state->color_mgmt_changed |= replaced;
+	return ret;
+}
+
+static int dpu_crtc_atomic_get_property(struct drm_crtc *crtc,
+					const struct drm_crtc_state *state,
+					struct drm_property *property, uint64_t *val)
+{
+	struct dpu_crtc *dpu_crtc = to_dpu_crtc(crtc);
+	const struct dpu_crtc_state *cstate = to_dpu_crtc_state(state);
+
+	if (property != dpu_crtc->lut3d_property)
+		return -EINVAL;
+
+	*val = cstate->lut3d ? cstate->lut3d->base.id : 0;
+	return 0;
+}
