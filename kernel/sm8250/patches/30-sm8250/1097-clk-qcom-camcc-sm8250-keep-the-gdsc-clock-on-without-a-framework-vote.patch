From: transentient <cliff.judge@gmail.com>
Date: Fri, 16 Oct 2026 14:00:00 +0900
Subject: [PATCH] clk: qcom: camcc-sm8250: keep the GDSC clock on without a framework vote

cam_cc_gdsc_clk is registered as CLK_IS_CRITICAL.  The clock framework
therefore prepares and enables it at registration, and with it its parents
cam_cc_xo_clk_src and the RPMh XO "bi_tcxo" (the variant that also votes in
the sleep set), and never releases them.  XO stays voted on through every
suspend and the SoC can never reach XO shutdown (AOSS sleep).  Measured on
the Retroid Pocket 5: at the suspend edge bi_tcxo's prepared children
include cam_cc_xo_clk_src -> cam_cc_gdsc_clk, which has no consumer.

camcc-sm8150, sm7150, sc8280xp and sa8775p keep their equivalent clocks on
by setting the branch enable bit once in probe (qcom_branch_set_clk_en) and
do not register them with the framework.  Do the same here: same hardware
state, no XO vote.
---
--- a/drivers/clk/qcom/camcc-sm8250.c	2026-10-16 13:20:57.414152374 +0900
+++ b/drivers/clk/qcom/camcc-sm8250.c	2026-10-16 13:20:57.431266555 +0900
@@ -1449,24 +1449,6 @@
 	},
 };
 
-static struct clk_branch cam_cc_gdsc_clk = {
-	.halt_reg = 0xc16c,
-	.halt_check = BRANCH_HALT,
-	.clkr = {
-		.enable_reg = 0xc16c,
-		.enable_mask = BIT(0),
-		.hw.init = &(struct clk_init_data){
-			.name = "cam_cc_gdsc_clk",
-			.parent_hws = (const struct clk_hw*[]){
-				&cam_cc_xo_clk_src.clkr.hw
-			},
-			.num_parents = 1,
-			.flags = CLK_IS_CRITICAL | CLK_SET_RATE_PARENT,
-			.ops = &clk_branch2_ops,
-		},
-	},
-};
-
 static struct clk_branch cam_cc_icp_ahb_clk = {
 	.halt_reg = 0xc094,
 	.halt_check = BRANCH_HALT,
@@ -2304,7 +2286,6 @@
 	[CAM_CC_FD_CORE_CLK] = &cam_cc_fd_core_clk.clkr,
 	[CAM_CC_FD_CORE_CLK_SRC] = &cam_cc_fd_core_clk_src.clkr,
 	[CAM_CC_FD_CORE_UAR_CLK] = &cam_cc_fd_core_uar_clk.clkr,
-	[CAM_CC_GDSC_CLK] = &cam_cc_gdsc_clk.clkr,
 	[CAM_CC_ICP_AHB_CLK] = &cam_cc_icp_ahb_clk.clkr,
 	[CAM_CC_ICP_CLK] = &cam_cc_icp_clk.clkr,
 	[CAM_CC_ICP_CLK_SRC] = &cam_cc_icp_clk_src.clkr,
@@ -2436,6 +2417,9 @@
 	clk_lucid_pll_configure(&cam_cc_pll3, regmap, &cam_cc_pll3_config);
 	clk_lucid_pll_configure(&cam_cc_pll4, regmap, &cam_cc_pll4_config);
 
+	/* Keep the critical clock always-on */
+	qcom_branch_set_clk_en(regmap, 0xc16c); /* cam_cc_gdsc_clk */
+
 	return qcom_cc_really_probe(&pdev->dev, &cam_cc_sm8250_desc, regmap);
 }
 
