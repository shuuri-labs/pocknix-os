+/*
+ * The MCU streams reports continuously over the UART. If it keeps sending
+ * across the suspend teardown, the geni-serial RX interrupt can storm while
+ * the port is stopped until the spurious-IRQ detector disables it, leaving the
+ * pad dead after resume. Hold the MCU and its 3.3V Hall-sensor rail (vdd) off
+ * while asleep, matching Android's rs_gpio mcu_power_control; resume brings it
+ * back up from the init work.
+ */
+static int gamepad_suspend(struct device *d)
+{
+	struct gamepad_device *dev = dev_get_drvdata(d);
+
+	cancel_delayed_work_sync(&dev->init_work);
+	cancel_delayed_work_sync(&dev->mode_release_work);
+
+	if (dev->enable_gpio)
+		gpiod_set_value_cansleep(dev->enable_gpio, 0);
+
+	if (dev->reset_gpio)
+		gpiod_set_value_cansleep(dev->reset_gpio, 0);
+
+	gamepad_vdd_disable(dev);
+
+	/* Drop any partial frame or held button state from before the MCU went quiet. */
+	dev->rx_len = 0;
+	dev->prev_keys = 0;
+
+	return 0;
+}
+
+static int gamepad_resume(struct device *d)
+{
+	struct gamepad_device *dev = dev_get_drvdata(d);
+
+	dev->rx_len = 0;
+	dev->prev_keys = 0;
+	dev->init_attempts = 0;
+	schedule_delayed_work(&dev->init_work, 0);
+
+	return 0;
+}
