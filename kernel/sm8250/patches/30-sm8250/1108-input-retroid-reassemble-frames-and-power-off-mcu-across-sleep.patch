+static void gamepad_handle_frame(struct serdev_device *serdev,
+				 const u8 *frame, size_t data_len)
+{
+	struct gamepad_data recv_data_buffer = {};
+
+	memcpy(recv_data_buffer.header, frame, 4);
+	recv_data_buffer.frame_number = frame[4];
+	recv_data_buffer.command = frame[5];
+	recv_data_buffer.data_len = data_len;
+	memcpy(recv_data_buffer.data, frame + 8, data_len);
+
+	gamepad_data_handler(serdev, &recv_data_buffer);
+}
+
+/*
+ * serdev makes no framing guarantee: a callback may hold part of a frame or
+ * several frames. Buffer the bytes and hand on each complete frame whose
+ * header, length and checksum check out; on a bad one, resync a byte later.
+ */
 static size_t gamepad_mcu_uart_rx_bytes(struct serdev_device *serdev,
 					const u8 *data, size_t count)
 {
-	struct device *dev = &serdev->dev;
-	struct gamepad_data recv_data_buffer;
-	u8 checksum;
-
-	if (!data || count < 7) {
-		dev_warn_ratelimited(dev, "invalid packet");
+	struct gamepad_device *dev = serdev_device_get_drvdata(serdev);
+	size_t consumed = 0, avail, data_len, frame_len;
+	const u8 *frame;
+
+	if (!dev || !data || !count)
 		return count;
-	}
-
-	checksum = gamepad_data_checksum(data, count);
-	if (checksum != *(data + count - 1)) {
-		//dev_warn_ratelimited(dev, "packet checksum failed");
+
+	if (count > sizeof(dev->rx_buf)) {
+		dev_warn_ratelimited(&serdev->dev, "RX burst too long: %zu\n", count);
+		dev->rx_len = 0;
 		return count;
 	}
 
-	memcpy(recv_data_buffer.header, data, 4);
-	recv_data_buffer.frame_number = *(data + 4);
-	recv_data_buffer.command = *(data + 5);
-	recv_data_buffer.data_len = *(data + 6) | (*(data + 7) << 8);
-
-	if (recv_data_buffer.data_len) {
-		memset(&recv_data_buffer.data[0], 0,
-		       sizeof(recv_data_buffer.data));
-		memcpy(&recv_data_buffer.data[0], data + 8,
-		       recv_data_buffer.data_len);
-	}
-
-	gamepad_data_handler(serdev, &recv_data_buffer);
+	if (dev->rx_len + count > sizeof(dev->rx_buf))
+		dev->rx_len = 0;
+
+	memcpy(dev->rx_buf + dev->rx_len, data, count);
+	dev->rx_len += count;
+	avail = dev->rx_len;
+
+	while (avail >= FRAME_MIN_LEN) {
+		frame = dev->rx_buf + consumed;
+
+		if (memcmp(frame, frame_header, sizeof(frame_header))) {
+			consumed++;
+			avail--;
+			continue;
+		}
+
+		data_len = frame[6] | (frame[7] << 8);
+		if (data_len > MAX_DATA_LEN) {
+			consumed++;
+			avail--;
+			continue;
+		}
+
+		frame_len = FRAME_MIN_LEN + data_len;
+		if (avail < frame_len)
+			break;
+
+		if (gamepad_data_checksum(frame, frame_len) != frame[frame_len - 1]) {
+			consumed++;
+			avail--;
+			continue;
+		}
+
+		gamepad_handle_frame(serdev, frame, data_len);
+		consumed += frame_len;
+		avail -= frame_len;
+	}
+
+	if (consumed) {
+		memmove(dev->rx_buf, dev->rx_buf + consumed, avail);
+		dev->rx_len = avail;
+	}
 
 	return count;
 }
